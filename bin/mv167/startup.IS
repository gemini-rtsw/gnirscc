#
# VxWorks startup script to load and execute system (iocCore) software.
#
# First, vxWorks startup issues:

# Make delete key work for backspace
tyBackspaceSet 0177

shellPromptSet "GNIRS-CC> "
# cd to application install directory (beware automounter problems)
# This is the gnirs top directory
cd "/gemini/GEM5/gnirs/CC/V1-20/.."
pwd

# The local file contains site-specific information
# such as the default router and the vxWorks password file.

< ./CC/bin/mv167/local

#EPICS = /gemini/external/GEM5
# Load EPICS core and record stuff
ld < /gemini/external/GEM5/base/bin/mv167/iocCore
ld < /gemini/external/GEM5/base/bin/mv167/drvSup
ld < /gemini/external/GEM5/base/bin/mv167/recSup
ld < /gemini/external/GEM5/base/bin/mv167/devSup

# Local install of tnetDev, drvSerial, drvAscii
ld < ./CC/bin/mv167/tnetDev
ld < ./CC/bin/mv167/sioSup
ld < ./CC/bin/mv167/drvAscii

#pvload program
ld < /gemini/external/GEM5/extensions/bin/mv167/pvload

# If using state programs, load the sequencer
#ld < epics/base/bin/mv167/seq

# Load any application records, device support or drivers here,
# or code for subroutine records
ld < /gemini/slalib/bin/mv167/slalib
ld < /gemini/timelib/bin/mv167/timelib
ld < /gemini/astlib/bin/mv167/astlib

#gnirs controller code
ld < ./CC/bin/mv167/ccGlobal.o
ld < ./CC/bin/mv167/cicsLib.o
ld < ./CC/bin/mv167/hdwrControl.o
ld < ./CC/bin/mv167/epicsControl.o
startStatustask

# instrument sequencer code
ld < ../IS/IS/bin/mv167/gmSeqAppl

compUseVxTime=1
timeClockInit (0,0,60,1,0)

# Configure the Timestamp system, 1=Master IOC
TSconfigure( 1, 0, 60, 0, 0, 0, 0)

# Load one or more ASCII databases here
dbLoad "./CC/data/default.dctsdr"
dbLoadRecords "./CC/data/temperatureControl.db"
dbLoadRecords "./CC/data/nirsCCTop.db"
dbLoadRecords "./CC/data/nirsCCSadTop.db"

# is records
dbLoadRecords "../IS/IS/data/nirsSeqTop.db"
dbLoadRecords "../IS/IS/data/nirsSeqSadTop.db"

# This turns off logging
iocLogDisable=1

#init serial interface
tnetDevCreate( "/pty/lsbtc", "mk-gnirs-perle", 10006 )
tnetDevCreate( "/pty/lsbtwc", "mk-gnirs-perle", 10007 )
drvAsciiDebugLevel=0

#Hardware debug
hwdbg = 1

############ start epics ###############
#
iocInit "./CC/data/resource.def"

#load motor parameters
#is variables
pvload "./CC/data/cadVals.pv","top=nirs:cc:, sadtop=nirs:sad:cc:"

#Quickly Turn off the lakeshore BTWC scanning for now
dbpf "nirs:tc:btwc:sensorA.SCAN", "Passive"
#dbpf "tc:btc:sensorA.SCAN", "Passive"
#pvload "./CC/data/lakeshore.pv","btc=tc:btc:, btwc=tc:btwc:"

dbpf "nirs:cc:fw1wcsCheck.A", "fw1"
dbpf "nirs:cc:fw2wcsCheck.A", "fw2"
dbpf "nirs:cc:slitwcsCheck.A", "slit"
dbpf "nirs:cc:deckerwcsCheck.A", "decker"
dbpf "nirs:cc:gratingwcsCheck.A", "grating"
dbpf "nirs:cc:coverwcsCheck.A", "cover"
dbpf "nirs:cc:camerawcsCheck.A", "camera"
dbpf "nirs:cc:acqwcsCheck.A", "acq"
dbpf "nirs:cc:xdispwcsCheck.A", "xdisp"
dbpf "nirs:cc:focuswcsCheck.A", "focus"

#start epics control tasks
initTasks

# Set debugging/logging level
gnirsInitLogging
gnirsSetDebug 3
sendToMotorDebug=1

# Initialize GNIRS hardware interface
#pvload "/home/gemvx/gnirs/CC/data/cadInitVals.par","top=nirs:cc:,sadtop=nirs:cc:sad:"

# # Simulation mode NOSIM:0  VSM:1  FASTSIM:2  FULLSIM:3
setSimulation 0

# Set flag if xycom board not present
noXYCOM = 0

# Set flag if temperature board not present
noTempMon = 0

# Set flag if SenTorr not present
noSenTorr = 0

# Read the motor configuration file and initialize the motors
#readConfig "/home/gemvx/gnirs/CC/data/gnirsConfig.seed"
strncpy  &configDirectory, "./CC/data/", 160

#IS 
pvload "../IS/IS/data/gmSeq.pv","top=nirs:, sadtop=nirs:sad:"

#ld < /home/gemvx/gnirs/CC/bin/mv167/epicsCAInt.o
# Trigger the initialisation of the instrument sequencer and components controller
# disabling initdcCadMark to prevent the detector controller being initialised

####CC Simulation Mode CURRENTLY ENABLED#####
#CHANGE startupCCSim.pv to startupCC.pv to turn of motor simulation
#
pvload "./CC/data/startupCC.pv","top=nirs:,ccTop=nirs:cc:, sadtop=nirs:sad:cc:"
sleep (5,0)

pvload "../IS/IS/data/startup.pv","top=nirs:,ccTop=nirs:cc:, sadtop=nirs:sad:cc:"
sleep(1,0)
#

sleep(5,0)
pvload "../IS/IS/data/loadFOCimaging.pv","top=nirs:,ccTop=nirs:cc:, sadtop=nirs:sad:cc:"

sleep(2,0)
pvload "../IS/IS/data/loadFOCspectral.pv","top=nirs:,ccTop=nirs:cc:, sadtop=nirs:sad:cc:"

sleep(2,0)
pvload "../IS/IS/data/loadFOCspatial.pv","top=nirs:,ccTop=nirs:cc:, sadtop=nirs:sad:cc:"

sleep(2,0)
dbpf "nirs:apply.DIR","START"

sleep(20,0)
dbpf "nirs:cc:fw2Select","0"
dbpf "nirs:focus:focusbest", "best focus"

sleep(15,0)
#............check Grating list
dumpMech 7

sleep(1,0)
readConfig "CC/data/gnirsMechanisms"
sleep(5,0)
dumpMech 7

readSafetyFilters "CC/data/SafetyFilters"

# End of startup.vws

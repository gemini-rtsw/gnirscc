/*
 *+
 * FUNCTION NAME:
 *	?Cad
 *
 * INVOCATION:
 *	struct cadRecord* pCad;
 *	long status = 0;
 *	status = ?Cad( pCad );
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 *	> pCad		(struct cadRecord*)	pointer to CAD record
 *
 * FUNCTION VALUE:
 *	long		status value written to CAD VAL field
 *
 * PURPOSE:
 *	Supports Gemini "?" command, via CAD record
 *
 * DESCRIPTION:
 *	Inovked when ?Cad record is processed by EPICS.  It 
 *	implements the "park" command, which places the system in a 
 *	safe shutdown status.  
 *
 * EXTERNAL VARIABLES:
 *	None
 *
 * PRIOR REQUIREMENTS:
 *	CAD record should be initialized, with no parameters.
 *
 * DEFICIENCIES:
 *	
 *
 * HISTORY (optional):
 *	  
 *
 *-
 */

 long ?Cad( struct cadRecord* pCad )
{
   
    long status = CAD_ACCEPT;
    long result = OK;

    /* Take appropriate action, based on directive type*/
    switch(DIRECTIVE )
    {
      case CAD_MARK:	/* No action required	*/
	SDSU_LOG(SDSU_DEBUG1, 
		 "?Cad - MARK directive");
	break;

      case CAD_PRESET:	/* No action required	*/
	SDSU_LOG(SDSU_DEBUG1, 
		 "?Cad - PRESET directive");
	break;

      case CAD_CLEAR:	/* No action required	*/
	SDSU_LOG(SDSU_DEBUG1, 
		 "?Cad - CLEAR directive");
	break;

      case CAD_START:	/* No action required	*/
	SDSU_LOG(SDSU_DEBUG1, 
		 "?Cad - START directive");
	

	/*set car to busy (ctrl task will set back to idle)*/
	   
	status = setCar(?_CAR,CAR_BUSY,OK,"",MESSAGE);
	
	
	DPRINT(DPdebug,SDSU_DEBUG1,"Waking park\n");
	semGive(sem?);
	
	
	break;

      case CAD_STOP:	/* Can't stop	*/
	SDSU_LOG(SDSU_DEBUG1,
		 "?Cad - STOP directive");
		
	strncpy(MESSAGE,"parkCad: Can't stop",MAX_STRING_SIZE - 1);
	status = CAD_REJECT;
	break;

      default:	/* Unknown directive	*/
	strncpy(MESSAGE, "parkCad: Unrecognized directive",MAX_STRING_SIZE - 1);
	status = CAD_REJECT;
	break;
    } 
   
    return status;
}

/*
 *+
 * FUNCTION NAME:
 *	?Ctrl
 *
 * INVOCATION:
 *	Started as seperate task in initTasks.
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 *	Set of 10 integer variables, interpreted as variety of 
 *	parameters.
 *
 * FUNCTION VALUE:
 *	never returns
 *
 * PURPOSE:
 *
 * DESCRIPTION:
 *	Cad record releases semaphore which allows ?Ctrl to run.  
 *
 * EXTERNAL VARIABLES:
 *	None
 *
 * PRIOR REQUIREMENTS:
 *	None
 *
 * DEFICIENCIES:
 *	
 *
 * HISTORY (optional):
 *
 *-
 */

int ?Ctrl( int n1, int n2, int n3, int n4, int n5, int n6, 
	      int n7, int n8, int n9, int n10 )
{
    struct cadRecord* pCad;
    long status = OK;
    long simMode;
    long rc;
    char dummy[MAX_STRING_SIZE];

    /* Convert first parameter to CAD address		*/
    pCad = (struct cadRecord *) n1;

    /* Repeat as inifinite loop				*/
    while(1)
    {
	SDSU_LOG(SDSU_DEBUG1, "Task t?Ctrl sleeping...\n");
	
	/* Wait for our semaphore			*/
	semTake(sem?, WAIT_FOREVER);
	SDSU_LOG(SDSU_DEBUG1, "Task t?Ctrl awake...");
	    
	  
	/* Find out what execution mode we are in	*/
	getDbInfoT(dbTop, INIT_CAD ".VALA",dummy,DBF_LONG,&simMode);

	switch (simMode)
	{
	  case SIM_NONE:
	 
	   
		if(setCar(PARK_CAR,CAR_IDLE,OK,"",dummy) != OK)
		{
		    DPRINT(DPdebug,SDSU_ERROR,dummy);
		}
	    break;

	  case SIM_VSM:
	  case SIM_FULL:
	  case SIM_FAST:


	    if(setCar(?_CAR,CAR_IDLE,OK,"",dummy) != OK)
		DPRINT(DPdebug,SDSU_ERROR,dummy);
	    break;
	  default:		/* Don't see any action	*/
	    SDSU_LOG(SDSU_DEBUG1, "Simulation is irrelevant!");
	    break;
	}


    }
    return status;
}

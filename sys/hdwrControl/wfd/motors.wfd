/*
 *+
 * FUNCTION NAME:
 * isParked
 *
 * INVOCATION:
 * isParked(motor)
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 * (>) motor (int)          Motor in question
 *
 * FUNCTION VALU:
 * (BOOL) Returns the status information structure
 *
 * PURPOSE:
 * Checks to see if motor is parked.
 *
 * DESCRIPTION:
 * Compares parked position against current one, adn returns TRUE
 * if they are the same.
 *
 * EXTERNAL VARIABLES:
 *
 *
 * PRIOR REQUIREMENTS:
 *
 *
 * DEFICIENCIES:
 *
 *
 * HISTORY:
 * Jul 1, 2001      Initial Version                 (rwolff@noao.edu)
 *
 *-
 */
/*
 *+
 * FUNCTION NAME:
 * checkParked
 *
 * INVOCATION:
 * checkParked(motor)
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 * (>) motor (int)          Motor in question
 *
 * FUNCTION VALUE:
 * (void) Returns 'void' and hence has no STATUS value
 *
 * PURPOSE:
 * Check to see if parked
 *
 * DESCRIPTION:
 * Compares current position with the park position (specified in the
 * configuration file).  This doesn't work when in simulation mode.
 *
 * EXTERNAL VARIABLES:
 *
 *
 * PRIOR REQUIREMENTS:
 *
 *
 * DEFICIENCIES:
 *
 *
 * HISTORY:
 * Jul 1, 2001      Initial Version                 (rwolff@noao.edu)
 *
 *-
 */
/*
 *+
 * FUNCTION NAME:
 * park
 *
 * INVOCATION:
 * park(motor)
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 * (>) motor (int)          Motor to park
 *
 * FUNCTION VALUE:
 * (int) Returns VME_OK (0) or VME_ERROR (1) as status
 *
 * PURPOSE:
 * Park a motor
 *
 * DESCRIPTION:
 * Move a motor to the park position.  For BINARY motors, this is
 * presumed to be one of the limit switches; for all others, it is
 * the place specified in the configuration file.
 *
 * EXTERNAL VARIABLES:
 *
 *
 * PRIOR REQUIREMENTS:
 *
 *
 * DEFICIENCIES:
 *
 *
 * HISTORY:
 * Jul 1, 2001      Initial Version                 (rwolff@noao.edu)
 *
 *-
 */
/*
 *+
 * FUNCTION NAME:
 * resetFault
 *
 * INVOCATION:
 * resetFault(motor)
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 * (>) motor (int)          Motor in question
 *
 * FUNCTION VALUE:
 * (void) Returns 'void' and hence has no STATUS value
 *
 * PURPOSE:
 * Reset the motor's fault line
 *
 * DESCRIPTION:
 * Toggle, and hence reset, the reset line for the motor specified.
 *
 * EXTERNAL VARIABLES:
 *
 *
 * PRIOR REQUIREMENTS:
 *
 *
 * DEFICIENCIES:
 *
 *
 * HISTORY:
 * Jul 1, 2001      Initial Version                 (rwolff@noao.edu)

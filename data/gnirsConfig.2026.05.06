[cryo ]
#  select is computer/manual switch
#  manual is the readback from the manual switch
#  computer is the computer control of the cryohead on/off state
# name	     port    	bit     level
select =		0,		0,		0
manual =		0,		1,		0
computer = 		8,		0,		0

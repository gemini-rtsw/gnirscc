#! /bin/sh
#
# Self-contained CC build environment. Previously delegated to ../nirs.env
# which pulled in sibling-component vars that CC does not need. All vars
# that nirsSetup / applSetup actually reference for the CC build are set
# directly here. NIRS_CCDIR auto-detects from the script location so the
# tree can live anywhere (e.g., /home/gemvx/hstecher/gnirscc-git-V1-27).
#

NIRSCC_CVSRELEASE=V1-27
NIRS_CVSRELEASE=$NIRSCC_CVSRELEASE

# Auto-detect CC source dir from the script's own location. Resolve to an
# absolute path so nirsSetup's `cd $NIRS_CCDIR` works regardless of caller.
NIRS_CCDIR=${NIRS_CCDIR:-`cd \`dirname "$0"\` && pwd`}

# CC source and install locations
NIRS_DIR=${NIRS_DIR:-`dirname "$NIRS_CCDIR"`}
NIRS_GEM5_INSTPATH=${NIRS_GEM5_INSTPATH:-pisces:/gemini/GEM5/gnirs}
NIRS_CCINSTPATH=${NIRS_GEM5_INSTPATH}/CC/${NIRS_CVSRELEASE}

# Build dependencies referenced by applSetup
NIRS_TARGETS=mv167
NIRS_ASTLIBDIR=/gemini/astlib
NIRS_TIMELIBDIR=/gemini/timelib

export NIRS_CVSRELEASE NIRSCC_CVSRELEASE
export NIRS_DIR NIRS_CCDIR NIRS_CCINSTPATH NIRS_GEM5_INSTPATH
export NIRS_TARGETS NIRS_ASTLIBDIR NIRS_TIMELIBDIR

sh -x ./nirsSetup CC

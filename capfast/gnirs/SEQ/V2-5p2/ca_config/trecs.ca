#+
# trecs.ca
#
# Channel access configuration file for the TRECS package
#
#
#  Matthieu Bec - 19 November 2002
#
#-

apply trecs::apply   trecs:apply    trecs:applyC    IS Primary Apply Record 

status trecs::apply Apply message
{
   mess       trecs:applyC.OMSS    0    Command completion message
}

status trecs::status TRECS status
{
   applyC          trecs:applyC.VAL        0    Command status
   message         trecs:applyC.OMSS       0    Command completion message
   observe         trecs:observeC.VAL      0    Observe status
}

command trecs::observe trecs::apply Observe
{
   label      trecs:observe.A        DHS data label
}

command trecs::continue trecs::apply Continue observation
{
   dummy      trecs:continue.A
}

command trecs::config trecs::apply Setup a Configuration
{
}

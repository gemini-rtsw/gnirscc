apply niri::apply   NIS:apply     NIS:applyC       NIS Primary Apply Record 
apply niri::dcapply niri:dc:apply niri:dc:applyC   DC Primary Apply Record

status niri::apply Apply message
{
   mess       NIS:applyC.OMSS                0     Command completion message
}
status niri::dcapply Apply message
{
   mess       niri:dc:applyC.OMSS            0     Command completion message
}

status niri::status NIRI status
{
   applyC     NIS:applyC.VAL                 0     Command status
   message    NIS:applyC.OMSS                0     Command completion message
   observe    niri:observeC.VAL              0     Observe status
   camera     niri:cc:spltName               0     Camera (beamsplitter)
}

status niri::dcstatus NIRI status
{
   applyC         niri:dc:applyC.VAL         0     Command status
   message        niri:dc:applyC.OMSS        0     Command completion message
   observe        niri:dc:observeC.VAL       0     Observe status
   numCoAdds      niri:dc:obsSetup.VALE      0     numCoAdds
   intTime        niri:dc:obsSetup.VALG      0     intTime
   minInt         niri:dc:minInt.VAL         0     minInt
}

command niri::observe niri::dcapply Observe
{
   label      niri:dc:observe.A                    DHS data label
   dummy      niri:dc:observe.B                    Dummy no used
}

command niri::endObserve niri::apply End Observe
{
   dummy      niri:endObserve.A                    Dummy  
}

command niri::stop niri::dcapply Stop observation
{
   dummy      niri:dc:stop.A                          Dummy
}

command niri::abort niri::dcapply Abort observation
{
   dummy      niri:dc:abort.A                         Dummy
}

command niri::pause niri::dcapply Pause observation
{
   dummy      niri:dc:pause.A
}

command niri::continue niri::dcapply Continue observation
{
   dummy      niri:dc:continue.A
}

command niri::config niri::apply Setup a Configuration
{
}

command niri::dcconfig niri::dcapply Setup a DC Configuration
{
# everything is done internally from the NIS
   readMode_lnr   niri:dc:LNRNum.VAL               readmode LNR
   readMode_davg  niri:dc:DAvgNum.VAL              readmode Digital Average
   readMode_bvolt niri:dc:arSetup.H                readmode Bias Voltage
   exposureTime   niri:dc:integTime.VAL            Integration time for IS
   numCoAdds      niri:dc:coadds.VAL               Coadds
   builtinROI     niri:dc:arSize.VAL               Builtin ROI
	lifetime       niri:dc:dhsLifetime              DHS lifetime
	bitsperpix     niri:dc:dhsBitsperpixel          DHS bitsperpix
   numPics        niri:dc:numberPics.VAL           Number of frame
   hdrDetail	   niri:dc:hdrDet.VAL               Headers Details
   hdrTiming      niri:dc:hdTime.VAL               Header Timing
}

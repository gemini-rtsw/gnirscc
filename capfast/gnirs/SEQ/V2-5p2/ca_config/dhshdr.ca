# Channel access configuration file for the dhshdr package.

status dhshdr::tcs
{
   name            tcs:name                     0 Telescope & Observatory
   airmass         tcs:sad:airMass              0 Average airmass
   amstart         tcs:sad:amStart              0 Airmass at start
   amend           tcs:sad:amEnd                0 Airmass at end
   # ampatch - used as temporary patch to above ..
   amnow           tcs:airMassNow               0 Airmass now
   ha              tcs:sad:currentHAString      0 Hour Angle
   lt              tcs:sad:localTime            0 Local time
   trkframe        tcs:sad:sourceADiffFrame    0 Tracking frame
   dectrack        tcs:sad:sourceADiffDec       0 Diff Tracking Dec
   trkepoch        tcs:sad:sourceADiffEpoch     0 Diff Tracking Epoch
   ratrack         tcs:sad:sourceADiffRA        0 Diff Tracking RA
   frame           tcs:sad:sourceAInputFrame    0 Frame
   pmdec           tcs:sad:sourceAPMDec         0 Proper motion Dec
   pmra            tcs:sad:sourceAPMRA          0 Proper motion RA
   waveleng        tcs:sad:sourceAWavelength    0 Wavelength
   p1adec          tcs:sad:pwfs1Dec             0 P1 DEC
   p1aepoch        tcs:sad:pwfs1Epoch           0 P1 Epoch
   p1aequin        tcs:sad:pwfs1Equinox         0 P1 Equinox
   p1aframe        tcs:sad:pwfs1InputFrame      0 P1 Frame
   p1aobjec        tcs:sad:pwfs1ObjectName      0 P1 Object Name
   p1apmdec        tcs:sad:pwfs1PMDec           0 P1 Proper motion Dec
   p1apmra         tcs:sad:pwfs1PMRA            0 P1 Proper motion RA
   p1aparal        tcs:sad:pwfs1Parallax        0 P1 Parallax
   p1ara           tcs:sad:pwfs1RA              0 P1 RA
   p1awavel        tcs:sad:pwfs1Wavelength      0 P1 Wavelength
   p1arv           tcs:sad:pwfs1RV              0 P1 Radial Velocity
   p2adec          tcs:sad:pwfs2Dec             0 P2 DEC
   p2aepoch        tcs:sad:pwfs2Epoch           0 P2 Epoch
   p2aequin        tcs:sad:pwfs2Equinox         0 P2 Equinox
   p2aframe        tcs:sad:pwfs2InputFrame      0 P2 Frame
   p2aobjec        tcs:sad:pwfs2ObjectName      0 P2 Object Name
   p2apmdec        tcs:sad:pwfs2PMDec           0 P2 Proper motion Dec
   p2apmra         tcs:sad:pwfs2PMRA            0 P2 Proper motion RA
   p2aparal        tcs:sad:pwfs2Parallax        0 P2 Parallax
   p2ara           tcs:sad:pwfs2RA              0 P2 RA
   p2awavel        tcs:sad:pwfs2Wavelength      0 P2 Wavelength
   p2arv           tcs:sad:pwfs2RV              0 P2 Radial Velocity
   oiadec          tcs:sad:oiwfsDec             0 OIWFS DEC
   oiaepoch        tcs:sad:oiwfsEpoch           0 OIWFS Epoch
   oiaequin        tcs:sad:oiwfsEquinox         0 OIWFS Equinox
   oiaframe        tcs:sad:oiwfsInputFrame      0 OIWFS Frame
   oiaobjec        tcs:sad:oiwfsObjectName      0 OIWFS Object Name
   oiapmdec        tcs:sad:oiwfsPMDec           0 OIWFS Proper motion Dec
   oiapmra         tcs:sad:oiwfsPMRA            0 OIWFS Proper motion RA
   oiaparal        tcs:sad:oiwfsParallax        0 OIWFS Parallax
   oiara           tcs:sad:oiwfsRA              0 OIWFS RA
   oiawavel        tcs:sad:oiwfsWavelength      0 OIWFS Wavelength
   oiarv           tcs:sad:oiwfsRV              0 OIWFS Radial Velocity
   ra              tcs:sad:sourceARA            0 RA
   dec             tcs:sad:sourceADec           0 DEC
   elevatio        tcs:currentEl                0 Current Elevation
   azimuth         tcs:currentAz                0 Current Azimuth
   crpa            tcs:currentRma               0 Current Cass Rotator Position Angle 
   sourceAParallax tcs:sad:sourceAParallax      0 Parallax of Target
   sourceARV       tcs:sad:sourceARV            0 Heliocentric Radial Velocity
   sourceAEpoch    tcs:sad:sourceAEpoch         0 Epoch for Target coordinates
   sourceAEquinox  tcs:sad:sourceAEquinox       0 Equinox for Target coordinates
   sourceATrackEq  tcs:sad:sourceATrackEq       0 Tracking equinox
   parallax        tcs:sad:sourceAParallax      0
   radvel          tcs:sad:sourceARV            0
   cguidmod        tcs:carouselMode.A           0 Carousel Mode
   ut              tcs:UTC                      0 UT at observation start
   date            tcs:sad:date                 0 Date FITS file was generated
   m2baffle        m2:DeployBafflePos           0 Deployable Baffle 
   m2cenbaff       m2:CentralBafflePos          0 Central Baffle 
   st              tcs:LST                      0 Siderial time at the start of the exposure
   sfrt2           ag:sfRot                     0 Science fold rotation
   sftilt          ag:sfTilt                    0 Science fold tilt
   sflinear        ag:sfLin                     0 Science fold linear pos
   instrAA         tcs:sad:instrAA              0 Instrument alignment angle
   instrPA         tcs:sad:instrPA              0 Instrument position angle
   targetA         tcs:sad:targetA              0 Target A tracking data

#  pa              tcs:sad:___UNKN___                0 Sky Position Angle at start of exposure
#  parangle        tcs:sad:___UNKN___                0 Parallactic Angle at start of exposure

}

status dhshdr::gcal
{
   filt            gc:sad:filtName              0 Filter name
   diff            gc:sad:diffuseName           0 Diffuser name
   shut            gc:sad:shutterName           0 Shutter name
   IR              gc:IR_LampState              0 IR lamp state
   Ar              gc:Ar_LampState              0 Ar lamp state
   Kr              gc:Kr_LampState              0 Kr lamp state
   CuAr            gc:CuAr_LampState            0 CuAr lamp state
   ThAr            gc:ThAr_LampState            0 ThAr lamp state
   QH              gc:QH_LampState              0 QH lamp state
}

status dhshdr::gpol
{
   upperParkSwitch     gp:sad:upperParkSwitch    0 Upper park switch
   upperPlateAngle     gp:sad:upperPlateAngle    0 Upper plate angle
   upperPlatePeriod    gp:sad:upperPlatePeriod   0 Upper plate period
   middleParkSwitch    gp:sad:middleParkSwitch   0 Middle park switch
   middlePlateAngle    gp:sad:middlePlateAngle   0 Middle plate angle
   middlePlatePeriod   gp:sad:middlePlatePeriod  0 Middle plate period
   lowerParkSwitch     gp:sad:lowerParkSwitch    0 Lower park switch
   lowerPlateAngle     gp:sad:lowerPlateAngle    0 Lower plate angle
   lowerPlatePeriod    gp:sad:lowerPlatePeriod   0 Lower plate period
}

status dhshdr::michelle
{
   inport      ag:port:michelle                  0 Michelle IS Port
#    extend                                        0 FITS dataset may contain extensions
#    origin                                        0 Origin of this FITS file
#    bscale                                        0 True_value = BSCALE * FITS_value + BZERO
#    hduclas1                                      0 Starlink NDF (hierarchical n-dim format)
#    hduclas2                                      0 Array component subclass
#    dhsver                                        0 Data handling version
#    obsref                                        0 PATT (or equivalent) reference
#    userid                                        0 ORAC Userid
#    recipe                                        0 Data reduction recipe to be used
#    obsnum                                        0 Observation number
#    grpnum                                        0 The number of the group applied to all
#    grpmem                                        0 Is the observation a group member?
#    standard                                      0 Whether observation is a standard
#    noffsets                                      0 Number of offset positions
#    utdate                                        0 UT date in yyyymmdd format
#    obs                                           0 Date and time (UTC) of start of observation
#    end                                           0 Date and time (UTC) of end   of observation
#    ctype1                                        0 Label for axis 1
#    crpix1                                        0 Pixel of reference point axis 1
#    crval1                                        0 Co-ordinate value of axis 1
#    cdelt1                                        0 Co-ordinate increment along axis 1
#    cunit1                                        0 Units for axis 1
#    ctype2                                        0 Label for axis 2
#    crpix2                                        0 Pixel of reference point axis 2
#    crval2                                        0 Co-ordinate value of axis 1
#    cdelt2                                        0 Co-ordinate increment along axis 2
#    cunit2                                        0 Units for axis 2
#    crota2                                        0 [deg] Angle DEC axis wrt axis 2 ccw
#    rabase                                        0 [h] RA of base position
#    decbase                                       0 [deg] Declination of base position
#    traoff                                        0 [arcsec] Telescope offset in RA
#    tdecoff                                       0 [arcsec] Telescope offset in Dec
#    pixelsiz                                      0 [arcsec] Pixel size
#    obstime                                       0 [s] Duration of observation
#    spd_gain                                      0 Readout speed
#    chopbeam                                      0 Chopping beam name (A|B|MIDDLE)
#    dcolumns                                      0 [pixel] Number of detector columns
#    drows                                         0 [pixel] Number of detector rows
#    rdout_x1                                      0 Start column of array readout
#    rdout_x2                                      0 End   column of array readout
#    rdout_y1                                      0 Start row    of array readout
#    rdout_y2                                      0 End   row    of array readout
#    camera          mch:cc:exName                 0 Camera mode (imaging|spectroscopy)
#    gratname        mch:cc:gName                  0 Grating name
#    gratpos         mch:cc:gWave                  0 [um] Grating wavelength
#    gratdisp        mch:cc:gDisp                  0 [um/pixel] Grating dispersion
#    gratord         mch:cc:gOrder                 0 Grating order
#    gratang                                       0 Grating Angle
#    slitname        mch:cc:sName                  0 Slit name
#    slitang         mch:cc:sAngle                 0 [deg] Slit angle
#    filter          mch:cc:fName                  0 Combined filter name
#    filtera         mch:cc:fAName                 0 Filter A name
#    filterb         mch:cc:fBName                 0 Filter B name
#    focname         mch:cc:fcName                 0 Focus named position
#    focmm           mch:cc:focus:foc:focusmm      0 [mm] Focus position
#    irdeg                                         0 [deg] Image rotator angle
#    gflexcor        mch:cc:gFlexCor               0 Whether grating flexure correction enabled
#    calseln                                       0 Calibration selection
#    wplangle                                      0 [deg] IRPOL waveplate angle
#    sampling                                      0 Oversampling type used
#    detincr                                       0 [pixel] Increment between scan positions
#    detnincr                                      0 Number of scan positions in scan
#    polarise                                      0 Whether or not using polariser
#    chpangle                                      0 [deg] Position angle of the chop
#    chpthrow                                      0 [arcsec] Throw of the chop wrt middle position
#    chopfreq                                      0 [Hz] Chop frequency
#    null_cyc                                      0 Cycles prior to data taking
#    null_exp                                      0 Exposures prior to data taking
#    waveform                                      0 Waveform set name
#    airtemp                                       0 [degC] Air temperature
#    barpress                                      0 Ambient pressure
#    dewpoint                                      0 [degC] Dewpoint
#    dometemp                                      0 [degC] Dome temperature
#    humidity                                      0 Relative Humidity
#    mirr_ne                                       0 [degC] Mirror temperature NE
#    mirr_nw                                       0 [degC] Mirror temperature NW
#    mirr_se                                       0 [degC] Mirror temperature SE
#    mirr_sw                                       0 [degC] Mirror temperature SW
#    mirrbtnw                                      0 [degC] Mirror bottom temp. SW
#    mirrtpnw                                      0 [degC] Mirror top temp. SW
#    secondar                                      0 [degC] Temperature of secondary
#    topairnw                                      0 [degC] Top air NW
#    trussene                                      0 [degC] Truss leg ENE
#    trusswsw                                      0 [degC] Truss leg WSW
#    wind_dir                                      0 [deg] Wind direction, azimuth
#    wind_spd                                      0 [km/s] Wind speed
#    csotau                                        0 Tau at 225 GHz from CSO
#    taudate                                       0 Time and date of Tau reading
   cnfindex       mch:cc:cnfIndex                0 Configuration index
   arraytmp       mch:cc:tc:fn:sdat              0 [K] Array temperature
   arrytmp2       mch:cc:tc:fn:cdat              0 [K] Array temperature ch.2
   ln2temp        mch:cc:sc1:t1                  0 [K] Temperature of LN2 can
   ccc1_tmp       mch:cc:sc1:t2                  0 [K] CCC 1st stage temp.
   grs_temp       mch:cc:sc1:t3                  0 [K] Grad. rad. shield temp.
   ccc2_tmp       mch:cc:sc1:t4                  0 [K] CCC 2nd stage temp.
   frs_temp       mch:cc:sc1:t5                  0 [K] Front rad. shield temp.
   grtdrtmp       mch:cc:sc1:t6                  0 [K] Grating drum temperature
   srm_temp       mch:cc:sc1:t7                  0 [K] SRM temperature
   imstptmp       mch:cc:sc1:t8                  0 [K] Imiger stop temperature
   jt1_temp       mch:cc:sc2:t1                  0 [K] JT 1st stage temperature
   jt2_temp       mch:cc:sc2:t2                  0 [K] JT 2nd stage temperature
   jt4ktemp       mch:cc:sc2:t3                  0 [K] JT 4K stage temperature
   filt_tmp       mch:cc:sc2:t6                  0 [K] Filter motor temperature
   vrstuc         mch:dc:s:bv0                   0 [V] Bias voltage: vrstuc
   vcasuc         mch:dc:s:bv1                   0 [V] Bias voltage: vcasuc
   vneg           mch:dc:s:bv2                   0 [V] Bias voltage: vneg
   vdetgrd        mch:dc:s:bv3                   0 [V] Bias voltage: vdetgrd
   vgg1           mch:dc:s:bv4                   0 [V] Bias voltage: vgg1
   vgg4           mch:dc:s:bv5                   0 [V] Bias voltage: vgg4
   vdetgrv        mch:dc:s:bv6                   0 [V] Bias voltage: vdetgrv
   vgg2           mch:dc:s:bv7                   0 [V] Bias voltage: vgg2
   vgg3           mch:dc:s:bv8                   0 [V] Bias voltage: vgg3
   imux           mch:dc:s:bv9                   0 [V] Bias voltage: imux
   vshpchg        mch:dc:s:bv10                  0 [V] Bias voltage: vshpchg
   vsh            mch:dc:s:bv11                  0 [V] Bias voltage: vsh
   vssd           mch:dc:s:bv12                  0 [V] Bias voltage: vssd
   vss            mch:dc:s:bv13                  0 [V] Bias voltage: vss
   vpw            mch:dc:s:bv14                  0 [V] Bias voltage: vpw
   vclout         mch:dc:s:bv15                  0 [V] Bias voltage: vclout
   vclcol         mch:dc:s:bv16                  0 [V] Bias voltage: vclcol
   vcap           mch:dc:s:bv17                  0 [V] Bias voltage: vcap
   voffset        mch:dc:s:bv18                  0 [V] Bias voltage: voffset
   vgatelo        mch:dc:s:cvl14                 0 [V] Clock voltage: vgatelow
   vgatehi        mch:dc:s:cvh15                 0 [V] Clock voltage: vgatehigh
}
                                                 

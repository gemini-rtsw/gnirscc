<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sequence PUBLIC "-//Gemini Observatory//DTD for OT Science Program Sequence//EN" "Seq.dtd">
<sequence version="0.1">
  <step name="step 1">
    <system name="calibration">
       <param name="filter" value="ND5.0"/>
       <param name="diffuser" value="visible"/>
       <param name="lamp" value="QH"/>
    </system>
    <system name="instrument">
       <param name="instrument" value="Acquisition Camera"/>
       <param name="windowing" value="no"/>
       <param name="binning" value="no"/>
       <param name="clfilter" value="V-green"/>
       <param name="ndfilter" value="neutral"/>
    </system>
    <system name="observe">
       <param name="observeType" value="FLAT"/>
       <param name="exposureTime" value="3"/>
    </system>
  </step>
  <step name="step 2">
    <system name="calibration">
       <param name="filter" value="ND4.0"/>
       <param name="diffuser" value="visible"/>
    </system>
    <system name="instrument">
       <param name="clfilter" value="B-blue"/>
    </system>
    <system name="observe">
       <param name="observeType" value="FLAT"/>
       <param name="exposureTime" value="15"/>
    </system>
  </step>
  <step name="step 3">
    <system name="calibration">
       <param name="filter" value="none"/>
       <param name="diffuser" value="IR"/>
    </system>
    <system name="instrument">
       <param name="clfilter" value="R-red2"/>
    </system>
    <system name="observe">
       <param name="observeType" value="FLAT"/>
       <param name="exposureTime" value="5"/>
    </system>
  </step>
</sequence>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sequence PUBLIC "-//Gemini Observatory//DTD for OT Science Program Sequence//EN" "Seq.dtd">
<sequence version="0.1">
  <step name="step 1">
    <system name="instrument">
       <param name="instrument" value="NIRI"/>
       <param name="readMode" value="1-2.5um narrow-band imaging/spectroscopy"/>
       <param name="coadds" value="4"/>
       <param name="builtinROI" value="Central 256x256"/>
    </system>
    <system name="observe">
      <param name="exposureTime" value="40"/>
    </system>
  </step>
  <step name="step 2">
    <system name="instrument">
       <param name="instrument" value="NIRI"/>
       <param name="readMode" value="1-2.5 um imaging"/>
       <param name="coadds" value="3"/>
       <param name="builtinROI" value="Central 512x512"/>
    </system>
    <system name="observe">
      <param name="exposureTime" value="30"/>
    </system>
  </step>
  <step name="step 3">
    <system name="instrument">
       <param name="instrument" value="NIRI"/>
       <param name="readMode" value="fast readout (shallow well)"/>
       <param name="coadds" value="2"/>
       <param name="builtinROI" value="Central 768x768"/>
    </system>
    <system name="observe">
      <param name="exposureTime" value="20"/>
    </system>
  </step>
  <step name="step 4">
    <system name="instrument">
       <param name="instrument" value="NIRI"/>
       <param name="readMode" value="3-5um imaging/spectroscopy (deep well)"/>
       <param name="coadds" value="1"/>
       <param name="builtinROI" value="Full Frame Readout"/>
    </system>
    <system name="observe">
      <param name="exposureTime" value="10"/>
    </system>
  </step>
</sequence>

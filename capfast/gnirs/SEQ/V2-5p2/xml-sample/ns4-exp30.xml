<!-- This template is based on an exported xml sequence from OT                                   -->
<!-- Either work from there or edit an exiting OT-xml and add the nodshuffle system               -->
<!-- to define 'nsIter' and 'nsRows'                                                              -->
<!--                                                                                              -->
<sequence version="0.1">
  <step name="step 1">
    <system name="nodshuffle">
      <param name="nsIter" value="4" />
      <param name="nsRows" value="42" />
    </system>
    <system name="instrument">
      <param name="instrument" value="GMOS" />    
    </system>
    <system name="telescope">
      <param name="guideWithOIWFS" value="OIWFS-1" />
    </system>
    <system name="observe">
      <param name="exposureTime" value="30.0" />
      <param name="observeType" value="TEST-NODA" />
    </system>
  </step>
  <step name="step 2">
    <system name="telescope">
      <param name="p" value="0.0" />
      <param name="q" value="60.0" />
    </system>
    <system name="observe">
      <param name="exposureTime" value="30.0" />
      <param name="observeType" value="TEST-NODB" />
    </system>
  </step>
</sequence>


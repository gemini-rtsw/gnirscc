 <Para 
  <Unique 1014545>
  <PgfTag `Heading2'>
  <PgfNumString `\t6.1\t'>
  <ParaLine 
   <String `Installation'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014546>
  <PgfTag `BodyAfterHead'>
  <ParaLine 
   <String `The sequence executor is written entirely in tcl so installation is simply a matter of '>
  > # end of ParaLine
  <ParaLine 
   <String `installing the source files and building the tcl index file in the '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `lib'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` subdirectory. There is '>
  > # end of ParaLine
  <ParaLine 
   <String `a make file in the application main directory that builds the index.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014556>
  <PgfTag `Heading2'>
  <PgfNumString `\t6.2\t'>
  <ParaLine 
   <String `Dependencies.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014557>
  <PgfTag `BodyAfterHead'>
  <ParaLine 
   <String `The sequence executor requires that the following software is also installed:'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014558>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `ocswish.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014559>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `The seq ocs support package.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014563>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `The dhshdr ocs support package.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014564>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `The acqcam ocs support package for acquisition camera sequences.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014569>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `The gmos ocs support package for GMOS sequences.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014561>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `The niri ocs support package for NIRI sequences.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014622>
  <PgfTag `Body'>
  <ParaLine 
   <String `The instrument specific packages are only loaded when a sequence using an instrument '>
  > # end of ParaLine
  <ParaLine 
   <String `is loaded so do not have to be present for instruments that are not going to be used.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014685>
  <PgfTag `Heading2'>
  <PgfNumString `\t6.3\t'>
  <ParaLine 
   <TextRectID 43>
   <String `Program structure'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014686>
  <PgfTag `BodyAfterHead'>
  <ParaLine 
   <String `The sequence executor executable '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `seqexec'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` is the usual hybrid bourne shell /tcl script '>
  > # end of ParaLine
  <ParaLine 
   <String `which decodes command lines, loads tcl packages, creates the ocswish epics service and '>
  > # end of ParaLine
  <ParaLine 
   <String `then creates and maps the '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `SeqExec'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` widget that forms the main window of the GUI. The '>
  > # end of ParaLine
  <ParaLine 
   <String `simulation and trace settings set by the command line options are stored in the global '>
  > # end of ParaLine
  <ParaLine 
   <String `array '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.R.700'>
    <FWeight `Bold'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Flags'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014694>
  <PgfTag `Body'>
  <ParaLine 
   <String `The '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `SeqExec'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` widget contains a '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `HeaderInfo'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` that contains elements for setting various '>
  > # end of ParaLine
  <ParaLine 
   <String `FITS header values; these are linked to global variables in the '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `dhshdr'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` package '>
  > # end of ParaLine
  <ParaLine 
   <String `namespace as is the \xd2 Generate DHS label automatically\xd3  checkbox in the '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `SeqExec'>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.700'>
    <FWeight `Bold'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String ` '>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `wid'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `get. The other option setting and status display widgets are linked to class common vari'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `ables in the '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Sequence'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` and '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `RealTcs'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` classes.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014695>
  <PgfTag `Body'>
  <ParaLine 
   <String `When a sequence is loaded a '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Sequence'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` object is created that parses the XML description '>
  > # end of ParaLine
  <ParaLine 
   <String `of the sequence using the procedures in the '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `seqparse '>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `namespace and converts it into a '>
  > # end of ParaLine
  <ParaLine 
   <String `tree of objects that mirrors the structure of the XML. These objects have parameters that '>
  > # end of ParaLine
  <ParaLine 
   <String `contain the names and values of the entities in the XML but no methods; they just pro'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `vide a description of the sequence that is easy to navigate and interrogate from tcl. '>
  > # end of ParaLine
  <ParaLine 
   <String `When the construction of the '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Sequence'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` object is complete they are discarded. A '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Step'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` '>
  > # end of ParaLine
  <ParaLine 
   <String `object is then created for each step in the sequence; these '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Step'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` objects contain references '>
  > # end of ParaLine
  <ParaLine 
   <String `to objects that represent the configuration of, and control, the TCS, GCAL, the instru'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `ment and the DHS. Finally, these objects are configured with the values of the parame'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `ter elements found in the sequence description.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014726>
  <PgfTag `Body'>
  <ParaLine 
   <String `If simulation of a subsystem has been selected with a command line option, the '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Step'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` will '>
  > # end of ParaLine
  <ParaLine 
   <String `contain a reference to a dummy object has the same interface as the genuine subsystem '>
  > # end of ParaLine
  <ParaLine 
   <String `object but prints messages to '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `stdout '>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `instead of sending commands to the real subsystem.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014727>
  <PgfTag `Body'>
  <ParaLine 
   <String `The command buttons on the user interface are linked to methods of the '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Sequence '>
  > # end of ParaLine
  <ParaLine 
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `object. The '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Sequence'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` object keeps track of which step in the sequence is currently being '>
  > # end of ParaLine
  <ParaLine 
   <String `executed and calls methods of the appropriate '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Step'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` object to implement the commands. '>
  > # end of ParaLine
  <ParaLine 
   <String `The '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Step'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` objects contain the logic necessary for sequencing and coordinating moving '>
  > # end of ParaLine
  <ParaLine 
   <String `the telescope and science fold, configuring the instrument, copying FITS header values '>
  > # end of ParaLine
  <ParaLine 
   <String `from the TCS to the DHS and taking exposures.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014547>
  <PgfTag `Heading2'>
  <PgfNumString `\t6.4\t'>
  <ParaLine 
   <String `Implementing a new instrument.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014552>
  <PgfTag `BodyAfterHead'>
  <ParaLine 
   <String `To support a new instrument you must:'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014553>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `Implement a new instrument specific class that handles interpretation of instrument '>
  > # end of ParaLine
  <ParaLine 
   <String `specific sequence parameters and handles all communications with the instrument.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014554>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `Add the new branch to a switch statement in '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Sequence.itcl'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` that creates an instance of '>
  > # end of ParaLine
  <ParaLine 
   <String `this object for each step in a sequence.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014555>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `If the instrument requires any instrument specific FITS headers to be generated by '>
  > # end of ParaLine
  <ParaLine 
   <String `the sequencer, add an instrument specific '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `HdrInfo '>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `class to the dhshdr ocs support '>
  > # end of ParaLine
  <ParaLine 
   <String `package.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014584>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `Create a file containing definitions of all the instrument command senders and status '>
  > # end of ParaLine
  <ParaLine 
   <String `acceptors in the '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `ca_config'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` subdirectory and add a statement to '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `seqexec.ca '>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `to include '>
  > # end of ParaLine
  <ParaLine 
   <String `it.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014589>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <TextRectID 44>
   <String `If the code for the new instrument supports a trace and/or debug mode, add the '>
  > # end of ParaLine
  <ParaLine 
   <String `appropriate options to the command line options defined in '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font

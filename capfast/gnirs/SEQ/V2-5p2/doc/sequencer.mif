   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014590>
  <PgfTag `Body'>
  <ParaLine 
   <String `The instrument specific class must implement the following public methods:'>
  > # end of ParaLine
 > # end of Para

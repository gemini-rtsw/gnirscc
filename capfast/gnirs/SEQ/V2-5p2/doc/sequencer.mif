  > # end of ParaLine
  <ParaLine 
   <String `to the end of the sequence.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014843>
  <PgfTag `Body'>
  <ParaLine 
   <String `If an error or timeout occurs during the execution of a sequence a dialog box containing '>
  > # end of ParaLine
  <ParaLine 
   <String `an error message (typically a message generated by the tcs, instrument or GCAL) is dis'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `played and the sequence goes into the paused state. To continue executing the sequence '>
  > # end of ParaLine
  <ParaLine 
   <String `you must dismiss the error dialog (by clicking on the '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `OK'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` button) and then press the '>
  > # end of ParaLine
  <ParaLine 
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Continue'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` button.'>
  > # end of ParaLine
 > # end of Para

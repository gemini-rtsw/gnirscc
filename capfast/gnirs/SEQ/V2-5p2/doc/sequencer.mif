 <Notes 
  <FNote 
   <ID 46>
   <Para 
    <Unique 1014449>
    <PgfTag `Footnote'>
    <ParaLine 
     <String `In the future the values of the '>
     <Font 
      <FTag `'>
      <FPlatformName `W.Times New Roman.I.400'>
      <FAngle `Italic'>
      <FEncoding `FrameRoman'>
      <FLocked No>
     > # end of Font
     <String `guideWith'>
     <Font 
      <FTag `'>
      <FLocked No>
     > # end of Font
     <String ` keywords will also select a guide star from a list of '>
    >
    <ParaLine 
     <String `star positions included in the sequence definition and load the guide-star position into the TCS.'>
    >
   > # end of Para
  > # end of FNote
  <FNote 
   <ID 47>
   <Para 
    <Unique 1014484>
    <PgfTag `Footnote'>
    <ParaLine 
     <String `The only instrument that supports the '>
     <Font 
      <FTag `'>
      <FPlatformName `W.Times New Roman.I.400'>
      <FAngle `Italic'>
      <FEncoding `FrameRoman'>
      <FLocked No>
     > # end of Font
     <String `coadds'>
     <Font 
      <FTag `'>
      <FLocked No>
     > # end of Font
     <String ` keyword at present is NIRI.'>
     <Font 
      <FTag `'>
      <FPlatformName `W.Times New Roman.I.400'>
      <FAngle `Italic'>
      <FEncoding `FrameRoman'>
      <FLocked No>
     > # end of Font
    >
   > # end of Para
  > # end of FNote
  <FNote 
   <ID 48>
   <Para 
    <Unique 1014514>
    <PgfTag `Footnote'>
    <ParaLine 
     <String `A brief test carried out in November 2001 indicates that in calm conditions and with a reason'>
     <Char SoftHyphen>
    >
    <ParaLine 
     <String `ably bright guide star it is possible to move the telescope up to 12 arcsec while continuing to '>
    >
    <ParaLine 
     <String `guide with PWFS1 and up to 16 arcsec when guiding with PWFS2.'>
    >
   > # end of Para
  > # end of FNote
 > # end of Notes
 <Para 
  <Unique 264875>
  <PgfTag `ReportTitle'>
  <ParaLine 
   <TextRectID 30>
   <String `The Sequence Executor'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011630>
  <PgfTag `ReportAuthor'>
  <ParaLine 
   <String `David Terrett, '>
   <Char HardReturn>
  > # end of ParaLine
  <ParaLine 
   <String `Rutherford Appleton Laboratory'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011637>
  <PgfTag `Version'>
  <ParaLine 
   <Variable 
    <VariableName `Filename (Short)'>
    <Unique 1011632>
   > # end of Variable
   <String ` Version: '>
   <Variable 
    <VariableName `Version'>
    <Unique 1011635>
   > # end of Variable
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011638>
  <PgfTag `ReportPurpose'>
  <ParaLine 
   <String `The Sequence Executor executes sequences of '>
  > # end of ParaLine
  <ParaLine 
   <String `observations, coordinating the telescope, instrument '>
  > # end of ParaLine
  <ParaLine 
   <String `and calibration unit and sending FITS headers '>
  > # end of ParaLine
  <ParaLine 
   <String `information obtained from the telescope and the '>
  > # end of ParaLine
  <ParaLine 
   <String `calibration unit to the DHS.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011609>
  <PgfTag `Heading1'>
  <PgfNumString `\t1.0\t'>
  <ParaLine 
   <TextRectID 31>
   <Marker 
    <MType 9>
    <MTypeName `Cross-Ref'>
    <MText `73279: Heading1: 1.0 Introduction'>
    <MCurrPage `1'>
    <Unique 1007754>
   > # end of Marker
   <String `Introduction'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011322>
  <PgfTag `Body'>
  <ParaLine 
   <String `The Sequence Executor is an ocswish program that runs on a Sun workstation and con'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `trols the TCS, GCAL, the DHS and an instrument in order to execute a sequence of '>
  > # end of ParaLine
  <ParaLine 
   <String `observations generated by the Observing Tool. The observation description exported by '>
  > # end of ParaLine
  <ParaLine 
   <String `the observing tool is in a format that conforms to the XML standard which can, if neces'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `sary, be edited with a text editor or even created from scratch. '>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011700>
  <PgfTag `Body'>
  <ParaLine 
   <String `The sequence description includes, for each step in the sequence, the configuration of '>
  > # end of ParaLine
  <ParaLine 
   <String `the instrument (filters, masks, exposure times, etc.), the type of the observation (object, '>
  > # end of ParaLine
  <ParaLine 
   <String `flat, dark, etc.), the configuration of GCAL (filters and lamps) and a telescope offset and '>
  > # end of ParaLine
  <ParaLine 
   <String `which wave-front sensors should be used for guiding and M1 active optics correction. '>
  > # end of ParaLine
  <ParaLine 
   <String `For each step the sequencer configures the instrument and GCAL, positions the tele'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `scope (disabling and then re-enabling guiding if necessary), positions the science fold '>
  > # end of ParaLine
  <ParaLine 
   <String `mirror and starts the exposure. At the start and end of each exposure FITS header values '>
  > # end of ParaLine
  <ParaLine 
   <String `are collected from the TCS and GCAL and sent to the DHS to be stored with the data '>
  > # end of ParaLine
  <ParaLine 
   <String `from the instrument.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011705>
  <PgfTag `Body'>
  <ParaLine 
   <String `The sequencer user interface allows sequences to be run automatically from start to fin'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `ished or executed one step at a time and a running sequence can paused and then contin'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `ued. The TCS, instrument and GCAL can be configured for a selected step and the '>
  > # end of ParaLine
  <ParaLine 
   <String `exposure for a selected step started. An exposure can be paused, continued or aborted '>
  > # end of ParaLine
  <ParaLine 
   <String `provided that the instrument supports the necessary commands.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011750>
  <PgfTag `Body'>
  <ParaLine 
   <String `The sequencer can be run with one or more of the TCS, GCAL, the DHS and instrument '>
  > # end of ParaLine
  <ParaLine 
   <String `simulated so that it can be used for engineering activities without all the systems having '>
  > # end of ParaLine
  <ParaLine 
   <String `to be available.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011721>
  <PgfTag `Body'>
  <ParaLine 
   <TextRectID 32>
   <String `The instruments currently supported are GMOS, NIRI and the acquisition camera.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011329>
  <PgfTag `Heading2'>
  <PgfNumString `\t1.1\t'>
  <ParaLine 
   <String `Intended audience'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1000152>
  <PgfTag `BodyAfterHead'>
  <ParaLine 
   <String `This document is aimed at'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014536>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `Support Scientists and Science Staff Associates.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014541>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `Software Support Staff.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011652>
  <PgfTag `Heading2'>
  <PgfNumString `\t1.2\t'>
  <ParaLine 
   <String `Scope'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011653>
  <PgfTag `BodyAfterHead'>
  <ParaLine 
   <String `This document describes how to use the sequence executor, how it interprets sequence '>
  > # end of ParaLine
  <ParaLine 
   <String `descriptions and what this translates to in terms of controlling the telescope and instru'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `ments. It also contains information of interest to programmers adding support for addi'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `tional instruments or making other modifications.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011657>
  <PgfTag `Heading2'>
  <PgfNumString `\t1.3\t'>
  <ParaLine 
   <String `Definitions, Acronyms and Abbreviations'>
  > # end of ParaLine
 > # end of Para

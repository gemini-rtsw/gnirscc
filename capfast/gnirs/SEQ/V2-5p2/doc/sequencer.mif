 > # end of Para
 <Para 
  <Unique 1014593>
  <PgfTag `Description'>
  <ParaLine 
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.R.700'>
    <FWeight `Bold'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `description'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <Char Tab>
   <String `Returns a description of the instrument configuration suitable '>
  > # end of ParaLine
  <ParaLine 
   <String `for display in the list of steps. This should contain whatever '>
  > # end of ParaLine
  <ParaLine 
   <String `information is likely to help the observer identify each step '>
  > # end of ParaLine
  <ParaLine 
   <String `without being overly long.'>
  > # end of ParaLine
 > # end of Para

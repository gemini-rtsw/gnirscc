 <Para 
  <Unique 1011849>
  <PgfTag `Heading2'>
  <PgfNumString `\t2.3\t'>
  <PgfReferenced Yes>
  <ParaLine 
   <Marker 
    <MType 9>
    <MTypeName `Cross-Ref'>
    <MText `60027: Heading2: 2.3 Special DHS headers'>
    <MCurrPage `6'>
    <Unique 1014744>
   > # end of Marker
   <String `Special DHS headers'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011850>
  <PgfTag `BodyAfterHead'>
  <ParaLine 
   <String `Some of the DHS header items that can be set by the user have special behaviour.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011851>
  <PgfTag `Numbered1'>
  <PgfNumString `1.\t'>
  <ParaLine 
   <String `The DHS label for each exposure is normally generated automatically by the DHS '>
  > # end of ParaLine
  <ParaLine 
   <String `and displayed in this field. If the '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Generate DHS automatically'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` option is unchecked, '>
  > # end of ParaLine
  <ParaLine 
   <String `the label can be entered manually but must be changed for each exposure so auto'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `matic execution of sequences in no longer possible.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011852>
  <PgfTag `Numbered'>
  <PgfNumString `2.\t'>
  <ParaLine 
   <String `The last field in the '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Data Label '>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `is a sequence number which is incremented by the '>
  > # end of ParaLine
  <ParaLine 
   <String `sequencer after each exposure. When a new sequence is loaded it is reset to 001. The '>
  > # end of ParaLine
  <ParaLine 
   <String `sequence number can be set to any integer value by typing into this field. '>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014780>
  <PgfTag `Numbered'>
  <PgfNumString `3.\t'>
  <ParaLine 
   <String `The '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `observation type'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` is normally set by the sequencer from information in the '>
  > # end of ParaLine
  <ParaLine 
   <String `sequence as each step is configured but can be overridden by typing into this field. '>
  > # end of ParaLine
  <ParaLine 
   <String `However, this only changes the value of the OBSTYPE keyword in the fits header; it '>
  > # end of ParaLine
  <ParaLine 
   <String `does not change the way CGAL, the instrument and the science fold mirror are con'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `figured.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1015325>
  <PgfTag `Numbered'>
  <PgfNumString `4.\t'>
  <ParaLine 
   <String `The SSA field is initialised from the value of the environment variable SSA.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1015326>
  <PgfTag `Numbered'>
  <PgfNumString `5.\t'>
  <ParaLine 
   <String `The Observer field is initialised from the value of the environment variable '>
  > # end of ParaLine
  <ParaLine 
   <String `OBSERVER.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011861>
  <PgfTag `Heading1'>
  <PgfNumString `\t3.0\t'>
  <ParaLine 
   <String `Sequence Interpretation'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011847>
  <PgfTag `BodyAfterHead'>
  <ParaLine 
   <String `When a sequence file is loaded it has to be converted into a description of the configura'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `tion of the instrument, the telescope and the calibration unit for each step in the '>
  > # end of ParaLine
  <ParaLine 
   <String `sequence. To do this, the sequencer must first determine what the observation type is for '>
  > # end of ParaLine
  <ParaLine 
   <String `the step; it does this by searching for the '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `observeType '>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `keyword in the '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `observe'>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.700'>
    <FWeight `Bold'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String ` '>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `element '>
  > # end of ParaLine
  <ParaLine 
   <String `of the step (if there is one). If the keyword has not been found it then searches through '>
  > # end of ParaLine
  <ParaLine 
   <String `the previous steps in the sequence in reverse order. If, after reaching the first step, an '>
  > # end of ParaLine
  <ParaLine 
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `observeType'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` has still not been found then, for the purposes of configuring the telescope '>
  > # end of ParaLine
  <ParaLine 
   <String `and the calibration unit, it is assumed to be \xd2 OBJECT\xd3 .'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014437>
  <PgfTag `Body'>
  <ParaLine 
   <String `This strategy of first searching the current step and then the preceding steps from the '>
  > # end of ParaLine
  <ParaLine 
   <String `current step to the beginning of the sequence for a keyword value is used for all key'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `words.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014438>
  <PgfTag `Heading2'>
  <PgfNumString `\t3.1\t'>
  <ParaLine 
   <TextRectID 37>
   <String `Telescope configuration'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014439>
  <PgfTag `BodyAfterHead'>
  <ParaLine 
   <String `The configuration of the telescope at each step is determined by the '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `observeType '>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `and the '>
  > # end of ParaLine
  <ParaLine 
   <String `following keywords:'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014446>
  <PgfTag `Description'>
  <ParaLine 
   <String `p & q'>
   <Char Tab>
   <String `These are the telescope offsets (in arcsec) relative to the '>
  > # end of ParaLine
  <ParaLine 
   <String `instrument principle direction as specified by the instrument '>
  > # end of ParaLine
  <ParaLine 
   <String `alignment angle set in the TCS. They are converted into x & '>
  > # end of ParaLine
  <ParaLine 
   <String `y instrument offsets in the focal plane coordinates system '>
  > # end of ParaLine
  <ParaLine 
   <String `that rotates with the Cassegrain rotator.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014447>
  <PgfTag `Description'>
  <ParaLine 
   <String `guideWithPWFS1'>
   <Char Tab>
   <String `Specifies whether the PWFS1 probe arm should be parked '>
  > # end of ParaLine
  <ParaLine 
   <String `('>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `park'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `), left in follow mode but not tracking a guide star '>
  > # end of ParaLine
  <ParaLine 
   <String `('>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `freeze'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `) or tracking a star ('>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `any other value)'>
   <FNote 46>
   <String `.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014451>
  <PgfTag `Description'>
  <ParaLine 
   <String `guideWithPWFS2'>
   <Char Tab>
   <String `The same as '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `guideWithPWFS2'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` but for PWFS2.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014456>
  <PgfTag `Description'>
  <ParaLine 
   <String `guideWithOIWFS'>
   <Char Tab>
   <String `The same as '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `guideWithOIWFS'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` but for the on-instrument '>
  > # end of ParaLine
  <ParaLine 
   <String `wave-front sensor.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014459>
  <PgfTag `Body'>
  <ParaLine 
   <String `The '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `posAngle'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` keyword currently ignored.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014460>
  <PgfTag `Body'>
  <ParaLine 
   <String `Whether or not tip/tilt guiding and M1 active optics is turned on depends on both which '>
  > # end of ParaLine
  <ParaLine 
   <String `wave-front sensors are tracking a guidestar and the starting configuration of the TCS. '>
  > # end of ParaLine
  <ParaLine 
   <String `The starting configuration is read from the TCS by pressing the button labeled '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `CON'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `FIGURE FROM current TCS setup'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `. '>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014465>
  <PgfTag `Body'>
  <ParaLine 
   <String `The science fold mirror is controlled by the '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `observeType '>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `for the step; if it is \xd2 OBJECT\xd3  '>
  > # end of ParaLine
  <ParaLine 
   <String `or \xd2 SKY\xd3  it is positioned so that light from the sky reaches the instrument, if it is '>
  > # end of ParaLine
  <ParaLine 
   <String `\xd2 FLAT\xd3  or \xd2 ARC\xd3  it is positioned so that light from the calibration unit reaches the '>
  > # end of ParaLine
  <ParaLine 
   <String `instrument. If it has any other value, or is not specified at all, it will not be moved when '>
  > # end of ParaLine
  <ParaLine 
   <String `the step is executed.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014466>
  <PgfTag `Heading2'>
  <PgfNumString `\t3.2\t'>
  <ParaLine 
   <String `Instrument configuration.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014482>
  <PgfTag `BodyAfterHead'>
  <ParaLine 
   <String `When determining the configuration of an instrument there is an additional complica'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `tion when searching for the exposure time and number of coadds'>
   <FNote 47>
   <String `; if the observe type is '>
  > # end of ParaLine
  <ParaLine 
   <String `\xd2 ARC\xd3 , \xd2 BIAS\xd3 , \xd2 DARK\xd3  or \xd2 FLAT\xd3  then the appearance of either of these keywords '>
  > # end of ParaLine
  <ParaLine 
   <String `in a '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `calibration'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` element overrides the values in the '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `observe '>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `or '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `instrument'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` elements '>
  > # end of ParaLine
  <ParaLine 
   <String `except that any definition in the current step takes precedence over a definition in pre'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `ceding step.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014467>
  <PgfTag `Heading3'>
  <PgfNumString `\t3.2.1\t'>
  <ParaLine 
   <String `Acquisition Camera'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014470>
  <PgfTag `BodyAfterHead'>
  <ParaLine 
   <String `The acquisition camera configuration is controlled by the following keywords:'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014474>
  <PgfTag `Description'>
  <ParaLine 
   <String `ndfilter'>
   <Char Tab>
   <String `The name of the neutral density filter.'>
  > # end of ParaLine

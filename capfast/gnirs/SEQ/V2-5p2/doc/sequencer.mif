 > # end of Para
 <Para 
  <Unique 1014599>
  <PgfTag `Body'>
  <ParaLine 
   <String `All these methods return the value 1 if the succeed and 0 if they don\xd5 t. If they return '>
  > # end of ParaLine
  <ParaLine 
   <String `zero they must also append an error message to the variable '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.R.700'>
    <FWeight `Bold'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `::Sequence::errormsg '>
  > # end of ParaLine
  <ParaLine 
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `(with '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.R.700'>
    <FWeight `Bold'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `lappend'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `).'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014611>
  <PgfTag `Body'>
  <ParaLine 
   <String `The procedure that is executed when the instrument setup or exposure has finished must '>
  > # end of ParaLine
  <ParaLine 
   <String `be called with a argument that is 1 if the operation completed successfully or 0 if it did '>
  > # end of ParaLine
  <ParaLine 
   <String `not. If the latter, an error message must be appended to '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.R.700'>
    <FWeight `Bold'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `::Sequence::errormsg'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014623>
  <PgfTag `Body'>
  <ParaLine 
   <String `And set the values of the following public variables in its constructor:'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014624>
  <PgfTag `Description'>
  <ParaLine 
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.R.700'>
    <FWeight `Bold'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `agname'>
   <Char Tab>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `The instrument name as defined in the EPICS records in the '>
  > # end of ParaLine
  <ParaLine 
   <String `A&G sequencer that indicate what instrument is located on '>
  > # end of ParaLine
  <ParaLine 
   <String `each ISS port.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014628>
  <PgfTag `Description'>
  <ParaLine 
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.R.700'>
    <FWeight `Bold'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `sfname'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <Char Tab>
   <String `The instrument part of the science fold mirror positions that '>
  > # end of ParaLine
  <ParaLine 
   <String `are defined in the A&G lookup tables.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014630>
  <PgfTag `Body'>
  <ParaLine 
   <String `The value of '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.R.700'>
    <FWeight `Bold'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `sfname'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` will usually be same for all steps but may sometimes be different '>
  > # end of ParaLine
  <ParaLine 
   <String `depending on the instrument configuration if different science fold positions are defined '>
  > # end of ParaLine
  <ParaLine 
   <String `for different configurations.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014633>
  <PgfTag `Description'>
  <ParaLine 
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.R.700'>
    <FWeight `Bold'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `instobj'>
   <Char Tab>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `The name of an object that has public variables with names '>
  > # end of ParaLine
  <ParaLine 
   <String `that match the instrument parameters that appear in the '>
  > # end of ParaLine
  <ParaLine 
   <String `sequence files. These variables must include '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.R.700'>
    <FWeight `Bold'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `observeType.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014634>
  <PgfTag `Body'>
  <ParaLine 
   <TextRectID 45>
   <String `Because the object referred to by '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.R.700'>
    <FWeight `Bold'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `instobj'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` is accessed outside the object that created it, '>
  > # end of ParaLine
  <ParaLine 
   <String `the name must be fully qualified with its namespace as in:'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014818>
  <PgfTag `Description'>
  <ParaLine 
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.R.700'>
    <FWeight `Bold'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font

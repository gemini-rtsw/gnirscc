    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String ` '>
   <Char Tab>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `Runs the entire sequence from the beginning.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011788>
  <PgfTag `Description'>
  <ParaLine 
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.R.700'>
    <FWeight `Bold'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Pause'>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String ` '>
   <Char Tab>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `Pauses the sequence either before the next exposure or before '>
  > # end of ParaLine
  <ParaLine 
   <String `the next telescope and instrument re-configuration, which'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `ever comes next.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011793>
  <PgfTag `Description'>
  <ParaLine 
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.R.700'>
    <FWeight `Bold'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Step'>
   <Font 

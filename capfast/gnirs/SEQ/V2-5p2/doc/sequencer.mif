  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1008026>
  <PgfTag `Heading1'>
  <PgfNumString `\t2.0\t'>
  <ParaLine 
   <TextRectID 33>
   <Marker 
    <MType 9>
    <MTypeName `Cross-Ref'>
    <MText `30866: Heading1: 2.0 User Requirements'>
    <MCurrPage `3'>
    <Unique 1007758>
   > # end of Marker
   <String `User Interface'>
   <ATbl 9>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011848>
  <PgfTag `Heading2'>
  <PgfNumString `\t2.1\t'>
  <ParaLine 
   <String `Interface elements'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011735>
  <PgfTag `BodyAfterHead'>
  <ParaLine 
   <String `The user interface consists of a single control panel illustrated by Figure '>
   <XRef 
    <XRefName `Bulletnum'>
    <XRefSrcText `30117: FigureTitle: FIGURE 1. Sequence executor main window'>
    <XRefSrcIsElem No>
    <XRefSrcFile `'>
    <XRefLastUpdate  1014305813 231000>
    <Unique 1014720>
   > # end of XRef
   <String `1'>
   <XRefEnd >
   <String ` with the fol'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `lowing elements (from top to bottom):'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011736>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <TextRectID 34>
   <Marker 
    <MType 9>
    <MTypeName `Cross-Ref'>
    <MText `10873: Heading1: 4.0 Further work'>
    <MCurrPage `4'>
    <Unique 1011427>
   > # end of Marker
   <String `A '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.R.700'>
    <FWeight `Bold'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `File'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` menu with the following commands:'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011737>
  <PgfTag `Description'>
  <ParaLine 
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.R.700'>
    <FWeight `Bold'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Load Sequence'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` '>
   <Char Tab>
   <String `Displays an \xd2 open-file\xd3  dialog box for selecting a sequence '>
  > # end of ParaLine
  <ParaLine 
   <String `file to be loaded into the sequencer'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011738>
  <PgfTag `Description'>
  <ParaLine 
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.R.700'>
    <FWeight `Bold'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `View Sequence'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` '>
   <Char Tab>
   <String `Displays the XML source of the currently loaded sequence in '>
  > # end of ParaLine
  <ParaLine 
   <String `a top-level window. This window can be closed with the '>
  > # end of ParaLine
  <ParaLine 
   <String `usual window manager menu.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011743>
  <PgfTag `Description'>
  <ParaLine 
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.R.700'>
    <FWeight `Bold'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Exit'>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <Char Tab>
   <Char Tab>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String ` Terminates the sequencer program.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011747>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `A line of text that describes the current execution state of the sequence (idle, config'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `uring the instrument, paused, etc.)'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011751>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `A set of data entry fields for setting the values of various FITS header keywords. '>
  > # end of ParaLine
  <ParaLine 
   <String `The first three, '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `DHS label, Data label '>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `and '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `Observation Type'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `, have special meanings '>
  > # end of ParaLine
  <ParaLine 
   <String `and behaviour as described in section '>
   <XRef 
    <XRefName `Bulletnum'>
    <XRefSrcText `60027: Heading2: 2.3 Special DHS headers'>
    <XRefSrcIsElem No>
    <XRefSrcFile `'>
    <XRefLastUpdate  1014305813 231000>
    <Unique 1014745>
   > # end of XRef
   <String `2.3'>
   <XRefEnd >
   <String `; the remainder simply set the value of the '>
  > # end of ParaLine
  <ParaLine 
   <String `corresponding FITS keyword in the data header. Some of the fields have drop-down '>
  > # end of ParaLine
  <ParaLine 
   <String `lists of pre-defined values but additional values can by typed'>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String ` '>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `into the field and will '>
  > # end of ParaLine
  <ParaLine 
   <String `be added to the list.'>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011748>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `A diagram that illustrates the telescope offsets for each step in the sequence. As the '>
  > # end of ParaLine
  <ParaLine 
   <String `sequence is executed, the currently executing step is coloured yellow and then turns '>
  > # end of ParaLine
  <ParaLine 
   <String `grey when it has finished.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011749>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `A list of all the steps in the sequence with the name of the step, the telescope offsets, '>
  > # end of ParaLine
  <ParaLine 
   <String `the type of the observation and a brief description of the configuration of the instru'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `ment. '>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011752>
  <PgfTag `Body'>
  <ParaLine 
   <String `The amount of screen space allocated to the diagram and the list can be changed by '>
  > # end of ParaLine
  <ParaLine 
   <String `resizing the entire application window by dragging on its border or by dragging on the '>
  > # end of ParaLine
  <ParaLine 
   <String `border between the two widgets to allocate more space to the list and less to the diagram '>
  > # end of ParaLine
  <ParaLine 
   <String `or '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `vice-versa'>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011753>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `A check boxes for setting the following options:'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011754>
  <PgfTag `Bulleted2'>
  <PgfNumString `\xd1 \t'>
  <ParaLine 
   <String `Turning on and off the automatic generation of DHS labels. If automatic genera'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `tion is turned off it is not possible to run sequences automatically because the '>
  > # end of ParaLine
  <ParaLine 
   <String `same data label would then be used for each observation.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011755>
  <PgfTag `Bulleted2'>
  <PgfNumString `\xd1 \t'>
  <ParaLine 
   <String `Ignoring the TCS '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `in-position '>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `status'>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `. '>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `The sequencer normally waits for the TCS to '>
  > # end of ParaLine
  <ParaLine 
   <String `signal that all its sub-systems are in their demanded positions before re-enabling '>
  > # end of ParaLine
  <ParaLine 
   <String `guiding and starting an exposure. Selecting this option allows engineering expo'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `sures to be started without having to wait for the telescope to be ready.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014516>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `A field for setting the largest offset that the telescope will make without guiding first '>
  > # end of ParaLine
  <ParaLine 
   <String `being disabled.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1014684>
  <PgfTag `Body'>
  <ParaLine 
   <String `These settings can be changed at any time and will apply as soon as the sequencer exe'>
   <Char SoftHyphen>
  > # end of ParaLine
  <ParaLine 
   <String `cutes the next operation.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011756>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `A line of text that describes the guiding and active optics configuration that the '>
  > # end of ParaLine
  <ParaLine 
   <String `sequencer will use at each step, subject to the necessary wave-front sensors being '>
  > # end of ParaLine
  <ParaLine 
   <String `deployed.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011784>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `A button labeled '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `CONFIGURE FROM current TCS setup '>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `that updates the current '>
  > # end of ParaLine
  <ParaLine 
   <String `guiding and active optics configuration from the current state of the TCS.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011785>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <TextRectID 35>
   <String `A row of button in a frame labeled '>
   <Font 
    <FTag `'>
    <FPlatformName `W.Times New Roman.I.400'>
    <FAngle `Italic'>
    <FEncoding `FrameRoman'>
    <FLocked No>
   > # end of Font
   <String `System Configuration: '>
   <Font 
    <FTag `'>
    <FLocked No>
   > # end of Font
   <String `that configure the tcs, '>
  > # end of ParaLine
  <ParaLine 
   <String `instrument and GCAL ready for taking the exposure for the step specified in the '>
  > # end of ParaLine
  <ParaLine 
   <String `adjacent entry field, either all simultaneously or individually. If a step in the list of '>
  > # end of ParaLine
  <ParaLine 
   <String `steps is clicked, the name of the step is automatically entered in the step name field.'>
  > # end of ParaLine
 > # end of Para
 <Para 
  <Unique 1011786>
  <PgfTag `Bulleted'>
  <PgfNumString `\xa5 \t'>
  <ParaLine 
   <String `A row of buttons for controlling the execution of the sequence. The buttons are:'>
  > # end of ParaLine
 > # end of Para

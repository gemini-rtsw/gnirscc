 > # end of Para
 <Para 
  <Unique 1011682>
  <PgfTag `Acronyms'>
  <ParaLine 
   <String `ocswish'>
   <Char Tab>
   <Char Tab>
   <Char Tab>
   <Char Tab>
   <String `A Tcl/Tk interpreter with additional commands for controlling '>
  > # end of ParaLine
  <ParaLine 
   <String `and communicating with EPICS and the DHS.'>
  > # end of ParaLine
 > # end of Para
 <Para 

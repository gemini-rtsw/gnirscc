#  Copyright CCLRC
#+

package require Gmos
package require gmosDhshdr

itcl::class GmosInst {
   inherit GenericInst
   public {
      constructor {} {}
      destructor {}
      method description {}
      method observe {label whendone}
      method setup {whendone}
      }
   private {
      method obsoktest {}
      method setupDC {}
      variable setupISaction
      variable setupDCaction
   }
}

# Create the principle system objects for Gmos.

namespace eval GmosInst {
   global Flags
   global env
   seq::PrincipalSystem GMOS gmos::apply -debug $Flags(traceinst)  \
         -simulate $Flags(simgmos) -delay 1
   seq::PrincipalSystem GMOSDC gmos::dcapply -debug $Flags(traceinst) \
         -simulate $Flags(simgmos) -delay 1
}

itcl::body GmosInst::constructor {} {

# Set the public variables used to determine the science fold position.
   set agname GMOS
   set sfname gmos

# Set the protected variables used by the generic instrument methods to the
# name of the principle system used by the observe action and the prefix
# for the sequence commands.
   set psys GmosInst::GMOSDC
   set prefix gmos

# Create the instrument configuration object. The fully qualified namespace 
# has to be used so that the object is accessible outside this class. The
# Gmos object is configured from the parameter settings in the sequence
# file by the Sequence object as it is created.
   set instobj [namespace current]::[Gmos::Gmos #auto]

# Create the actions for configuring the instrument. The apply record remains
# BUSY until the configuration is complete so these actions do not need to
# have -waitvar or -oktest options set. Completion of the DC action is handled
# by methods inhierited from GenericInst.
   set setupISaction [seq::Action #auto GmosInst::GMOS]
   $setupISaction configure\
         -onerror [itcl::code $this setuperror] \
         -ontimeout [itcl::code $this setuptimeout] \
         -onok [itcl::code $this setupDC] \
         -timeout 600

   set setupDCaction [seq::Action #auto GmosInst::GMOSDC]
   $setupDCaction configure\
         -onerror [itcl::code $this setuperror] \
         -ontimeout [itcl::code $this setuptimeout] \
         -onok [itcl::code $this setupok]
   $setupDCaction connect gmos::dcconfig

$instobj configDCaction [namespace current]::$setupDCaction
$instobj configCCaction [namespace current]::$setupISaction


# Create the actions for observing and continuing. This actions needs to be 
# accessible to GenericInst so that it can restart an observation after a
# pause.
   set obsaction [namespace current]::[seq::Action #auto GmosInst::GMOSDC]
   $obsaction configure -onerror [itcl::code $this obserror] \
         -ontimeout [itcl::code $this obstimeout] \
         -onok [itcl::code $this obsok] \
         -oktest [itcl::code $this obsoktest] \
         -waitvar gmos::observeDCStatus

# The timeout on the continue action is set by GenericInst.
   set contaction [namespace current]::[seq::Action #auto GmosInst::GMOSDC]
   $contaction configure -onerror [itcl::code $this obserror] \
         -onok [itcl::code $this obsok] \
         -oktest [itcl::code $this obsoktest] \
         -waitvar gmos::observeDCStatus
   $contaction set gmos::continue dummy MARK
}

itcl::body GmosInst::destructor {} {
   itcl::delete object $obsaction
   itcl::delete object $contaction
   itcl::delete object $setupISaction
   itcl::delete object $setupDCaction
   itcl::delete object $instobj
}

itcl::body GmosInst::observe {label whendone} {

# Sends an "observe" sequence command to the instrument with the DHS
# label set to $label and calls the $whendone script when the exposure 
# has finished.

#  Only proceed if an observe is not already in progress.
   if { $GenericInst::observing } {
      lappend Sequence::errormsg "Error sending observe: observe already in\
            progress"
      return 0
   } else {

# Save the done proc.
      set doneproc $whendone

# Set the data label.
      $obsaction set ${prefix}::observe label $label

# Set the action timeout to the exposure time plus 5 minutes.
      $obsaction configure -timeout [$instobj calcTimeout]

# Post the observe command.
      $obsaction start

# Record that an observe is in progress and the time that it was started.
      set GenericInst::observing 1
      set GenericInst::starttime [clock seconds]
      return 1
   }
}

itcl::body GmosInst::obsoktest {} {
   return [string equal IDLE [sa gmos::dcstatus get observe]]
}

itcl::body GmosInst::setup {whendone} {

# Configures the instrument ready to take an exposure.

#  Only proceed if an observe is not in progress.
   if { $GenericInst::observing } {
      lappend Sequence::errormsg "Error configuring instrument: observe\
            already in progress"
      return 0
   } else {

# Save the done proc.
      set doneproc $whendone

# If the observe type is DARK or BIAS the don't bother with the CC
# configuration and call the DC setup directly.
      set obstype [$instobj cget -observeType]
      if { $obstype == "DARK" || $obstype == "BIAS" } {
         # Start the detector controller setup action.
         $instobj apply detector
         return 1
      } else {

# Start the instrument sequencer setup action.
         $instobj apply components
         return 1
      }
   }
}

itcl::body GmosInst::setupDC {} {

# Start the detector controller setup action.
   $instobj apply detector
}

itcl::body GmosInst::description {} {

# Returns the current filter name and exposure time.
   return "[$instobj cget -filter] [$instobj cget -exposureTime]s"
}


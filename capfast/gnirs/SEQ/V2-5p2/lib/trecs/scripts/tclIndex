# Tcl autoload index file, version 2.0
# This file is generated by the "auto_mkindex" command
# and sourced to set up indexing information for one or
# more commands.  Typically each line is a command that
# sets an element in the auto_index array, where the
# element name is the name of a command and the value is
# a script that loads the command.

set auto_index(::Trecs::CC) [list source [file join $dir CC.itcl]]
set auto_index(::Trecs::CC::apply) [list source [file join $dir CC.itcl]]
set auto_index(::Trecs::CC::log) [list source [file join $dir CC.itcl]]
set auto_index(::Trecs::DC) [list source [file join $dir DC.itcl]]
set auto_index(::Trecs::DC::apply) [list source [file join $dir DC.itcl]]
set auto_index(::Trecs::DC::log) [list source [file join $dir DC.itcl]]
set auto_index(::Trecs::DC::calcTimeout) [list source [file join $dir DC.itcl]]
set auto_index(::Trecs::Trecs) [list source [file join $dir Trecs.itcl]]
set auto_index(::Trecs::Trecs::apply) [list source [file join $dir Trecs.itcl]]
set auto_index(::Trecs::Trecs::init) [list source [file join $dir Trecs.itcl]]
set auto_index(::Trecs::Trecs::save) [list source [file join $dir Trecs.itcl]]

#+
#  SequenceNS.itcl
#
#  A sequenceNS is a nod and shuffle sequence.
#
#  Matthieu Bec 31 October 2002
#
#+

itcl::class SequenceNS {
   inherit Sequence
   public {
   method parse {xml} {
      if { [catch { set xml [nodshuffler::expand $xml]} msg] } {
         set errormsg $msg
         } else {
         Sequence::parse $xml
         nodshuffler::seqconf $this
         }
      }
   }
}

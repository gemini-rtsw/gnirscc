/*
 * This file contains the SNL code which triggers identical actions
 * in all mechanisms simultaneously.
 */

#if defined(CC)
program engCcSt ("top=niri:eng:")
#elif defined(WFS)
program engWfsSt ("top=niri:eng:")
#else
#error CC or WFS must be defined.
#endif

%%#include <stdlib.h>
%%#include <stdioLib.h>
%%#include <string.h>
%%#include <ctype.h>

#if defined(CC)
#define NDEV 10
#elif defined(WFS)
#define NDEV 4
#endif

long op;
assign op to "{top}gblOp.VAL";
monitor op;

long opCount;
assign opCount to "{top}gblOpCount.VAL";
monitor opCount;

evflag opCountFlag; /* Event flag triggered by changes to opCount */
sync opCount opCountFlag;

long stopCount;
assign stopCount to "{top}gblStopCount.VAL";
monitor stopCount;

evflag stopCountFlag; /* Event flag triggered by changes to stopCount */
sync stopCount stopCountFlag;

long tmp;
assign tmp to "{top}lockTmp.VAL";
monitor tmp;

evflag tmpFlag; /* Event flag triggered by changes to tmp */
sync tmp tmpFlag;

long safeCount;
assign safeCount to "{top}gblSafeCount.VAL";
monitor safeCount;

evflag safeFlag; /* Event flag triggered by changes to safeCount */
sync safeCount safeFlag;

long opList[NDEV];
#if defined(CC)
	assign opList to {
		"{top}cc:covOp.VAL",
		"{top}cc:filt1Op.VAL",
		"{top}cc:filt2Op.VAL",
		"{top}cc:filt3Op.VAL",
		"{top}cc:focOp.VAL",
		"{top}cc:foplOp.VAL",
		"{top}cc:puvwOp.VAL",
		"{top}cc:spltOp.VAL",
		"{top}cc:ster1Op.VAL",
		"{top}cc:ster2Op.VAL"
	};
#elif defined(WFS)
	assign opList to {
		"{top}wfs:filtOp.VAL",
		"{top}wfs:focOp.VAL",
		"{top}wfs:prbxOp.VAL",
		"{top}wfs:prbyOp.VAL"
	};
#endif

long datumList[NDEV];
#if defined(CC)
	assign datumList to {
		"{top}cc:covHallstep.DATM",
		"{top}cc:filt1Hallstep.DATM",
		"{top}cc:filt2Hallstep.DATM",
		"{top}cc:filt3Hallstep.DATM",
		"{top}cc:focHallstep.DATM",
		"{top}cc:foplHallstep.DATM",
		"{top}cc:puvwHallstep.DATM",
		"{top}cc:spltHallstep.DATM",
		"{top}cc:ster1Hallstep.DATM",
		"{top}cc:ster2Hallstep.DATM"
	};
#elif defined(WFS)
	assign datumList to {
		"{top}wfs:filtHallstep.DATM",
		"{top}wfs:focHallstep.DATM",
		"{top}wfs:prbxHallstep.DATM",
		"{top}wfs:prbyHallstep.DATM"
	};
#endif

long stopList[NDEV];
#if defined(CC)
	assign stopList to {
		"{top}cc:covHallstep.STOP",
		"{top}cc:filt1Hallstep.STOP",
		"{top}cc:filt2Hallstep.STOP",
		"{top}cc:filt3Hallstep.STOP",
		"{top}cc:focHallstep.STOP",
		"{top}cc:foplHallstep.STOP",
		"{top}cc:puvwHallstep.STOP",
		"{top}cc:spltHallstep.STOP",
		"{top}cc:ster1Hallstep.STOP",
		"{top}cc:ster2Hallstep.STOP"
	};
#elif defined(WFS)
	assign stopList to {
		"{top}wfs:filtHallstep.STOP",
		"{top}wfs:focHallstep.STOP",
		"{top}wfs:prbxHallstep.STOP",
		"{top}wfs:prbyHallstep.STOP"
	};
#endif

long backlashList[NDEV];
#if defined(CC)
	assign backlashList to {
		"{top}cc:covPosErr.VAL",
		"{top}cc:filt1PosErr.VAL",
		"{top}cc:filt2PosErr.VAL",
		"{top}cc:filt3PosErr.VAL",
		"{top}cc:focPosErr.VAL",
		"{top}cc:foplPosErr.VAL",
		"{top}cc:puvwPosErr.VAL",
		"{top}cc:spltPosErr.VAL",
		"{top}cc:ster1PosErr.VAL",
		"{top}cc:ster2PosErr.VAL"
	};
#elif defined(WFS)
	assign backlashList to {
		"{top}wfs:filtPosErr.VAL",
		"{top}wfs:focPosErr.VAL",
		"{top}wfs:prbxPosErr.VAL",
		"{top}wfs:prbyPosErr.VAL"
	};
#endif

int i;

/*
 *+
 * FUNCTION NAME: op_ss
 *
 * INVOCATION: N/A
 *
 * PARAMETERS: N/A
 *
 * FUNCTION VALUE: (none)
 *
 * SCOPE: N/A
 *
 * PURPOSE:  Propagate op command
 *
 *     Issue an operation code to all mechanisms.
 *
 * DESCRIPTION:
 *
 * EXTERNAL VARIABLES:
 *
 *     opCount
 *     opCountFlag
 *     opList
 *
 * PRIOR REQUIREMENTS:
 *
 * DEFICIENCIES:
 *-
 */

ss op_ss
{
	/*
	 * Make sure that all flags are cleared, after initial connection.
	 */

	state init {
		when (pvConnectCount() == pvChannelCount()) {
			/*
			 * Ensure the event flags to be monitored later are initially
			 * cleared.
			 */

			efClear(opCountFlag);
		} state ready
	}

	/*
	 * When the op counter changes, then the operation needs to be issued
	 * to all mechanisms
	 */
     
	state ready {
		when (efTest(opCountFlag)) {
			efClear(opCountFlag);

			pvGet(op);
			for (i = 0; i < NDEV; i++) {
				opList[i] = op;
				pvPut(opList[i]);
			}
		} state ready
    }
}

/*
 *+
 * FUNCTION NAME: stop_ss
 *
 * INVOCATION: N/A
 *
 * PARAMETERS: N/A
 *
 * FUNCTION VALUE: (none)
 *
 * SCOPE: N/A
 *
 * PURPOSE:  Propagate stop command
 *
 *     Stop all mechanisms which are currently in motion.
 *
 * DESCRIPTION:
 *
 * EXTERNAL VARIABLES:
 *
 *     stopCount
 *     stopCountFlag
 *     stopList
 *
 * PRIOR REQUIREMENTS:
 *
 * DEFICIENCIES:
 *-
 */

ss stop_ss
{
	state init {
		/*
		 * Make sure that all flags are cleared, after initial connection.
		 */

		when (pvConnectCount() == pvChannelCount()) {
			/*
			 * Ensure the event flags to be monitored later are initially
			 * cleared.
			 */

			efClear(stopCountFlag);
		} state ready
	}

	/*
	 * When the stop counter changes, then a stop needs to be issued
	 * to all mechanisms
	 */
     
	state ready {
		when (efTest(stopCountFlag)) {
			efClear(stopCountFlag);

			for (i = 0; i < NDEV; i++) {
				stopList[i] = 1;
				pvPut(stopList[i]);
			}
		} state ready
    }
}

/*
 *+
 * FUNCTION NAME: tmp_ss
 *
 * INVOCATION: N/A
 *
 * PARAMETERS: N/A
 *
 * FUNCTION VALUE: (none)
 *
 * SCOPE: N/A
 *
 * PURPOSE:  Clear 'datumed' flag upon temperature change
 *
 *     When the temperature changes, put the system into the undatumed
 *     state.  (The datum position is different when the system is
 *     cold).
 *
 * DESCRIPTION:
 *
 * EXTERNAL VARIABLES:
 *
 *     tmp
 *     tmpFlag
 *     datumList
 *
 * PRIOR REQUIREMENTS:
 *
 * DEFICIENCIES:
 *-
 */

ss tmp_ss
{
	/*
	 * Make sure that all flags are cleared, after initial connection.
	 */
	
	state init {
		when (pvConnectCount() == pvChannelCount()) {
			/*
			 * Ensure the event flags to be monitored later are initially
			 * cleared.
			 */

			efClear(tmpFlag);
		} state changing
	}

	/* 
	 * Whenever the temperature changes, clear the 'datumed' flags
	 */

	state changing {
		when (efTest(tmpFlag)) {
			efClear(tmpFlag);

			for (i = 0; i < NDEV; i++) {
				datumList[i] = 0;
				pvPut(datumList[i]);
			}
		} state changing
	}
}

/*
 *+
 * FUNCTION NAME: safe_ss
 *
 * INVOCATION: N/A
 *
 * PARAMETERS: N/A
 *
 * FUNCTION VALUE: (none)
 *
 * SCOPE: N/A
 *
 * PURPOSE:  Set 'datumed' flag and clear the 'backlash' flag.
 *
 *     When the system is first started, the state of the 'datumed' and
 *     'backlash' flags are unknown, so the worst case is assumed.  In
 *     practice, the system was often rebooted when it was in a reasonable
 *     state, so this allows the user to clear all the warning messages
 *     quickly and easily.
 *
 * DESCRIPTION:
 *
 * EXTERNAL VARIABLES:
 *
 * PRIOR REQUIREMENTS:
 *
 * DEFICIENCIES:
 *-
 */

ss safe_ss
{
	/*
	 * Make sure that all flags are cleared, after initial connection.
	 */
	
	state init {
		when (pvConnectCount() == pvChannelCount()) {
			/*
			 * Ensure the event flags to be monitored later are initially
			 * cleared.
			 */

			efClear(safeFlag);
		} state changing
	}

	/* 
	 * Whenever the safeFlag changes, set all the datumed flags and clear
	 * all the backlash flags.  Note that the flags are first toggled
	 * into the alternate state, because the code which monitors these
	 * flags looks for a transition from true to false or false to true.
	 */

	state changing {
		when (efTest(safeFlag)) {
			efClear(safeFlag);

			for (i = 0; i < NDEV; i++) {
				datumList[i] = 0;
				pvPut(datumList[i]);
				datumList[i] = 1;
				pvPut(datumList[i]);

				backlashList[i] = 1;
				pvPut(backlashList[i]);
				backlashList[i] = 0;
				pvPut(backlashList[i]);
			}
		} state changing
	}
}

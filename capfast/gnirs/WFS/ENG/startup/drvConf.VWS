#
# Configure OMS board.
#

#void homsSetup(int num_cards,        /* maximum number of cards in rack */
#     int num_channels,  /* Channels per card (4 or 8) */
#     void *addrs,       /* Base Address(0x0-0xb000 on 4K boundary) */
#     unsigned vector,   /* noninterrupting(0), valid vectors(64-255) */
#     int int_level,     /* interrupt level (1-6) */
#     int scan_rate)     /* polling rate - 1/60 sec units */
homsSetup(2,8,0xFC80,0,5,6)

#
# Configure xy490 board.
#

#void xy490Init(
#     int board,              /* Board id (0 or 1) */
#     int addr,               /* Board base Address */
#     unsigned vector)        /* valid vectors (128-254) [uses two vectors] */
#xy490Init(0, 0xE000, 0xE0)
#sysIntEnable(2)

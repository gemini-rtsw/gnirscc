# $Id: startupWfsSim.VWS,v 1.2 2009/05/27 19:34:50 fkraemer Exp $

#
# VxWorks startup script to load and execute system (iocCore) software.
#
# Full working WFS-only simulator system.
#

# First, vxWorks startup issues:

# Make delete key work for backspace
tyBackspaceSet 0177

# cd to application install directory (beware automounter problems)
cd "$(install)"
pwd

# The local file contains site-specific information
# such as the default router and the vxWorks password file.

< $(version)/bin/$(arch)/local

# Load EPICS core and record stuff
ld < $(epics)/base/bin/$(arch)/iocCore
ld < $(epics)/base/bin/$(arch)/drvSup
ld < $(epics)/base/bin/$(arch)/recSup
ld < $(epics)/base/bin/$(arch)/devSup

# If using state programs, load the sequencer
ld < $(epics)/base/bin/$(arch)/seq

# If using pvload, load it
ld < $(epics)/extensions/bin/$(arch)/pvload

# Load any application records, device support or drivers here,
# or code for subroutine records
ld < $(version)/bin/$(arch)/eng.o

# Configure software
#< $(version)/bin/$(arch)/drvConf
#< $(version)/bin/$(arch)/drvAltConf
< $(version)/bin/$(arch)/drvSimConf

# Load sequences here
# ld < $(version)/bin/$(arch)/testseq.o

# Configure the Timestamp system, 1=Master IOC
TSconfigure 1, 0, 0, 0, 0, 0

# Load one or more ASCII databases here
dbLoad "$(version)/data/$(dctsdr).dctsdr"

dbLoadRecords "$(version)/ENG/data/engTop.db"

#dbLoadRecords "$(version)/ENG/data/ccTop.db"
#dbLoadRecords "$(version)/ENG/data/ccSimTop.db"

#dbLoadRecords "$(version)/ENG/data/altwfsTop.db"
#dbLoadRecords "$(version)/ENG/data/wfsTop.db"
dbLoadRecords "$(version)/ENG/data/wfsSimTop.db"

#dbLoadRecords "$(version)/ENG/data/tmpTop.db"
#dbLoadRecords "$(version)/ENG/data/tmpSimTop.db"

# Add records to monitor all input lines (only needed for debugging)

#dbLoadRecords "$(version)/ENG/data/atodTop.db"
#dbLoadRecords "$(version)/ENG/data/dioTop.db"

# This turns off logging
# iocLogDisable=1

iocInit "$(version)/data/resource.def"

# Load parameters.

#< $(version)/bin/$(arch)/engParm
#< $(version)/bin/$(arch)/ccParm
#< $(version)/bin/$(arch)/wfsParm
#< $(version)/bin/$(arch)/tmpParm

< $(version)/bin/$(arch)/engSimParm
#< $(version)/bin/$(arch)/ccSimParm
< $(version)/bin/$(arch)/wfsSimParm
#< $(version)/bin/$(arch)/tmpSimParm

# Initialize the interlock handler.

< $(version)/bin/$(arch)/lockBusy
#< $(version)/bin/$(arch)/lockCc
< $(version)/bin/$(arch)/lockWfs
< $(version)/bin/$(arch)/lockIdle

# Start sequences.

< $(version)/bin/$(arch)/engSeq
#< $(version)/bin/$(arch)/ccSeq
< $(version)/bin/$(arch)/wfsSeq

# Final initialization.

< $(version)/bin/$(arch)/done

# Set the prompt.

shellPromptSet "@(name) SIM> "

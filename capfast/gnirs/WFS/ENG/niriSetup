#! /bin/sh

# $Id: niriSetup,v 1.2 2009/05/27 19:33:57 fkraemer Exp $

if [ "${NIRI_PREFIX}" = "" ]; then
	2>&1 echo NIRI_PREFIX is not defined.  Please source your
	2>&1 echo configured niriLogin file.
	exit 1
fi

if [ "${NIRI_NAME}" = "" ]; then
	2>&1 echo NIRI_NAME is not defined.  Please source your
	2>&1 echo configured niriLogin file.
	exit 1
fi

if [ "${NIRI_TMPSCAN}" = "" ]; then
	2>&1 echo NIRI_TMPSCAN is not defined.  Please source your
	2>&1 echo configured niriLogin file.
	exit 1
fi

if [ "${NIRI_TMPVAR}" = "" ]; then
	2>&1 echo NIRI_TMPVAR is not defined.  Please source your
	2>&1 echo configured niriLogin file.
	exit 1
fi

if [ "${NIRI_TMPHB}" = "" ]; then
	2>&1 echo NIRI_TMPHB is not defined.  Please source your
	2>&1 echo configured niriLogin file.
	exit 1
fi

if [ -f config/CONFIG.Defs ]; then
	echo "* Removing old CONFIG.Defs"
	rm config/CONFIG.Defs
fi

if [ -f startup/local.vws ]; then
	echo "* Removing old local.vws"
	rm startup/local.vws
fi

if [ -f startup/resource.def ]; then
	echo "* Removing old startup/resource.def"
	rm startup/resource.def
fi

if [ "$NIRI_TARGETS" = "" ]; then
	NIRI_TARGETS=mv167
fi

applSetup -targets ${NIRI_TARGETS} -I ascii -I capfast -I config -I dl \
	-I src -I startup -I scripts -I tcl -I pv

echo Checking files

if [ "`grep -c resource.def startup/.cvsignore`" = "0" ]; then
	echo '* Adding resource.def to startup/.cvsignore.'
	echo resource.def >> startup/.cvsignore
fi

if [ "`grep -c UAE.dist startup/.cvsignore`" = "0" ];  then
	echo '* Adding UAE.dist to startup/.cvsignore.'
	echo UAE.dist >> startup/.cvsignore
fi

if [ "`grep -c config.par .cvsignore`" = "0" ]; then
	echo '* Adding config.par to .cvsignore.'
	echo config.par >> .cvsignore
fi

for file in atod cc dio ccSim eng tmp tmpSim wfs wfsSim; do
	if [ "`grep -c ${file}Top.sch capfast/.cvsignore`" = "0" ]; then
		echo "* Adding ${file}Top.sch to capfast/.cvsignore."
		echo ${file}Top.sch >> capfast/.cvsignore
	fi
done

if [ "`grep -c '^*.dl$' dl/.cvsignore`" != "0" ]; then
	echo "* Removing '*.dl' from dl/.cvsignore."
	grep -v '^*.dl$' dl/.cvsignore >> dl/$$.cvsignore
	mv dl/$$.cvsignore dl/.cvsignore
fi

echo Creating links

rm -f ENG
ln -s . ENG

#
# Generate configuration file.
#

echo Generating config.par.
cat << _EOF_ > config.par
#
# This file was automatically generated by niriSetup
# Do not edit it by hand.
#
	prefix=${NIRI_PREFIX}
	name=${NIRI_NAME}
	tmpscan="${NIRI_TMPSCAN}"
	tmpvar=${NIRI_TMPVAR}
	tmphb=${NIRI_TMPHB}
_EOF_

echo Installing bin/$HOST_ARCH/config.par.
test -d bin/$HOST_ARCH || \
	{ echo mkdir -p bin/$HOST_ARCH; mkdir -p bin/$HOST_ARCH; }

#
# Configure top-level capfast diagrams.
#

capfast/genTop capfast/templateTop.sch capfast/*Set.sch

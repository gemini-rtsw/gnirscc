#include <dbDefs.h>
#include <choiceGbl.h>
#include <dbFldTypes.h>
#define INCdbRecDesh
#include <dbRecDes.h>
#include<guigroup.h>
#include <choiceTsen.h>
RECTYP	"tsen"
!
! Prompt               fld  special    field            pp interest  init pmt       range1      range2 conversion
!                      name            type                         size  choice_set 
!
"Current value"        VAL  0          ASL0 DBF_LONG        YES   0      0   0
"Output Specification" OUT  SPC_NOMOD  ASL1 DBF_OUTLINK     NO    1          GUI_OUTPUT
"Units name"           EGU  0          ASL1 DBF_RECCHOICE   YES   2      0   REC_TSEN_UNITS CON 0 CON 2
"High Operating Range" HOPR 0          ASL1 DBF_LONG        NO    1      0   GUI_DISPLAY VAR LOPR        CON 2147483647  CT_DECIMAL
"Low Operating Range"  LOPR 0          ASL1 DBF_LONG        NO    1      0   GUI_DISPLAY CON -2147483648 VAR HOPR        CT_DECIMAL
"Hihi Alarm Limit"     HIHI 0          ASL1 DBF_LONG        YES   1      0   GUI_ALARMS VAR HIGH        CON 2147483647  CT_DECIMAL
"Lolo Alarm Limit"     LOLO 0          ASL1 DBF_LONG        YES   1      0   GUI_ALARMS CON -2147483648 VAR LOW         CT_DECIMAL
"High Alarm Limit"     HIGH 0          ASL1 DBF_LONG        YES   1      0   GUI_ALARMS VAR LOW         VAR HIHI        CT_DECIMAL
"Low Alarm Limit"      LOW  0          ASL1 DBF_LONG        YES   1      0   GUI_ALARMS VAR LOLO        VAR HIGH        CT_DECIMAL
"Hihi Severity"        HHSV 0          ASL1 DBF_GBLCHOICE   YES   1      0  GBL_ALARM_SEV  GUI_ALARMS VAR HSV         CON 4
"Lolo Severity"        LLSV 0          ASL1 DBF_GBLCHOICE   YES   1      0  GBL_ALARM_SEV GUI_ALARMS VAR LSV         CON 4
"High Severity"        HSV  0          ASL1 DBF_GBLCHOICE   YES   1      0  GBL_ALARM_SEV GUI_ALARMS CON 0           VAR HHSV
"Low Severity"         LSV  0          ASL1 DBF_GBLCHOICE   YES   1      0  GBL_ALARM_SEV GUI_ALARMS CON 0           VAR LLSV
"Alarm Deadband"       HYST 0          ASL1 DBF_LONG        NO    1      0  GUI_ALARMS CON -2147483648 CON 2147483647  CT_DECIMAL
"Archive Deadband"     ADEL 0          ASL1 DBF_LONG        NO    1      0  GUI_DISPLAY CON -2147483648 CON 2147483647  CT_DECIMAL
"Monitor Deadband"     MDEL 0          ASL1 DBF_LONG        NO    1      0  GUI_DISPLAY CON -2147483648 CON 2147483647  CT_DECIMAL
"Last Value Alarmed"   LALM SPC_NOMOD  ASL1 DBF_LONG        NO    3      0   0
"Last Value Archived"  ALST SPC_NOMOD  ASL1 DBF_LONG        NO    3      0   0
"Last Val Monitored"   MLST SPC_NOMOD  ASL1 DBF_LONG        NO    3      0   0
"Sim Input Specifctn"  SIOL SPC_NOMOD  ASL1 DBF_INLINK      NO    1                        GUI_INPUTS
"Simulation Value"     SVAL 0          ASL1 DBF_LONG        NO    0      0                 0
"Sim Mode Location"    SIML SPC_NOMOD  ASL1 DBF_INLINK      NO    1                        GUI_INPUTS
"Simulation Mode"      SIMM 0          ASL1 DBF_GBLCHOICE   NO    1      0   GBL_YES_NO     0
"Sim mode Alarm Svrty" SIMS 0          ASL1 DBF_GBLCHOICE   NO    2      0   GBL_ALARM_SEV GUI_INPUTS
"Display Precision"    PREC 0          ASL1 DBF_LONG       NO    1      0                 0
"Rate"                 RATE SPC_NOMOD  ASL1 DBF_DOUBLE     NO    1      0                 0
"Old Rate"             ORTE SPC_NOMOD  ASL1 DBF_DOUBLE     NO    4      0                 0
"Enable TMP1"          TMP1 0          ASL1 DBF_SHORT      NO    2      0                 0
"Enable TMP2"          TMP2 0          ASL1 DBF_SHORT      NO    2      0                 0
"Enable TMP3"          TMP3 0          ASL1 DBF_SHORT      NO    2      0                 0
"Enable TMP4"          TMP4 0          ASL1 DBF_SHORT      NO    2      0                 0
"Enable TMP5"          TMP5 0          ASL1 DBF_SHORT      NO    2      0                 0
"Enable TMP6"          TMP6 0          ASL1 DBF_SHORT      NO    2      0                 0
"Enable TMP7"          TMP7 0          ASL1 DBF_SHORT      NO    2      0                 0
"Enable TMP8"          TMP8 0          ASL1 DBF_SHORT      NO    2      0                 0

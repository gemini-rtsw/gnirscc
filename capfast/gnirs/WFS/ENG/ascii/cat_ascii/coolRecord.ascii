#include <dbDefs.h>
#include <choiceGbl.h>
#include <dbFldTypes.h>
#define INCdbRecDesh
#include <dbRecDes.h>
#include<guigroup.h>
#include <choiceCool.h>
RECTYP	"cool"
!
! Prompt               fld  special    field            pp interest  init pmt       range1      range2 conversion
!                      name            type                         size  choice_set 
!
"Current value"        VAL  0          ASL0 DBF_LONG        YES   0      0   0
"Motor 0 Velocity"     OVL0 SPC_NOMOD ASL1 DBF_OUTLINK      NO    1          GUI_OUTPUT
"Motor 1 Velocity"     OVL1 SPC_NOMOD ASL1 DBF_OUTLINK      NO    1          GUI_OUTPUT
"Current motor 0 pos"  IPS0 SPC_NOMOD ASL1 DBF_INLINK       NO    1          GUI_INPUTS
"Current motor 1 pos"  IPS1 SPC_NOMOD ASL1 DBF_INLINK       NO    1          GUI_INPUTS
"Motor 0 Position"     OPS0 SPC_NOMOD ASL1 DBF_OUTLINK      NO    1          GUI_OUTPUT
"Motor 1 Position"     OPS1 SPC_NOMOD ASL1 DBF_OUTLINK      NO    1          GUI_OUTPUT
"Motor 0 Jog"          OJG0 SPC_NOMOD ASL1 DBF_OUTLINK      NO    1          GUI_OUTPUT
"Motor 1 Jog"          OJG1 SPC_NOMOD ASL1 DBF_OUTLINK      NO    1          GUI_OUTPUT
"Stop 0 motion"        OST0 SPC_NOMOD ASL1 DBF_OUTLINK      NO    1          GUI_OUTPUT
"Stop 1 motion"        OST1 SPC_NOMOD ASL1 DBF_OUTLINK      NO    1          GUI_OUTPUT
"Motor 0 Moving"       IDM0 SPC_NOMOD ASL1 DBF_INLINK       NO    1          GUI_INPUTS
"Motor 1 Moving"       IDM1 SPC_NOMOD ASL1 DBF_INLINK       NO    1          GUI_INPUTS
"Motor 0 Enable"       OPW0 SPC_NOMOD ASL1 DBF_OUTLINK      NO    1         GUI_OUTPUT
"Motor 1 Enable"       OPW1 SPC_NOMOD ASL1 DBF_OUTLINK      NO    1         GUI_OUTPUT
"Disable timer"        TIMR SPC_NOMOD ASL1 DBF_OUTLINK      NO    1          GUI_OUTPUT
"Set point 0"          SET0 SPC_NOMOD ASL1 DBF_OUTLINK      NO    1          GUI_OUTPUT
"Set point 1"          SET1 SPC_NOMOD ASL1 DBF_OUTLINK      NO    1          GUI_OUTPUT
"Set point 2"          SET2 SPC_NOMOD ASL1 DBF_OUTLINK      NO    1          GUI_OUTPUT
"Ctrl tmp 0"           TMP0 SPC_NOMOD ASL1 DBF_INLINK       NO    1          GUI_INPUTS
"Ctrl tmp 1"           TMP1 SPC_NOMOD ASL1 DBF_INLINK       NO    1          GUI_INPUTS
"Ctrl tmp 2"           TMP2 SPC_NOMOD ASL1 DBF_INLINK       NO    1          GUI_INPUTS
"Temp sensor 0"        T0   SPC_NOMOD ASL1 DBF_INLINK       NO    1          GUI_INPUTS
"Temp sensor 1"        T1   SPC_NOMOD ASL1 DBF_INLINK       NO    1          GUI_INPUTS
"Temp sensor 2"        T2   SPC_NOMOD ASL1 DBF_INLINK       NO    1          GUI_INPUTS
"Temp sensor 3"        T3   SPC_NOMOD ASL1 DBF_INLINK       NO    1          GUI_INPUTS
"Temp sensor 4"        T4   SPC_NOMOD ASL1 DBF_INLINK       NO    1          GUI_INPUTS
"Temp sensor 5"        T5   SPC_NOMOD ASL1 DBF_INLINK       NO    1          GUI_INPUTS
"Temp sensor 6"        T6   SPC_NOMOD ASL1 DBF_INLINK       NO    1          GUI_INPUTS
"Temp sensor 7"        T7   SPC_NOMOD ASL1 DBF_INLINK       NO    1          GUI_INPUTS
"Units name"           EGU  0          ASL1 DBF_STRING      NO    1     16   GUI_DISPLAY
"High Operating Range" HOPR 0          ASL1 DBF_LONG        NO    1      0   GUI_DISPLAY VAR LOPR        CON 2147483647  CT_DECIMAL
"Low Operating Range"  LOPR 0          ASL1 DBF_LONG        NO    1      0   GUI_DISPLAY CON -2147483648 VAR HOPR        CT_DECIMAL
"Hihi Alarm Limit"     HIHI 0          ASL1 DBF_LONG        YES   1      0   GUI_ALARMS VAR HIGH        CON 2147483647  CT_DECIMAL
"Lolo Alarm Limit"     LOLO 0          ASL1 DBF_LONG        YES   1      0   GUI_ALARMS CON -2147483648 VAR LOW         CT_DECIMAL
"High Alarm Limit"     HIGH 0          ASL1 DBF_LONG        YES   1      0   GUI_ALARMS VAR LOW         VAR HIHI        CT_DECIMAL
"Low Alarm Limit"      LOW  0          ASL1 DBF_LONG        YES   1      0   GUI_ALARMS VAR LOLO        VAR HIGH        CT_DECIMAL
"Hihi Severity"        HHSV 0          ASL1 DBF_GBLCHOICE   YES   1      0  GBL_ALARM_SEV  GUI_ALARMS VAR HSV         CON 4
"Lolo Severity"        LLSV 0          ASL1 DBF_GBLCHOICE   YES   1      0  GBL_ALARM_SEV GUI_ALARMS VAR LSV         CON 4
"High Severity"        HSV  0          ASL1 DBF_GBLCHOICE   YES   1      0  GBL_ALARM_SEV GUI_ALARMS CON 0           VAR HHSV
"Low Severity"         LSV  0          ASL1 DBF_GBLCHOICE   YES   1      0  GBL_ALARM_SEV GUI_ALARMS CON 0           VAR LLSV
"Alarm Deadband"       HYST 0          ASL1 DBF_LONG        NO    1      0  GUI_ALARMS CON -2147483648 CON 2147483647  CT_DECIMAL
"Archive Deadband"     ADEL 0          ASL1 DBF_LONG        NO    1      0  GUI_DISPLAY CON -2147483648 CON 2147483647  CT_DECIMAL
"Monitor Deadband"     MDEL 0          ASL1 DBF_LONG        NO    1      0  GUI_DISPLAY CON -2147483648 CON 2147483647  CT_DECIMAL
"Last Value Alarmed"   LALM SPC_NOMOD  ASL1 DBF_LONG        NO    3      0   0
"Last Value Archived"  ALST SPC_NOMOD  ASL1 DBF_LONG        NO    3      0   0
"Last Val Monitored"   MLST SPC_NOMOD  ASL1 DBF_LONG        NO    3      0   0
"Sim Input Specifctn"  SIOL SPC_NOMOD  ASL1 DBF_INLINK      NO    1                        GUI_INPUTS
"Simulation Value"     SVAL 0          ASL1 DBF_LONG        NO    0      0                 0
"Sim Mode Location"    SIML SPC_NOMOD  ASL1 DBF_INLINK      NO    1                        GUI_INPUTS
"Simulation Mode"      SIMM 0          ASL1 DBF_GBLCHOICE   NO    1      0   GBL_YES_NO     0
"Sim mode Alarm Svrty" SIMS 0          ASL1 DBF_GBLCHOICE   NO    2      0   GBL_ALARM_SEV GUI_INPUTS
"Display Precision"    PREC 0          ASL1 DBF_LONG       NO    1      0                 0
"Post monitor"         MON  SPC_NOMOD  ASL1 DBF_LONG       NO    4      0                 0
"Rate"                 RATE 0          ASL0 DBF_RECCHOICE  YES   1      0               REC_COOL_RATE CON 0 CON 2
"Old Rate"             LRTE 0          ASL1 DBF_RECCHOICE  NO    4      0               REC_COOL_RATE CON 0 CON 2
"Low speed"            LOSP 0          ASL0 DBF_LONG       NO    3      10000  0
"High speed"           HISP 0          ASL0 DBF_LONG       NO    3      5000  0 
"Increment motor 0"    INC  0          ASL0 DBF_LONG       YES   3      0  0
"Step size"            STEP 0          ASL0 DBF_LONG       NO    4      1  0
"State"                BUSY SPC_NOMOD  ASL0 DBF_STRING     NO    4      16              GUI_DISPLAY

! DRIVE
"User Desired Value (EGU)"	VAL		SPC_MOD		ASL1	DBF_DOUBLE		YES	0			0						0	CON -1e30	CON 1e30
"Last User Des Val (EGU)"	LVAL	SPC_NOMOD	ASL1	DBF_DOUBLE		NO	1			0						0	CON -1e30	CON 1e30
"Dial Desired Value (EGU)"	DVAL	SPC_MOD		ASL1	DBF_DOUBLE		YES	0			0						0	CON -1e30	CON 1e30
"Last Dial Des Val (EGU)"	LDVL	SPC_NOMOD	ASL1	DBF_DOUBLE		NO	1			0						0	CON -1e30	CON 1e30
"Raw Desired Value (steps)"	RVAL	SPC_MOD		ASL1	DBF_LONG		YES	0			0						0	CON -2e9	CON 2e9		CT_DECIMAL
"Last Raw Des Val (steps)"	LRVL	SPC_NOMOD	ASL1	DBF_LONG		NO	1			0						0	CON -1e30	CON 1e30

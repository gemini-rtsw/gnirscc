! .01	02-03-93    tmm Initial evolution from steppermotorRecord.ascii
! .02	11-23-94    jps Add actual velocity readback field
! .03   06-12-95    tmm Add .vers (version) field
! .04   12-27-95    tmm Added new resolution and speed fields.  Compatible
!                       with version 1.9 of the record.
! .05   06-10-96    tmm Changed SREV (steps/revolution) from DBF_SHORT to DBF_LONG.
#include <dbDefs.h>
#include <special.h>
#include <choiceGbl.h>
#include <choiceHmotor.h>
#include <dbFldTypes.h>
#define INCdbRecDesh
#include <dbRecDes.h>
RECTYP "hmotor"
! special is one of {NULL, SPC_NOMOD, SPC_DBADDR, SPC_SCAN, SPC_MOD, SPC_RESET, SPC_LINCONV, SPC_CALC}
! DBF_int	means any of {DBF_UCHAR, DBF_SHORT, DBF_LONG, DBF_ULONG}
! DBF_float	means any of {DBF_FLOAT, DBF_DOUBLE}
! DBF_link	means any of {DBF_INLINK, DBF_OUTLINK, DBF_FWDLINK}
!
! Prompt					name	special		access	DBF_STRING		pp	interest	size					pmt
! Prompt					name	special		access	DBF_int			pp	interest	init					pmt	range1		range2		cvt_type
! Prompt					name	special		access	DBF_float		pp	interest	init					pmt	range1		range2
! Prompt					name	special		access	DBF_ENUM		pp	interest	init					pmt	range1		range2
! Prompt					name	special		access	DBF_GBLCHOICE	pp	interest	init	choice_set		pmt
! Prompt					name	special		access	DBF_RECCHOICE	pp	interest	init	choice_set		pmt
! Prompt					name	special		access	DBF_CVTCHOICE	pp	interest	init					pmt
! Prompt					name	special		access	DBF_link		pp	interest							pmt	range1		range2		conversion
! Prompt					name	special		access	DBF_NOACCESS	pp	interest	size						code
!
"Code Version"				VERS	SPC_NOMOD	ASL1	DBF_FLOAT		NO	0			1.0						0
"User Offset (EGU)"			OFF		SPC_MOD		ASL1	DBF_DOUBLE		YES	0			0						0	CON -1e30	CON 1e30
"Offset-Freeze Switch"		FOFF	SPC_MOD		ASL1	DBF_RECCHOICE	NO	1			0		REC_HMOTOR_FOFF	1
"Freeze Offset"				FOF		SPC_MOD		ASL0	DBF_SHORT		NO	1			0						0
"Variable Offset"			VOF		SPC_MOD		ASL0	DBF_SHORT		NO	1			0						0
"User Direction"			DIR		SPC_MOD		ASL1	DBF_RECCHOICE	YES	1			0		REC_HMOTOR_DIR	1
"Set/Use Switch"			SET		NULL		ASL1	DBF_RECCHOICE	NO	1			0		REC_HMOTOR_SET	0
"Set SET Mode"				SSET	SPC_MOD		ASL0	DBF_SHORT		NO	1			0						0
"Set USE Mode"				SUSE	SPC_MOD		ASL0	DBF_SHORT		NO	1			0						0
!
"Velocity (EGU/s)"			VELO	SPC_MOD		ASL1	DBF_FLOAT		NO	1			0						1	CON 0		CON 1e30 
"Base Velocity (EGU/s)"		VBAS	SPC_MOD		ASL1	DBF_FLOAT		NO	1			0						1	CON 0		CON 1e30 
"Speed (revolutions/sec)"	S		SPC_MOD		ASL1	DBF_FLOAT		NO	1			5.0						1	CON 0		CON 1e30 
"Base Speed (RPS)"			SBAS	SPC_MOD		ASL1	DBF_FLOAT		NO	1			1.0						1	CON 0		CON 1e30 
"Seconds to Velocity"		ACCL	SPC_MOD		ASL1	DBF_FLOAT		NO	1			0.2						1	CON 0		CON 1e30 
!
"BL Distance (EGU)"			BDST	NULL		ASL1	DBF_FLOAT		NO	1			0						1	CON -1e30	CON 1e30 
"BL Velocity (EGU/s)"		BVEL	SPC_MOD		ASL1	DBF_FLOAT		NO	1			0						1	CON 0		CON 1e30 
"BL Speed (RPS)"			SBAK	SPC_MOD		ASL1	DBF_FLOAT		NO	1			1.0						1	CON 0		CON 1e30 
"BL Seconds to Velocity"	BACC	SPC_MOD		ASL1	DBF_FLOAT		NO	1			0.5						1	CON 0		CON 1e30 
"Move Fraction"				FRAC	SPC_MOD		ASL1	DBF_FLOAT		NO	1			1						1	CON 0.5		CON 1 
!
! LINK SUPPORT
"Output Specification"		OUT		SPC_NOMOD	ASL1	DBF_OUTLINK		NO	1									1
"Card Number"				CARD 	SPC_NOMOD	ASL1	DBF_SHORT		NO	3			0						0
"Readback Location"			RDBL	SPC_NOMOD	ASL1	DBF_INLINK		NO	1									1
"Desired Output Loc"		DOL		SPC_NOMOD	ASL1	DBF_INLINK		NO	1									1
"Output Mode Select"		OMSL	NULL		ASL1	DBF_GBLCHOICE	NO	1			0	GBL_OMSL			1
"Readback OutLink"			RLNK	SPC_NOMOD	ASL1	DBF_OUTLINK		NO	1									1
!
"Operating Mode"			MODE	NULL		ASL1	DBF_RECCHOICE	NO	1			0	REC_HMOTOR_MODE		1
!
"Steps per Revolution"		SREV	SPC_MOD		ASL1	DBF_LONG		YES	1			200						1	CON 0	CON 1e6		CT_DECIMAL
"EGU's per Revolution"		UREV	SPC_MOD		ASL1	DBF_FLOAT		YES	1			0						1	CON -1e30	CON 1e30 
"Motor Step Size (EGU)"		MRES	SPC_MOD		ASL1	DBF_FLOAT		YES	1			0						1	CON -1e30	CON 1e30 
"Encoder Step Size (EGU)"	ERES	SPC_MOD		ASL1	DBF_FLOAT		YES	1			0						1	CON -1e30	CON 1e30 
"Readback Step Size (EGU)"	RRES	NULL		ASL1	DBF_FLOAT		NO	1			0						1	CON -1e30	CON 1e30 
"Step Size (EGU)"			RES 	SPC_NOMOD	ASL1	DBF_FLOAT		NO	1			0						0	CON 0		CON 1e30
"Use Encoder If Present"	UEIP	SPC_MOD		ASL1	DBF_RECCHOICE	YES	1			0	REC_HMOTOR_YN		1
"Use RDBL Link If Present"	URIP	NULL		ASL1	DBF_RECCHOICE	YES	1			0	REC_HMOTOR_YN		1
"Make Readback = Value"		TRAK	NULL		ASL1	DBF_RECCHOICE	YES	1			0	REC_HMOTOR_YN		1
"Display Precision"			PREC	NULL		ASL1	DBF_SHORT		NO	1			0						1	CON 0		CON 20		CT_DECIMAL
"Engineering Units"			EGU		NULL		ASL1	DBF_STRING		NO	1			16						YES
!
! LIMITS
"User High Limit"			HLM		SPC_MOD		ASL1	DBF_FLOAT		YES	0			0						0	VAR LLM		CON 1e30
"User Low Limit"			LLM		SPC_MOD		ASL1	DBF_FLOAT		YES	0			0						0	CON -1e30	VAR HLM
"Dial High Limit"			DHLM	SPC_MOD		ASL1	DBF_FLOAT		YES	0			0						1	VAR DLLM	CON 1e30 
"Dial Low Limit"			DLLM	SPC_MOD		ASL1	DBF_FLOAT		YES	0			0						1	CON -1e30	VAR DHLM
!"Periodic Limits"			PERL	NULL		ASL1	DBF_RECCHOICE	NO	1			0	REC_HMOTOR_YN		1
"High Operating Range"		HOPR	NULL		ASL1	DBF_FLOAT		NO	1			0						1	VAR LOPR	CON 1e30
"Low Operating Range"		LOPR	NULL		ASL1	DBF_FLOAT		NO	1			0						1	CON -1e30	VAR HOPR
!
! LIMIT SWITCHES
"User High Limit Switch"	HLS		SPC_NOMOD	ASL1	DBF_SHORT		NO	0			0						0	CON 0		CON 1		CT_DECIMAL
"User Low Limit Switch"		LLS		SPC_NOMOD	ASL1	DBF_SHORT		NO	0			0						0	CON 0		CON 1		CT_DECIMAL
"Raw High Limit Switch"		RHLS	SPC_NOMOD	ASL1	DBF_SHORT		NO	0			0						0	CON 0		CON 1		CT_DECIMAL
"Raw Low Limit Switch"		RLLS	SPC_NOMOD	ASL1	DBF_SHORT		NO	0			0						0	CON 0		CON 1		CT_DECIMAL
!
! ALARMS
"Hihi Alarm Limit (EGU)"	HIHI	NULL		ASL1	DBF_FLOAT		YES	2			0						1	VAR HIGH	CON 1e30 
"Lolo Alarm Limit (EGU)"	LOLO	NULL		ASL1	DBF_FLOAT		YES	2			0						1	CON -1e30	VAR LOW
"High Alarm Limit (EGU)"	HIGH	NULL		ASL1	DBF_FLOAT		YES	2			0						1	VAR LOW		VAR HIHI
"Low Alarm Limit (EGU)"		LOW		NULL		ASL1	DBF_FLOAT		YES	2			0						1	VAR LOLO	VAR HIGH
"Hihi Severity"				HHSV	NULL		ASL1	DBF_GBLCHOICE	YES	2			0	GBL_ALARM_SEV		1	VAR HSV		CON 4
"Lolo Severity"				LLSV	NULL		ASL1	DBF_GBLCHOICE	YES	2			0	GBL_ALARM_SEV		1	VAR LSV		CON 4
"High Severity"				HSV		NULL		ASL1	DBF_GBLCHOICE	YES	2			0	GBL_ALARM_SEV		1	CON 0		VAR HHSV
"Low Severity"				LSV		NULL		ASL1	DBF_GBLCHOICE	YES	2			0	GBL_ALARM_SEV		1	CON 0		VAR LLSV
"HW Limit Violation Svr"	HLSV	NULL		ASL1	DBF_GBLCHOICE	YES	2			0	GBL_ALARM_SEV		1	CON 0		CON 4
!
"Monitor Deadband"			MDEL	NULL		ASL1	DBF_FLOAT		NO	1			0						1	CON -1e30	CON 1e30 
"Archive Deadband"			ADEL	NULL		ASL1	DBF_FLOAT		NO	1			0						1	CON -1e30	CON 1e30 
!
"Retry Deadband (EGU)"		RDBD	SPC_MOD		ASL1	DBF_FLOAT		NO	1			0						1	CON 0		CON 1e30 
"Retry count"				RCNT	SPC_NOMOD	ASL1	DBF_SHORT		NO	2			0						0	CON 0		VAR RTRY	CT_DECIMAL
"Max retry count"			RTRY	NULL		ASL1	DBF_SHORT		NO	1			10						1	CON 0		CON 100		CT_DECIMAL
"Ran out of retries"		MISS	SPC_NOMOD	ASL1	DBF_SHORT		NO	2			0						0	CON 0		CON 1		CT_DECIMAL
!
! COMMAND "BUTTONS"
"Stop/Pause/Move/Go"		SPMG 	NULL		ASL1	DBF_RECCHOICE	YES	1			3	REC_HMOTOR_SPMG		0
"Last SPMG"					LSPG	SPC_NOMOD	ASL1	DBF_RECCHOICE	NO	1			3	REC_HMOTOR_SPMG		0
"Stop"						STOP	NULL		ASL1	DBF_SHORT		YES	1			0						0	CON 0		CON 1		CT_DECIMAL
"Home Forward"				HOMF	NULL		ASL1	DBF_SHORT		YES	1			0						0	CON 0		CON 1		CT_DECIMAL
"Home Reverse"				HOMR	NULL		ASL1	DBF_SHORT		YES	1			0						0	CON 0		CON 1		CT_DECIMAL
"Jog motor Forward"			JOGF	NULL		ASL1	DBF_SHORT		YES	1			0						0	CON 0		CON 1		CT_DECIMAL
"Jog motor Reverse"			JOGR	NULL		ASL1	DBF_SHORT		YES	1			0						0	CON 0		CON 1		CT_DECIMAL
"Tweak motor Forward"		TWF		NULL		ASL1	DBF_SHORT		YES	1			0						0	CON 0		CON 1		CT_DECIMAL
"Tweak motor Reverse"		TWR 	NULL		ASL1	DBF_SHORT		YES	1			0						0	CON 0		CON 1		CT_DECIMAL
"Tweak Step Size (EGU)"		TWV 	NULL		ASL1	DBF_FLOAT		NO	1			0						1	CON -1e30	CON 1e30

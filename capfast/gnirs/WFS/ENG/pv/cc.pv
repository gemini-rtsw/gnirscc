# $Id: cc.pv,v 1.2 2009/05/27 19:34:08 fkraemer Exp $

#########################################################################
# Warning: When setting CDSA, CDSB, CDSC, insure that CDSC is a safe
# location to leave the mechanism in (usually 0), and that the move
# from CDSB to CDSC is in the correct direction for backlash removal
# (for all NIRI mechanisms, this is the positive direction.)
#
# The meaning of these parameters is defined in the NIRI implementation
# notes and record reference manual (niri_hty_011.fm).
#########################################################################

group {
	#####################################################################
	# The Science-Focusing Stage (cc:foc)
	#####################################################################

	int $(top)eng:cc:focHallstep.CDSA = 2500;
	int $(top)eng:cc:focHallstep.CDSB = -30000;
	int $(top)eng:cc:focHallstep.CDSC = 0;

	# LOPR and HOPR must match values in cfg.tcl

	int $(top)eng:cc:focHallstep.LOPR = -30000;
	int $(top)eng:cc:focHallstep.HOPR = 5790;
	double $(top)eng:cc:focMotor.VELO = 1000;
	double $(top)eng:cc:focMotor.ACCL = 0.1;

	int $(top)eng:cc:focHallstep.DSLP = -2500;
	int $(top)eng:cc:focHallstep.DSLB = -1700;
	int $(top)eng:cc:focHallstep.BLSH = 25;
	int $(top)eng:cc:focHallstep.TOL = 0.150;

#
# Unfortunately, these two parameters are different when the system is cold.  
# They are set in warm/cc.pv and cold/cc.pv, instead of in this file.
#

	int $(top)eng:cc:focHallstep.DOFP = 0;
	int $(top)eng:cc:focHallstep.DOFB = 0;

	int $(top)eng:cc:focHallstep.DOF1 = -2;
	int $(top)eng:cc:focHallstep.WTHP = 70;
	int $(top)eng:cc:focHallstep.WTHB = 70;

	#####################################################################
	# Filter Wheel 1 (cc:filt1)
	#####################################################################

	int $(top)eng:cc:filt1Hallstep.CDSA = 13400;
	int $(top)eng:cc:filt1Hallstep.CDSB = -10600;
	int $(top)eng:cc:filt1Hallstep.CDSC = 0;

	int $(top)eng:cc:filt1Hallstep.LOPR = 0;
	int $(top)eng:cc:filt1Hallstep.HOPR = 288000;
	double $(top)eng:cc:filt1Motor.VELO = 3000;
	double $(top)eng:cc:filt1Motor.ACCL = 1.0;

	int $(top)eng:cc:filt1Hallstep.WTHP = 400;
	int $(top)eng:cc:filt1Hallstep.WTHB = 400;
	double $(top)eng:cc:filt1Hallstep.THRB = 2.0;
	int $(top)eng:cc:filt1Hallstep.DOF1 = -30;
	int $(top)eng:cc:filt1Hallstep.BLSH = 1000;
	double $(top)eng:cc:filt1Hallstep.TOL = 0.500;

	int $(top)eng:cc:filt1Hallstep.TOUT = 120;

	#####################################################################
	# Filter wheel 2 (cc:filt2)
	#####################################################################

	int $(top)eng:cc:filt2Hallstep.CDSA = 13400;
	int $(top)eng:cc:filt2Hallstep.CDSB = -10600;
	int $(top)eng:cc:filt2Hallstep.CDSC = 0;

	int $(top)eng:cc:filt2Hallstep.LOPR = 0;
	int $(top)eng:cc:filt2Hallstep.HOPR = 288000;
	double $(top)eng:cc:filt2Motor.VELO = 3000;
	double $(top)eng:cc:filt2Motor.ACCL = 1.0;

	int $(top)eng:cc:filt2Hallstep.WTHP = 400;
	int $(top)eng:cc:filt2Hallstep.WTHB = 400;
	double $(top)eng:cc:filt2Hallstep.THRB = 2.0;
	int $(top)eng:cc:filt2Hallstep.DOF1 = 5;
	int $(top)eng:cc:filt2Hallstep.BLSH = 1000;
	double $(top)eng:cc:filt2Hallstep.TOL = 0.500;

	int $(top)eng:cc:filt2Hallstep.TOUT = 120;

	#####################################################################
	# Filter Wheel 3 / Pupil Mask (cc:filt3)
	#####################################################################

	int $(top)eng:cc:filt3Hallstep.CDSA = 13400;
	int $(top)eng:cc:filt3Hallstep.CDSB = -10600;
	int $(top)eng:cc:filt3Hallstep.CDSC = 0;

	int $(top)eng:cc:filt3Hallstep.LOPR = 0;
	int $(top)eng:cc:filt3Hallstep.HOPR = 288000;
	double $(top)eng:cc:filt3Motor.VELO = 3000;
	double $(top)eng:cc:filt3Motor.ACCL = 1.0;

	int $(top)eng:cc:filt3Hallstep.WTHP = 400;
	int $(top)eng:cc:filt3Hallstep.WTHB = 400;
	double $(top)eng:cc:filt3Hallstep.THRB = 1.0;
	int $(top)eng:cc:filt3Hallstep.DOF1 = -24;
	int $(top)eng:cc:filt3Hallstep.BLSH = 1000;
	double $(top)eng:cc:filt3Hallstep.TOL = 0.500;

	int $(top)eng:cc:filt3Hallstep.TOUT = 120;

	#####################################################################
	# The Beam Splitter (cc:splt)
	#####################################################################

	int $(top)eng:cc:spltHallstep.CDSA = 4580;
	int $(top)eng:cc:spltHallstep.CDSB = -152154;
	int $(top)eng:cc:spltHallstep.CDSC = 0;

	int $(top)eng:cc:spltHallstep.LOPR = 0;
	double $(top)eng:cc:spltHallstep.HOPR = 626938.56;
	double $(top)eng:cc:spltMotor.VELO = 6000.0;
	double $(top)eng:cc:spltMotor.ACCL = 5.0;

	int $(top)eng:cc:spltHallstep.WTHP = 1000;
	int $(top)eng:cc:spltHallstep.WTHB = 1000;
	double $(top)eng:cc:spltHallstep.THRB = 1.8;
	int $(top)eng:cc:spltHallstep.DOF1 = -69;
	int $(top)eng:cc:spltHallstep.BLSH = 500;
	double $(top)eng:cc:spltHallstep.TOL = 0.300;

	int $(top)eng:cc:spltHallstep.TOUT = 180;

	#####################################################################
	# Steering Mirror 1 (ster1)
	#####################################################################

	int $(top)eng:cc:ster1Hallstep.CDSA = 6380;
	int $(top)eng:cc:ster1Hallstep.CDSB = -3906;
	int $(top)eng:cc:ster1Hallstep.CDSC = 0;

	int $(top)eng:cc:ster1Hallstep.LOPR = 0;
	int $(top)eng:cc:ster1Hallstep.HOPR = 41143;
	double $(top)eng:cc:ster1Motor.VELO = 1000;
	double $(top)eng:cc:ster1Motor.ACCL = 1.0;

	int $(top)eng:cc:ster1Hallstep.WTHP = 100;
	int $(top)eng:cc:ster1Hallstep.WTHB = 100;
	double $(top)eng:cc:ster1Hallstep.THRB = 2.0;
	int $(top)eng:cc:ster1Hallstep.BLSH = 1000;
	double $(top)eng:cc:ster1Hallstep.TOL = 0.300;

	int $(top)eng:cc:ster1Hallstep.TOUT = 60;

	#####################################################################
	# Steering Mirror 2 (cc:ster2)
	#####################################################################

	int $(top)eng:cc:ster2Hallstep.CDSA = 6380;
	int $(top)eng:cc:ster2Hallstep.CDSB = -3906;
	int $(top)eng:cc:ster2Hallstep.CDSC = 0;

	int $(top)eng:cc:ster2Hallstep.LOPR = 0;
	int $(top)eng:cc:ster2Hallstep.HOPR = 41143;
	double $(top)eng:cc:ster2Motor.VELO = 1000;
	double $(top)eng:cc:ster2Motor.ACCL = 1.0;

	int $(top)eng:cc:ster2Hallstep.WTHP = 100;
	int $(top)eng:cc:ster2Hallstep.WTHB = 100;
	double $(top)eng:cc:ster2Hallstep.THRB = 2.0;
	int $(top)eng:cc:ster2Hallstep.BLSH = 1000;
	double $(top)eng:cc:ster2Hallstep.TOL = 0.300;
	int $(top)eng:cc:ster2Hallstep.DOF1 = -2;

	int $(top)eng:cc:ster2Hallstep.TOUT = 60;

	#####################################################################
	# The Focal-Plane Mask (cc:fopl)
	#####################################################################

	int $(top)eng:cc:foplHallstep.CDSA = 2300;
	int $(top)eng:cc:foplHallstep.CDSB = -35414;
	int $(top)eng:cc:foplHallstep.CDSC = 0;

	int $(top)eng:cc:foplHallstep.LOPR = 0;
	int $(top)eng:cc:foplHallstep.HOPR = 452571;
	double $(top)eng:cc:foplMotor.VELO = 8000;
	double $(top)eng:cc:foplMotor.ACCL = 0.5;

 	int $(top)eng:cc:foplHallstep.WTHP = 500;
	int $(top)eng:cc:foplHallstep.WTHB = 500;
	double $(top)eng:cc:foplHallstep.THRB = 2.0;
	int $(top)eng:cc:foplHallstep.BLSH = 1000;
	double $(top)eng:cc:foplHallstep.TOL = 0.300;
	int $(top)eng:cc:foplHallstep.DOF1 = -42;

	int $(top)eng:cc:foplHallstep.TOUT = 120;

	#####################################################################
	# The Window Cover (cc:cov)
	#--------------------------------------------------------------------
	# The limits are rough and somewhat larger than the actual range
	# of travel, because this mechanism simply drives until
	# it hits a limit switch.
	#####################################################################

	int $(top)eng:cc:covHallstep.CDSA = 2100;
	int $(top)eng:cc:covHallstep.CDSB = 0;
	int $(top)eng:cc:covHallstep.CDSC = 0;

 	int $(top)eng:cc:covHallstep.LOPR = 0;
	int $(top)eng:cc:covHallstep.HOPR = 2100;
	int $(top)eng:cc:covHallstep.TOL = 0.001;
	double $(top)eng:cc:covMotor.VELO = 500;
	double $(top)eng:cc:covMotor.ACCL = 0.5;
	int $(top)eng:cc:covHallstep.BLSH = 200;

	int $(top)eng:cc:covHallstep.WTHP = 100;
	int $(top)eng:cc:covHallstep.WTHB = 100;
	double $(top)eng:cc:covHallstep.THRP = -1.0;
	double $(top)eng:cc:covHallstep.THRB = -1.0;

	#####################################################################
	# The Pupil Viewer (cc:puvw)
	#--------------------------------------------------------------------
	# Note: For binary mechanisms, the reference locations should
	# not be set to an intermediate location.
	#####################################################################

	int $(top)eng:cc:puvwHallstep.CDSA = -3140;
	int $(top)eng:cc:puvwHallstep.CDSB = 0;
	int $(top)eng:cc:puvwHallstep.CDSC = 0;

	int $(top)eng:cc:puvwHallstep.LOPR = -3140;
	int $(top)eng:cc:puvwHallstep.HOPR = 0;
	double $(top)eng:cc:puvwMotor.VELO = 3000;
	double $(top)eng:cc:puvwMotor.ACCL = 0.5;

	int $(top)eng:cc:puvwHallstep.WTHP = 100;
	int $(top)eng:cc:puvwHallstep.WTHB = 100;
	double $(top)eng:cc:puvwHallstep.THRP = 1.3;
	double $(top)eng:cc:puvwHallstep.THRB = 1.3;
	double $(top)eng:cc:puvwHallstep.TOL = 0.500;

	#####################################################################
	# Window Pressure
	#####################################################################

	long $(top)eng:cc:bioWinCover.VAL = 1;
	long $(top)eng:cc:bioWinPress.VAL = 1;

	#####################################################################
	# The Gemini Interlock System.
	#####################################################################

	long $(top)eng:cc:bioSetGISEvent.VAL = 1;
	long $(top)eng:cc:bioSetGISNEvent.VAL = 0;
};

#####################################################################
# After setting parameters, initialize the system.
#####################################################################

group {
	int $(top)eng:cc:focReset.VAL = 1;
	int $(top)eng:cc:focOp.VAL = 9;

	int $(top)eng:cc:filt1Reset.VAL = 1;
	int $(top)eng:cc:filt1Op.VAL = 9;

	int $(top)eng:cc:filt2Reset.VAL = 1;
	int $(top)eng:cc:filt2Op.VAL = 9;

	int $(top)eng:cc:filt3Reset.VAL = 1;
	int $(top)eng:cc:filt3Op.VAL = 9;

	int $(top)eng:cc:spltReset.VAL = 1;
	int $(top)eng:cc:spltOp.VAL = 9;

	int $(top)eng:cc:ster1Reset.VAL = 1;
	int $(top)eng:cc:ster1Op.VAL = 9;

	int $(top)eng:cc:ster2Reset.VAL = 1;
	int $(top)eng:cc:ster2Op.VAL = 9;

	int $(top)eng:cc:foplReset.VAL = 1;
	int $(top)eng:cc:foplOp.VAL = 9;

	int $(top)eng:cc:covReset.VAL = 1;
	int $(top)eng:cc:covOp.VAL = 9;

	int $(top)eng:cc:puvwReset.VAL = 1;
	int $(top)eng:cc:puvwOp.VAL = 9;
}

# $Id: wfs.pv,v 1.2 2009/05/27 19:34:27 fkraemer Exp $

group {
	string $(top)eng:wfs:filtSubdir = "sim";
	string $(top)eng:wfs:focSubdir = "sim";
	string $(top)eng:wfs:prbxSubdir = "sim";
	string $(top)eng:wfs:prbySubdir = "sim";
};

#############################################################################
# These command set the lutin and lutout records to look at the appropriate
# configuration files in the appropriate directory.
#############################################################################

#
# First, disable the record that is connected to the output of the
# Select record.   Unfortunately, loading a new Lookup table causes a
# value to be output, which is an undesired side effect.  Disabling
# the next record to be processed protects against that.
#

group {
	int $(top)eng:wfs:filtCmdVMove.DISV = 0;
	int $(top)eng:wfs:focCmdVMove.DISV = 0;
	int $(top)eng:wfs:prbxCmdVMove.DISV = 0;
	int $(top)eng:wfs:prbyCmdVMove.DISV = 0;
};

group {
	int $(top)eng:wfs:filtSelect.FDIR = "ENG/data/sim";
	int $(top)eng:wfs:focSelect.FDIR = "ENG/data/sim";
	int $(top)eng:wfs:prbxSelect.FDIR = "ENG/data/sim";
	int $(top)eng:wfs:prbySelect.FDIR = "ENG/data/sim";

	int $(top)eng:wfs:filtInvSelect.FDIR = "ENG/data/sim";
	int $(top)eng:wfs:focInvSelect.FDIR = "ENG/data/sim";
	int $(top)eng:wfs:prbxInvSelect.FDIR = "ENG/data/sim";
	int $(top)eng:wfs:prbyInvSelect.FDIR = "ENG/data/sim";
};

group {
	int $(top)eng:wfs:filtSelect.LOAD = 1;
	int $(top)eng:wfs:focSelect.LOAD = 1;
	int $(top)eng:wfs:prbxSelect.LOAD = 1;
	int $(top)eng:wfs:prbySelect.LOAD = 1;

	int $(top)eng:wfs:filtInvSelect.LOAD = 1;
	int $(top)eng:wfs:focInvSelect.LOAD = 1;
	int $(top)eng:wfs:prbxInvSelect.LOAD = 1;
	int $(top)eng:wfs:prbyInvSelect.LOAD = 1;
};

group {
	int $(top)eng:wfs:filtCmdVMove.DISV = 1;
	int $(top)eng:wfs:focCmdVMove.DISV = 1;
	int $(top)eng:wfs:prbxCmdVMove.DISV = 1;
	int $(top)eng:wfs:prbyCmdVMove.DISV = 1;
};

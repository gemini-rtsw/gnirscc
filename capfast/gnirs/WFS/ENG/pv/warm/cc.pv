group {
	int $(top)eng:cc:covCmdVMove.DISV = 1;
	int $(top)eng:cc:filt1CmdVMove.DISV = 1;
	int $(top)eng:cc:filt2CmdVMove.DISV = 1;
	int $(top)eng:cc:filt3CmdVMove.DISV = 1;
	int $(top)eng:cc:focCmdVMove.DISV = 1;
	int $(top)eng:cc:foplCmdVMove.DISV = 1;
	int $(top)eng:cc:puvwCmdVMove.DISV = 1;
	int $(top)eng:cc:spltCmdVMove.DISV = 1;

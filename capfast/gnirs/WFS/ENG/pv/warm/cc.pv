#############################################################################
# In an ideal world, these would be temperature-independant constants.
# Unfortunately, they are not.
#############################################################################

group {
	int $(top)eng:cc:focHallstep.DOFP = 1200;
	int $(top)eng:cc:focHallstep.DOFB = 870;
}

#############################################################################
# Set the subdirectory name for configuration files
#############################################################################

group {
	string $(top)eng:cc:covSubdir = "warm";
	string $(top)eng:cc:filt1Subdir = "warm";
	string $(top)eng:cc:filt2Subdir = "warm";
	string $(top)eng:cc:filt3Subdir = "warm";
	string $(top)eng:cc:focSubdir = "warm";
	string $(top)eng:cc:foplSubdir = "warm";
	string $(top)eng:cc:puvwSubdir = "warm";
	string $(top)eng:cc:spltSubdir = "warm";
	string $(top)eng:cc:ster1Subdir = "warm";
	string $(top)eng:cc:ster2Subdir = "warm";
};

#############################################################################
# These command set the lutin and lutout records to look at the appropriate
# configuration files in the appropriate directory.
#############################################################################

#
# First, disable the record that is connected to the output of the
# Select record.   Unfortunately, loading a new Lookup table causes a
# value to be output, which is an undesired side effect.  Disabling
# the next record to be processed protects against that.
#

group {
	int $(top)eng:cc:covCmdVMove.DISV = 0;
	int $(top)eng:cc:filt1CmdVMove.DISV = 0;
	int $(top)eng:cc:filt2CmdVMove.DISV = 0;
	int $(top)eng:cc:filt3CmdVMove.DISV = 0;
	int $(top)eng:cc:focCmdVMove.DISV = 0;
	int $(top)eng:cc:foplCmdVMove.DISV = 0;
	int $(top)eng:cc:puvwCmdVMove.DISV = 0;
	int $(top)eng:cc:spltCmdVMove.DISV = 0;
	int $(top)eng:cc:ster1CmdVMove.DISV = 0;
	int $(top)eng:cc:ster2CmdVMove.DISV = 0;
};

group {
	int $(top)eng:cc:covSelect.FDIR = "ENG/data/warm";
	int $(top)eng:cc:filt1Select.FDIR = "ENG/data/warm";
	int $(top)eng:cc:filt2Select.FDIR = "ENG/data/warm";
	int $(top)eng:cc:filt3Select.FDIR = "ENG/data/warm";
	int $(top)eng:cc:focSelect.FDIR = "ENG/data/warm";
	int $(top)eng:cc:foplSelect.FDIR = "ENG/data/warm";
	int $(top)eng:cc:puvwSelect.FDIR = "ENG/data/warm";
	int $(top)eng:cc:spltSelect.FDIR = "ENG/data/warm";
	int $(top)eng:cc:ster1Select.FDIR = "ENG/data/warm";
	int $(top)eng:cc:ster2Select.FDIR = "ENG/data/warm";

	int $(top)eng:cc:covInvSelect.FDIR = "ENG/data/warm";
	int $(top)eng:cc:filt1InvSelect.FDIR = "ENG/data/warm";
	int $(top)eng:cc:filt2InvSelect.FDIR = "ENG/data/warm";
	int $(top)eng:cc:filt3InvSelect.FDIR = "ENG/data/warm";
	int $(top)eng:cc:focInvSelect.FDIR = "ENG/data/warm";
	int $(top)eng:cc:foplInvSelect.FDIR = "ENG/data/warm";
	int $(top)eng:cc:puvwInvSelect.FDIR = "ENG/data/warm";
	int $(top)eng:cc:spltInvSelect.FDIR = "ENG/data/warm";
	int $(top)eng:cc:ster1InvSelect.FDIR = "ENG/data/warm";
	int $(top)eng:cc:ster2InvSelect.FDIR = "ENG/data/warm";
};

group {
	int $(top)eng:cc:covSelect.LOAD = 1;
	int $(top)eng:cc:filt1Select.LOAD = 1;
	int $(top)eng:cc:filt2Select.LOAD = 1;
	int $(top)eng:cc:filt3Select.LOAD = 1;
	int $(top)eng:cc:focSelect.LOAD = 1;
	int $(top)eng:cc:foplSelect.LOAD = 1;
	int $(top)eng:cc:puvwSelect.LOAD = 1;
	int $(top)eng:cc:spltSelect.LOAD = 1;
	int $(top)eng:cc:ster1Select.LOAD = 1;
	int $(top)eng:cc:ster2Select.LOAD = 1;

	int $(top)eng:cc:covInvSelect.LOAD = 1;
	int $(top)eng:cc:filt1InvSelect.LOAD = 1;
	int $(top)eng:cc:filt2InvSelect.LOAD = 1;
	int $(top)eng:cc:filt3InvSelect.LOAD = 1;
	int $(top)eng:cc:focInvSelect.LOAD = 1;
	int $(top)eng:cc:foplInvSelect.LOAD = 1;
	int $(top)eng:cc:puvwInvSelect.LOAD = 1;
	int $(top)eng:cc:spltInvSelect.LOAD = 1;
	int $(top)eng:cc:ster1InvSelect.LOAD = 1;
	int $(top)eng:cc:ster2InvSelect.LOAD = 1;

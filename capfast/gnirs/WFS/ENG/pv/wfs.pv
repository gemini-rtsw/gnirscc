# $Id: wfs.pv,v 1.3 2010/04/14 01:55:29 mrippa Exp $

###########################################################################
# Warning: When setting CDSA, CDSB, CDSC, insure that CDSC is a safe
# location to leave the mechanism in (usually 0), and that the move
# from CDSB to CDSC is in the correct direction for backlash removal
# (for all NIRI mechanisms, this is the positive direction.)
#
# The meaning of these parameters is defined in the NIRI implementation
# notes and record reference manual (niri_hty_011.fm).
###########################################################################

group {
	#######################################################################
	# The WFS-Focusing Stage (wfs:foc)
	#######################################################################

	int $(top)eng:wfs:focHallstep.CDSA = 2000;
	int $(top)eng:wfs:focHallstep.CDSB = -2000;
	int $(top)eng:wfs:focHallstep.CDSC = 0;

	# LOPR and HOPR must match values in cfg.tcl

	int $(top)eng:wfs:focHallstep.LOPR = -3300;
	int $(top)eng:wfs:focHallstep.HOPR = 3700;
	double $(top)eng:wfs:focMotor.VELO = 400;
	double $(top)eng:wfs:focMotor.ACCL = 0.1;
	double $(top)eng:wfs:focHallstep.TOL = 0.300;

	int $(top)eng:wfs:focHallstep.DSLP = -1200;
	int $(top)eng:wfs:focHallstep.DSLB = -1400;

#
# Unfortunately, these two parameters are different when the system is cold.
# They are set in warm/wfs.pv and cold/wfs.pv, instead of in this file.
#

	int $(top)eng:wfs:focHallstep.DOFP = 0;
	int $(top)eng:wfs:focHallstep.DOFB = 0;

	int $(top)eng:wfs:focHallstep.BLSH = 25;
	int $(top)eng:wfs:focHallstep.DOF1 = -3;
	int $(top)eng:wfs:focHallstep.WTHP = 100;
	int $(top)eng:wfs:focHallstep.WTHB = 100;

	int $(top)eng:wfs:focUncert.VAL = 20;

	#######################################################################
	# The Gimbal X-Axis (wfs:prbx)
	#######################################################################

	int $(top)eng:wfs:prbxHallstep.CDSA = 100000;
	int $(top)eng:wfs:prbxHallstep.CDSB = -100000;
	int $(top)eng:wfs:prbxHallstep.CDSC = 0;

	# Physical limits: -216000 -> 201152
	# LOPR and HOPR must match values in cfg.tcl

	int $(top)eng:wfs:prbxHallstep.LOPR = -200000;
	int $(top)eng:wfs:prbxHallstep.HOPR = 200000;
	double $(top)eng:wfs:prbxMotor.VELO = 3500;
	double $(top)eng:wfs:prbxMotor.ACCL = 0.5;

	int $(top)eng:wfs:prbxHallstep.DOFP = -4242;
	int $(top)eng:wfs:prbxHallstep.DOFB = -24281;
	int $(top)eng:wfs:prbxHallstep.BLSH = 1000;
	int $(top)eng:wfs:prbxHallstep.DOF1 = 15;
	int $(top)eng:wfs:prbxHallstep.WTHP = 400;
	int $(top)eng:wfs:prbxHallstep.WTHB = 400;
	int $(top)eng:wfs:prbxHallstep.ZERO = 0;
	double $(top)eng:wfs:prbxHallstep.TOL = 0.300;

	int $(top)eng:wfs:prbxHallstep.NOTM = 1;

	int $(top)eng:wfs:prbxUncert.VAL = 20;

	#######################################################################
	# The Gimbal Y-Axis (wfs:prby)
	#######################################################################

	int $(top)eng:wfs:prbyHallstep.CDSA = 100000;
	int $(top)eng:wfs:prbyHallstep.CDSB = -100000;
	int $(top)eng:wfs:prbyHallstep.CDSC = 0;

	# Physical limits: -216000 -> 270000
	# LOPR and HOPR must match values in cfg.tcl

	int $(top)eng:wfs:prbyHallstep.LOPR = -190000;
	int $(top)eng:wfs:prbyHallstep.HOPR = 190000;
	double $(top)eng:wfs:prbyMotor.VELO = 3500;
	double $(top)eng:wfs:prbyMotor.ACCL = 0.5;

	int $(top)eng:wfs:prbyHallstep.DOFP = 22820;
	int $(top)eng:wfs:prbyHallstep.DOFB = 5322;
	int $(top)eng:wfs:prbyHallstep.BLSH = 1000;
	int $(top)eng:wfs:prbyHallstep.DOF1 = -25;
	int $(top)eng:wfs:prbyHallstep.WTHP = 400;
	int $(top)eng:wfs:prbyHallstep.WTHB = 400;
	int $(top)eng:wfs:prbyHallstep.ZERO = 0;
	double $(top)eng:wfs:prbyHallstep.TOL = 0.300;

	int $(top)eng:wfs:prbyHallstep.NOTM = 1;

	int $(top)eng:wfs:prbyUncert.VAL = 20;

	#######################################################################
	# The Filter Wheel (wfs:filt).
	#######################################################################

	int $(top)eng:wfs:filtHallstep.CDSA = 6643;
	int $(top)eng:wfs:filtHallstep.CDSB = -2786;
	int $(top)eng:wfs:filtHallstep.CDSC = 0;

	int $(top)eng:wfs:filtHallstep.LOPR = 0;
	int $(top)eng:wfs:filtHallstep.HOPR = 113143;
	double $(top)eng:wfs:filtMotor.VELO = 10000;
	double $(top)eng:wfs:filtMotor.ACCL = 1.0;
	int $(top)eng:wfs:filtHallstep.BLSH = 1000;
	int $(top)eng:wfs:filtHallstep.WTHP = 1500;
	int $(top)eng:wfs:filtHallstep.WTHB = 1500;
	int $(top)eng:wfs:filtHallstep.DOF1 = -21;
	double $(top)eng:wfs:filtHallstep.TOL = 0.300;

	double $(top)eng:wfs:filtHallstep.THRB = 1.0;

	int $(top)eng:wfs:filtHallstep.TOUT = 30;
};

#####################################################################
# After setting parameters, initialize the system.
#####################################################################

group {
	int $(top)eng:wfs:focReset.VAL = 1;
	int $(top)eng:wfs:focOp.VAL = 9;

	int $(top)eng:wfs:prbxReset.VAL = 1;
	int $(top)eng:wfs:prbxOp.VAL = 9;

	int $(top)eng:wfs:prbyReset.VAL = 1;
	int $(top)eng:wfs:prbyOp.VAL = 9;

	int $(top)eng:wfs:filtReset.VAL = 1;
	int $(top)eng:wfs:filtOp.VAL = 9;
};

program engModeSt("top=xxxx:wfs:, sadtop=xxxx:wfs:, eng=xxxx:eng:wfs:, mech=filt, prefix=Beam")

/*
 * History:
 *INDENT-OFF*
 *
 * $Log: engModeSt.stpp,v $
 * Revision 1.2  2009/05/27 19:34:57  fkraemer
 * fkraemer - copied my complete working dir over trunk
 *
 * Revision 1.3  1999/11/14 02:05:43  yamada
 * Reformatted logs.
 *
 *
 *INDENT-ON*
 */

/* The following option is needed to make the code reentrant */

option +r;

%%#include <car.h>

%%#include <cicsConst.h>

int car;
assign car to "{top}{mech}C";
monitor car;

long idle;
assign idle to "{sadtop}{mech}{prefix}Idle";

string out;
assign out to "{sadtop}{mech}{prefix}Flag";

string name; 
assign name to "{eng}{mech}InvSelect";
monitor name;

evflag nameFlag;
sync name nameFlag;

ss engMode_ss {
	state init1 {
		/*
		 * Begin by assuming the worst case, the mechanism is moving
		 * at an invalid position.  It is likely that the system
		 * will immediately make the transition from busy to idle and
		 * will set the current position.
		 */

		when () {
			efClear(nameFlag);
			strcpy(out, "INVALID");
			pvPut(out);

			idle = EPICS_FALSE;
			pvPut(idle);
		} state busy
	}

	state busy {
		when (car == CAR_IDLE) {
			idle = EPICS_TRUE;
			pvPut(idle);
		} state idle
	}

	state idle {
		when (car != CAR_IDLE) {
			idle = EPICS_FALSE;
			pvPut(idle);
		} state busy

		when (efTestAndClear(nameFlag)) {
			strcpy(out, name);
			pvPut(out);
		} state idle
	}
}

[symbol2]
bbox -384 64 384 256
port 352 96 100 1024 CFLNK symbol 2 384 96 0
port 352 128 100 1024 CVAL symbol 3 384 128 0
port -352 96 100 1024 MESS symbol 3 -384 96 0
port -352 128 100 1024 VAL symbol 3 -384 128 0
port -352 160 100 1024 CLID symbol 3 -384 160 0
port -352 192 100 1024 DIR symbol 3 -384 192 0
uniq 5
[tools]
[attributes]
p -304 192 100 768 1 set0:mech $(mech)
p -304 160 100 768 1 set1:mech1 $(mech1)
p -304 128 100 768 1 set2:mech2 $(mech2)
p -304 96 100 768 1 set3:mech3 $(mech3)
p -304 64 100 768 1 set4:mech4 $(mech4)
p -64 192 100 768 1 set5:desc $(desc)
p -64 160 100 768 1 set6:desc1 $(desc1)
p -64 128 100 768 1 set7:desc2 $(desc2)
p -64 96 100 768 1 set8:desc3 $(desc3)
p -64 64 100 768 1 set9:desc4 $(desc4)
[layers]
<symbol>
l 100 3 0 -176 224 lockCad
l 75 5 0 272 224 Interlock System
v 1 -192 224
-192 256
288 256
_
v 0 -288 224
-288 256
-384 256
-384 64
384 64
384 256
288 256
288 224
-288 224
_
[comments]

[symbol2]
bbox -1024 64 -256 256
port -272 160 100 2048 FLNK symbol 2 -256 160 0
port -272 192 100 2048 OCID symbol 3 -256 192 0
port -272 224 100 2048 OVAL symbol 3 -256 224 0
uniq 6
[tools]
[attributes]
p -944 192 100 768 1 set0:mech $(mech)
p -944 160 100 768 1 set1:mech1 $(mech1)
p -944 128 100 768 1 set2:mech2 $(mech2)
p -944 96 100 768 1 set3:mech3 $(mech3)
p -944 64 100 768 1 set4:mech4 $(mech4)
p -704 192 100 768 1 set5:desc $(desc)
p -704 160 100 768 1 set6:desc1 $(desc1)
p -704 128 100 768 1 set7:desc2 $(desc2)
p -704 96 100 768 1 set8:desc3 $(desc3)
p -704 64 100 768 1 set9:desc4 $(desc4)
[layers]
<symbol>
l 75 5 0 -368 224 lock CAR Record
l 100 3 0 -816 224 lockCar
v 1 -352 256
-832 256
-832 224
_
v 0 -1024 256
-1024 64
-256 64
-256 256
-352 256
-352 224
-928 224
-928 256
-1024 256
_
[comments]

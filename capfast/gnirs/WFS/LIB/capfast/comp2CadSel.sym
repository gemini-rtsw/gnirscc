p -32 64 100 768 0 setoo:outo 0
p -32 32 100 768 0 setop:outp 0
p -32 0 100 768 0 setoq:outq 0
p -32 -32 100 768 0 setor:outr 0
p -32 -64 100 768 0 setos:outs 0
p -32 -96 100 768 0 setot:outt 0

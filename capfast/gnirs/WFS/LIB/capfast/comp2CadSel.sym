[symbol2]
bbox -416 160 352 352
port -400 192 100 1536 MESS symbol 3 -416 192 0
port -400 224 100 1536 VAL symbol 3 -416 224 0
port -400 256 100 1536 CLID symbol 3 -416 256 0
port -400 288 100 1536 DIR symbol 3 -416 288 0

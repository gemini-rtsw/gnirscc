p -944 128 100 768 1 set2:mech1 $(mech1)
p -944 96 100 768 1 set3:mech2 $(mech2)
p -944 64 100 768 1 set4:mech3 $(mech3)
p -672 192 100 768 1 set5:desc $(desc)
p -672 160 100 768 1 set6:desc12 $(desc12)
p -672 128 100 768 1 set7:desc1 $(desc1)
p -672 96 100 768 1 set8:desc2 $(desc2)
p -672 64 100 768 1 set9:desc3 $(desc3)
[layers]
<symbol>
l 100 3 0 -816 224 folCar
l 75 5 0 -368 224 Follow CAR Records
v 0 -928 224
-928 256
-1024 256
-1024 64
-256 64
-256 256
-352 256
-352 224
-928 224

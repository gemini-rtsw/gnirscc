#! /bin/sh

########################################################################
# Sets up the NIRS/GNIRS/CICS WFS EPICS UAE application directory after
# unpacking.
#
# Invocation:
#   source nirsSetup
#
# Steven M Beard, Hubert Yamada
# 28 May 1997: NIRS version.
########################################################################

########################################################################
# Begin with a few sanity checks.
########################################################################

#
# Check that the EPICS startup script has been sourced.
#

if [ ${EPICS-undefined} = undefined ]; then
   echo "EPICS environment variables have not been defined. Please source" 
   echo "your local EPICS setup script (see \"nirsLogin_SAMPLE\" for an"
   echo "example)."
   exit 1
fi

#
# Check that the local nirsLogin script has been sourced.
#

if [ ${NIRS_WFSWFSDIR-undefined} = undefined ]; then
    echo "*** ERROR: NIRS_WFSWFSDIR environment variable not defined."
    echo "*** Please set up NIRS from the top level 'nirsSetup' script."
	exit 1
fi

########################################################################
# Make a few links.
########################################################################

#
# Make a convenience link to this directory (makes it easier to
# work with pvload and lutin/lutout records).
#

rm -f $NIRS_WFSWFSDIR/WFS
ln -s . $NIRS_WFSWFSDIR/WFS

#
# Make a link to ENG (needed for pvload and lutin and lutout records)
#

rm -f ENG
ln -s $NIRS_ENGDIR $NIRS_WFSWFSDIR/ENG
rm -f LIB
ln -s $NIRS_LIBDIR $NIRS_WFSWFSDIR/LIB

########################################################################
# From this point on, assume that we are working in $NIRS_WFSDIR
########################################################################

cd $NIRS_WFSWFSDIR

########################################################################
# Now set up the directory
########################################################################

#
# If these files exist, then they are not overwritten.  Delete them,
# to be safe.
#	
	rm -f dl/gmColors.adl
	ln -s ../../../dl/gmColors.adl dl/gmColors.adl

if [ -f config/CONFIG.Defs ]; then
	echo "* Removing old CONFIG.Defs"
	rm config/CONFIG.Defs
fi

if [ -f startup/local.vws ]; then
	echo "* Removing old local.vws."
	rm startup/local.vws
fi

if [ -f startup/resource.def ]; then
	echo "* Removing old startup/resource.def."
	rm startup/resource.def
fi

#
# Now set up the directory.
#

applSetup -install $NIRS_WFSWFSDIR -targets $NIRS_TARGETS \
	-depends $NIRS_LIBDIR -subdir_file Makefile.subdirs \
	-I capfast -I config -I dl -I pv -I src -I startup \
	-P ${NIRS_WFSWFSINSTPATH} 

#edit startup/UAE.dist
ed startup/UAE.dist << eof >/dev/null
/^FILES2
d
/^FILES4
d
/^FILES5
d
/^(\${FILES2})
.,+2d
/^(\${FILES4})
.,+2d
/^(\${FILES5})
.,+1d
.
w
q
eof

###########################################################################
# The configuration procedure overwrites my .cvsignore files.  Fix them.
###########################################################################

#
# Define a function to add a pattern to a cvs file.
#
# Syntax: addcvs CVSIGNOREFILE PATTERN
#

addcvs () {
	cvsignore=$1
	pattern=$2

	if [ "`grep -c $pattern $cvsignore`" -eq 0 ]; then
		echo "* Adding \"$pattern\" to $cvsignore".
		echo "$pattern" >> $cvsignore
	fi
}

addcvs capfast/.cvsignore nirsWfsTop.sch
addcvs capfast/.cvsignore nirsWfsSadTop.sch
addcvs startup/.cvsignore UAE.dist
addcvs startup/.cvsignore UAE.dist.OLD
addcvs startup/.cvsignore resource.def
addcvs .cvsignore config.par

###########################################################################
# Generate configuration files.
###########################################################################

echo "* Generating config.par."
cat << _EOF_ > config.par
##########################################################################
# This file was automatically generated by `whoami`@`hostname`
# using nirsSetup on:
#     `date`.
#
# Do not edit this file by hand, because it will be destroyed the next
# time that nirsSetup is run.
##########################################################################
	agprefix=${NIRS_AGPREFIX}
	astlibdir=${NIRS_ASTLIBDIR}
	dcprefix=${NIRS_DCPREFIX}
	dcsadprefix=${NIRS_DCSADPREFIX}
	engdir=${NIRS_ENGDIR}
	libdir=${NIRS_LIBDIR}
	name=${NIRS_NAME}
	prefix=${NIRS_WFSPREFIX}
	sadprefix=${NIRS_WFSSADPREFIX}
	slalibdir=${NIRS_SLALIBDIR}
	timelibdir=${NIRS_TIMELIBDIR}
	usevxtime=${NIRS_USEVXTIME}
_EOF_

########################################################################
# Set up the capfast directory.
########################################################################

cd $NIRS_WFSWFSDIR/capfast

#echo "* Making links in capfast directory."
./makeLinks

echo "* Generating top-level capfast diagrams."
./genTop templateTop.sch *Set.sch

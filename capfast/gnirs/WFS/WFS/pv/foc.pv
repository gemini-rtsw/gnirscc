# $Id: foc.pv,v 1.2 2009/05/27 19:35:00 fkraemer Exp $

group {
	#
	# Strings loaded by pvload into the WFS focus menu record.
	#

	string $(top)focSelMenu.ZRST = "Neutral";
	string $(top)focSelMenu.ONST = "Minimum";
	string $(top)focSelMenu.TWST = "Maximum";

	#
	# Scale and offset values loaded by pvload for the WFS focus mechanism,
	# 0.152 micron / ministep.
	#

	float $(top)focScale.VAL = 6579;
	long $(top)focOffset.VAL = 0;
	string $(sadtop)focUnits.VAL = "mm";

	#
	# Values that correspond to the park position, maximum of 4.  (Set unused
	# positions to "park".  Note:  Alternate names for the home position are
	# defined in ENG/pv/cfg.tcl and the ENG/pv/*/*.lut (generated using
	# ENG/pv/cfg.tcl).
	#

	string $(sadtop)focParkSub.C = "park";
	string $(sadtop)focParkSub.D = "home";
	string $(sadtop)focParkSub.E = "pos00";
	string $(sadtop)focParkSub.F = "park";

	#
	# Respect limits.
	#

	long $(sadtop)focEngCyclic = 1;

	#
	# How large should the positioning error be before making a correction
	# (when following), in mm.  This value is set so large that a
	# correction will never be made, because it shouldn't be necessary
	# to adjust the focus dynamically.
	#

	double $(top)focAgSetThresh = 1000;

	#
	# Initialize input strings to sane values.
	#
					
	double $(top)focMove.A = 0;
	double $(top)focEngMove.A = 0;
}

# $Id: sys1.pv,v 1.2 2009/05/27 19:35:01 fkraemer Exp $

#
# Initialisation of system parameters by pvload.
# This file to be executed before setting parameters.
#

#
# Make the initC CAR record go BUSY (CAR_BUSY = 2)
#

group {
	long $(top)initC.IVAL = 2;
}

group {
   string $(sadtop)state.VAL  = "INITIALISING";
   string $(sadtop)health.VAL = "GOOD";
   string $(sadtop)name.VAL   = "NIRI WFS";
}

# $Id: sys2.pv,v 1.2 2009/05/27 19:35:02 fkraemer Exp $

#
# Initialisation of system parameters by pvload.
# This file to be executed after setting parameters.
#

#
# Send a CLEAR directive to the top level APPLY record to clear
# all marked CAD records.
#

group {
	string $(top)apply.DIR = "CLEAR";
}

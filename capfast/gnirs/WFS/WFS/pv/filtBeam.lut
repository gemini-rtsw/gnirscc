# $Id: filtBeam.lut,v 1.2 2009/05/27 19:34:59 fkraemer Exp $

#
# This is used to calculate wfsBeam.  If the value of the third column
# is zero, then that filter position lets light pass through.  If it
# is 1 then it does not.  Note that 'park' and 'home' may actually
# be valid filter positions, which let light through; in this case
# the filter position takes priority.
#

pos00   1 0 0 0
pos01   1 0 0 0
pos02   1 0 0 0
pos03   1 0 0 0
pos04   1 0 0 0
pos05   1 0 0 0
pos06   1 0 0 0
pos07   1 0 0 0
pos08   1 0 0 0
pos09   1 0 0 0
pos10   1 0 0 0
pos11   1 0 0 0
home    1 1 0 0
park    1 1 0 0
INVALID 1 1 0 0

#
# Named positions for the NIRI focusing stage.
#
# List the most common name for a position first, followed by alternate
# names.
#

# name	nval	steps	lowtol	hightol

Neutral 1   pos00   0   0
Minimum 1   pos01   0   0
Maximum 1   pos02   0   0

#
# Don't touch these
#

pos00	1	pos00	0	0
pos01	1	pos01	0	0
pos02	1	pos02	0	0

datum   1   home    0   0
home    1   home    0   0

park    1   park    0   0

#
# For this mechanism, an INVALID position is not a problem.
#

Undefined  1       INVALID  0         0

#+
# FILENAME
# --------
# startup.vws
#
# PURPOSE
# -------
# VxWorks startup script to load and execute system (iocCore) software.
# This version of the startup loads the Instrument Sequencer,
# Components Controller and Detector Controller components of the
# Gemini Near Infared Imager (NIRI) system together one one IOC.
#
# P R O T O T Y P E   N I R I   H A R D W A R E
#
# REQUIREMENTS
# ------------
# Assumes that the VxWorks boot parameters are set to execute this file.
# Assumes EPICS 3.12.2Gem4 is available.
#
# INVOCATION
# ----------
# Executed automatically when IOC rebooted.
#
# AUTHORS
# -------
# Steven Beard  (smb@roe.ac.uk) -- Original version
# Hubert Yamada (yamada@newton.ifa.hawaii.edu) -- NIRI version
#-

# cd to application install directory (beware automounter problems)
cd "$(install)"
pwd

# Execute the file containing site-specific information such as the default
# router and local vxWorks security password file.

< $(version)/bin/$(arch)/local

# Make delete key work for backspace
tyBackspaceSet 0177

# Load EPICS core and record stuff
ld < $(epics)/base/bin/$(arch)/iocCore
ld < $(epics)/base/bin/$(arch)/drvSup
ld < $(epics)/base/bin/$(arch)/recSup
ld < $(epics)/base/bin/$(arch)/devSup

# Load EPICS extensions
ld < $(epics)/extensions/bin/$(arch)/pvload

# If using state programs, load the sequencer
ld < $(epics)/base/bin/$(arch)/seq

# Load any application records, device support or drivers here,
# or code for subroutine records

# Load other Gemini libraries (SLALIB, TIMELIB, ASTLIB) here.

ld < @(slalibdir)/bin/$(arch)/slalib
ld < @(timelibdir)/bin/$(arch)/timelib
ld < @(timelibdir)/bin/$(arch)/timeSeq
ld < @(astlibdir)/bin/$(arch)/astlib

# NIRI/OIWFS driver, device and record support
ld < @(engdir)/bin/$(arch)/eng.o

# CICS utility libraries
ld < @(libdir)/bin/$(arch)/cics.o
ld < @(libdir)/bin/$(arch)/sys.o
ld < @(libdir)/bin/$(arch)/comp.o
ld < @(libdir)/bin/$(arch)/eng.o

# GNAAC Detector Controller interface

ld < $(version)/DC/bin/$(arch)/dc.o

# WFS-specific software
ld < @(wfsdir)/bin/$(arch)/wfs.o

# CICS Instrument Sequencer software 
ld < @(isdir)/bin/$(arch)/is.o

# Configure software
< @(engdir)/bin/$(arch)/drvConf
#< @(engdir)/bin/$(arch)/drvSimConf

gnaacSetTop("@(dcprefix)dc:",0)
gnaacSetTop("@(prefix)",1)

# Configure the Bancomm driver (read documentation)
# BCconfigure 1, 0, 200, 2, 25

# Configure the Timestamp system, 1=Master IOC
TSconfigure 1, 0, 0, 0, 0, 0

#
# Use VxWorks time (same as Unix time) instead of Bancomm / timebus?
# (0 = Yes, 1 = No )
#

compUseVxTime=@(usevxtime)

#
# Set up Bancomm hardware / simulation
# (0 = Bancomm connected to time bus, 1 = Bancomm not connected or not present)
#

timeClockInit(0,@(usebancomm),60,1,0)
TSconfigure 1,0,0,0,0,250,1

# Load one or more ASCII databases here
dbLoad "@(engdir)/data/$(dctsdr).dctsdr"

# Low-level databases
dbLoadRecords "@(engdir)/data/engTop.db"

dbLoadRecords "@(engdir)/data/ccTop.db"
#dbLoadRecords "@(engdir)/data/ccSimTop.db"

dbLoadRecords "@(engdir)/data/wfsTop.db"
#dbLoadRecords "@(engdir)/data/wfsSimTop.db"

dbLoadRecords "@(engdir)/data/tmpTop.db"
#dbLoadRecords "@(engdir)/data/tmpSimTop.db"

# CICS Instrument Sequencer database
dbLoadRecords "@(isdir)/data/niriTop.db"
dbLoadRecords "@(isdir)/data/niriSadTop.db"

# NIRI/CICS Components Controller database
dbLoadRecords "@(ccdir)/data/niriCcTop.db"
dbLoadRecords "@(ccdir)/data/niriCcSadTop.db"

# NIRI/CICS On Instrument Wavefront Sensor database
dbLoadRecords "@(wfsdir)/data/niriWfsTop.db"
dbLoadRecords "@(wfsdir)/data/niriWfsSadTop.db"

# This turns off logging
# iocLogDisable=1

iocInit "$(version)/data/resource.def"

# Initialise the databases

< @(isdir)/bin/$(arch)/isParm
< @(ccdir)/bin/$(arch)/ccParm
< @(wfsdir)/bin/$(arch)/wfsParm

< @(engdir)/bin/$(arch)/engParm
< @(engdir)/bin/$(arch)/ccParm
< @(engdir)/bin/$(arch)/wfsParm
< @(engdir)/bin/$(arch)/tmpParm

#< @(engdir)/bin/$(arch)/engSimParm
#< @(engdir)/bin/$(arch)/ccSimParm
#< @(engdir)/bin/$(arch)/wfsSimParm
#< @(engdir)/bin/$(arch)/tmpSimParm

# Initialize the interlock handler.

< @(engdir)/bin/$(arch)/lockBusy
< @(engdir)/bin/$(arch)/lockCc
< @(engdir)/bin/$(arch)/lockWfs
< @(engdir)/bin/$(arch)/lockIdle

# Start sequences

< @(engdir)/bin/$(arch)/engSeq
< @(engdir)/bin/$(arch)/ccSeq
< @(engdir)/bin/$(arch)/wfsSeq
< @(ccdir)/bin/$(arch)/ccSeq
< @(wfsdir)/bin/$(arch)/wfsSeq
< @(isdir)/bin/$(arch)/isSeq
seq &timeSeq,"sys=@(prefix)"

# Make the CICS logging functions use a semaphore
cicsInitLogging

# Load and initialise GNAAC VxWorks tasks

gnaacInitTasks

# Final engineering parameters

< @(engdir)/bin/$(arch)/done

# Enable extra debugging output
#cicsSetDebug(10)

shellPromptSet "@(name)/CICS> "

# End of startup.vws

#
# VxWorks startup script to load and execute system (iocCore) software.
#
# First, vxWorks startup issues:

# cd to application install directory (beware automounter problems)
cd "$(install)"
pwd
< $(install)/bin/$(arch)/local

# global variable file
ld < $(version)/bin/$(arch)/globals.o

# socket functions
ld < $(version)/bin/$(arch)/sockutil.o

# Load EPICS core and record stuff
ld < $(epics)/base/bin/$(arch)/iocCore
ld < $(epics)/base/bin/$(arch)/drvSup
ld < $(epics)/base/bin/$(arch)/recSup

# Load GNAAC libraries
ld < $(epics)/extensions/bin/$(arch)/pvload
ld < $(version)/nosource/cicsLib.o
ld < $(version)/nosource/cicsLib2.o


#time applications
#ld < $(version)/bin/$(arch)/getTime.o
#ld < $(version)/bin/$(arch)/bc350time.o

# The local file contains site-specific information
# such as the default router and the vxWorks password file.
< $(version)/bin/$(arch)/local

ld < $(epics)/base/bin/$(arch)/devSup

# Load any application records, device support or drivers here,
# or code for subroutine records
ld < $(version)/bin/$(arch)/HKVars.o 

# Temperature controller board routines
ld < ./bin/$(arch)/openprt2.o
#ld < ./bin/$(arch)/ds5000.o

openport2

# device driver for transputers
ld < $(version)/bin/$(arch)/b014Driver.o
b014Drv 0

#transputer downloader
ld <$(version)/bin/$(arch)/vxddldnet.o

# EPICS interface to transputers
ld < ./bin/$(arch)/devAoWFireMessage.o
ld < ./bin/$(arch)/WFMsgUtilities.o

#microcode downloader
ld <$(version)/bin/$(arch)/download.o

# Load other Gemini libraries (SLALIB, TIMELIB, ASTLIB) here.
ld < $(epics)/extensions/src/gemini/slalib/bin/$(arch)/slalib 
ld < $(epics)/extensions/src/gemini/timelib/bin/$(arch)/timelib
ld < $(epics)/extensions/src/gemini/astlib/bin/$(arch)/astlib

# Load sequences here
# ld < $(version)/bin/$(arch)/testseq.o
#ld <$(epics)/extensions/src/gemini/timelib/bin/$(arch)/timeSeq

timeClockInit (0,1,60,1,0)

# Configure the Timestamp system, 1=Master IOC
TSconfigure 1, 0, 0, 0, 0, 0

ld <$(version)/bin/$(arch)/eprpc.o
hostAdd "guinevere","140.252.31.202"
# Connect to the DHS server
setRPCServer("guinevere");



# the following loads: epCommon.o, naacGlobals.o, sysTasks.o, stateTasks.o
# arSetupChk.o, initTasks.o, sysCad.o, stateCad.o, obsSetupChk.o, drRoiChk.o
# noopCad.o, combCars.o, simCalc.o 
ld < $(version)/bin/$(arch)/cadTasks.o

# socket interface to datacube
ld < $(version)/bin/$(arch)/gnDQSocket.o

#start server for datacube to talk to
sp gnDCASocketIntrfc

#load temperature board interface
ld < $(version)/bin/$(arch)/epicsDev.o

#database prefix
setTop("noao:dc:",noao:dc:sad:");

# load seq and icon
cd "$(version)/bin/tp/nifs"
ldnet "NAACtp"

#default path
#cd "/dlirim1/gnaacSrc.3"
cd "$(install)"
# Load one or more ASCII databases here
dbLoad "$(version)/data/$(dctsdr).dctsdr"
dbLoadRecords "$(version)/data/noaoTop.db"
dbLoadRecords "$(version)/data/noaoSadTop.db"

# This turns off logging
#iocLogDisable=1

#start transputer interface
WFMsgGo

# Housekeeping and health check routines
ld < $(version)/bin/$(arch)/healthChk.o

#start the epics database
iocInit "$(version)/data/resource.def"

#set limits on health info
initHkArray "$(version)/data/hkChanInfo.pv"

# Initialize the CICS logging routines
cicsInitLogging
 
# Load and Initialize VxWorks Tasks
initTasks

sp logtemps,10,1,"/data0/tempTest/templog" 

#initialize the database
pvload "$(version)/data/doInit.pv","top=noao:dc:,sadtop=noao:dc:sad:"

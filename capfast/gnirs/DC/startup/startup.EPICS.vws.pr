#
# VxWorks startup script to load and execute system (iocCore) software.
#
# First, vxWorks startup issues:

# Make delete key work for backspace
#tyBackspaceSet 0177

# cd to application install directory (beware automounter problems)
cd "$(install)"
pwd

# time applications
ld < $(version)/bin/$(arch)/sockutil.o
ld < $(version)/bin/$(arch)/getTime.o
printTime

tfo = "naac:dc:inst_TraceFlag"
tfi = "naac:dc:instTraceFlag"
# The local file contains site-specific information
# such as the default router and the vxWorks password file.
< $(version)/bin/$(arch)/local

# Load EPICS core and record stuff
ld < $(epics)/base/bin/$(arch)/iocCore
ld < $(epics)/base/bin/$(arch)/drvSup
ld < $(epics)/base/bin/$(arch)/recSup
ld < $(epics)/base/bin/$(arch)/devSup


# If using state programs, load the sequencer
# ld < $(epics)/base/bin/$(arch)/seq

# Load any application records, device support or drivers here,
# or code for subroutine records
# ld < $(version)/bin/$(arch)/testsub.o
ld < $(version)/bin/$(arch)/HKVars.o 

# Temperature controller board routines
#ld < ./bin/mv162/global.o
#ld < ./bin/mv162/ds5000.o
#ld < ./bin/mv162/openprt2.o
#ld < ./bin/mv162/SendCom.o
#ld < ./bin/mv162/SendEPICS.o
#ld < ./bin/mv162/V2T.o
#openport2
#SendINIT

# Gemini Data Handling System (DHS) client libraries.
# (NOTE: Absolute path names here are not a good idea.
# Bret is working on an improvement).
#ld < /home/tvedt/DHS/imp1.3/rel/bin/$(arch)/libers.o
#ld < /home/tvedt/DHS/imp1.3/rel/bin/$(arch)/libsds.o
#ld < /home/tvedt/DHS/imp1.3/rel/bin/$(arch)/libimp.o
#ld < /home/tvedt/DHS/dhs0.6/rel/bin/$(arch)/gen.o
#ld < /home/tvedt/DHS/dhs0.6/rel/bin/$(arch)/libdhs.o
#ld < /home/tvedt/DHS/dhs0.6/rel/bin/$(arch)/dhsClient.o

# Load sequences here
# ld < $(version)/bin/$(arch)/testseq.o

# Configure the Timestamp system, 1=Master IOC none in EPICS IOC
#TSconfigure 1, 0, 0, 0, 0, 0

# device driver for transputers
ld < $(version)/bin/$(arch)/b014Driver.o
b014Drv 0

#transputer downloader
ld <$(version)/bin/$(arch)/vxddldnet.o

# EPICS interface to transputers
ld < ./bin/mv162/devAoWFireMessage.o
ld < ./bin/mv162/WFMsgUtilities.o

#microcode downloader
ld <$(version)/bin/$(arch)/download.o

# Load other Gemini libraries (SLALIB, TIMELIB, ASTLIB) here.

# Load GNAAC libraries
ld < $(epics)/extensions/bin/$(arch)/pvload
ld < $(version)/nosource/cicsLib.o
ld < $(version)/nosource/cicsLib2.o

# the following loads: epCommon.o, naacGlobals.o, sysTasks.o, stateTasks.o
# arSetupChk.o, initTasks.o, sysCad.o, stateCad.o, obsSetupChk.o, drRoiChk.o
# noopCad.o, combCars.o, simCalc.o 
ld < $(version)/bin/$(arch)/cadTasks.o


# RPC testing
#ld </home/tmorgan/uae/epdqRPC/eprpc.o
#hostAdd "juliet","140.232.32.208"
#dqRpcInit "juliet"

# load seq and icon

cd "$(version)/bin/tp/nifs"
ldnet "NAACtptest"

# load old transputer driver that uses socket
#ld </otter/repos2/NAACsrc/vxDrvr/srvr.o
#sp naacdrvr

cd "/dlirim1/gnaacSrc.3"

# Load one or more ASCII databases here
dbLoad "$(version)/data/$(dctsdr).dctsdr"
dbLoadRecords "$(version)/data/naacTop.db"
dbLoadRecords "$(version)/data/naacSadTop.db"
#dbLoadRecords "$(version)/data/NaacCtrl.db"
dbLoadRecords "$(version)/data/temp.db"

# This turns off logging
#iocLogDisable=1

WFMsgGo

#modify "-v1"
# Housekeeping and health check routines
ld < $(version)/bin/$(arch)/healthChk.o
initHkArray "$(version)/data/hkChanInfo.pv"
iocInit "$(version)/data/resource.def"

# Initialise the DHS Library (NOTE: The user specified in "iam" must be the same
# as the user running the DHS server)
#iam ("tvedt")
#sp (ImpMaster)

# Start sequences
# seq &testseq

# Initialize the CICS logging routines
cicsInitLogging
 
# Load and Initialize VxWorks Tasks
initTasks

pvload "$(version)/data/doInit.pv","top=naac:dc:,sadtop=naac:dc:"

# Connect to the DHS server
#
# NOTE: The following command will hang up the shell if the DHS server
# does not respond correctly. To avoid this please restart the DHS server
# before rebooting the IOC. The call to "memShow" fixes a memory problem
# created by a bug in "dhsInit" or "dhsConnect" and must be made.
#
# NOTE: The following two commands need to be entered manually to avoid
# bugs in the DHS library. Please type them in.
#
#dataInit ("gnaac",3,"kiwi","testServer")
#memShow



#download microcode
#ldWaveFormGen "/dlirim1/aceTest/ucode/NAAC/", "gnaac32ad4q_xx"
#load "/dlirim1/aceTest/ucode/NAAC/", "gnaac32ad4q_xx"
# End of startup.EPICS
printTime









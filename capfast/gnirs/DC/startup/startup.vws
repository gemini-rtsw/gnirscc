#
# VxWorks startup script to load and execute system (iocCore) software.
#
# First, vxWorks startup issues:

# Make delete key work for backspace
tyBackspaceSet 0177

# cd to application install directory (beware automounter problems)
cd "$(iocpath)"
pwd

# The local file contains site-specific information
# such as the default router and the vxWorks password file.

< ./bin/$(arch)/local

hostAdd ("ngnirsdc1", "10.2.2.83")

# socket functions
ld < $(version)/bin/$(arch)/sockutil.o

# Load EPICS core and record stuff
ld < /gemini/external/GEM5/base/bin/mv167/iocCore
ld < /gemini/external/GEM5/base/bin/mv167/drvSup
ld < /gemini/external/GEM5/base/bin/mv167/recSup

# global variable file
ld < $(version)/bin/$(arch)/globals.o
ld < $(version)/bin/$(arch)/epicsGlobals.o

# Load GNAAC libraries
ld < /gemini/external/GEM5/extensions/bin/mv167/pvload
ld < $(version)/bin/mv162/cicsLib.o
ld < $(version)/bin/mv162/cicsLib2.o

#time applications
ld < $(version)/bin/$(arch)/getTime.o
ld < $(version)/bin/$(arch)/bc350time.o



ld < /gemini/external/GEM5/base/bin/mv167/devSup

ld < /gemini/external/GEM5/base/bin/mv167/seq

# Load any application records, device support or drivers here,
# or code for subroutine records

ld < $(version)/bin/$(arch)/HKVars.o

# Temperature controller board routines
#ld < ./bin/$(arch)/openprt2.o
#ld < ./bin/$(arch)/ds5000.o
ld < $(version)/bin/$(arch)/omega.o
#openport2

# device driver for transputers
ld < $(version)/bin/$(arch)/b014Driver.o
b014Drv 0

#transputer downloader
ld < $(version)/bin/$(arch)/vxddldnet.o

# EPICS interface to transputers
ld < $(version)/bin/$(arch)/devAoWFireMessage.o
ld < $(version)/bin/$(arch)/WFMsgUtilities.o

#microcode downloader
ld < $(version)/bin/$(arch)/download.o

# Load other Gemini libraries (SLALIB, TIMELIB, ASTLIB) here.

ld < /gemini/slalib/bin/mv167/slalib
ld < /gemini/timelib/bin/mv167/timelib
ld < /gemini/astlib/bin/mv167/astlib

#load sequences
ld </gemini/timelib/bin/mv167/timeSeq

timeClockInit(0,0,60,1,0)

#rpc routines
ld < $(version)/bin/$(arch)/eprpc.o
setRPCServer("ngnirsdc1");

#
ld < ./bin/$(arch)/gemLogMsg.o

#epics cad routines
ld < $(version)/bin/$(arch)/cadTasks.o

# socket interface to coadder
ld < $(version)/bin/$(arch)/gnDQSocket.o

#start server for coadder to talk to
sp gnDCASocketIntrfc

#load temperature board interface
#ld < /gemini/epics3.13.4/gnirs/gnirs/DC/bin/mv162/epicsDev.o

#database prefix
setTop("nirsg:dc:","nirsg:sad:dc:");

# load seq and icon
# cd "$(iocpath)/bin/tp/nifs"
# fkraemer - for now, copied tpSource dir to $(iocpath), the ucode dir is also
# needed and it was hacked like that in other installations, too
cd "$(iocpath)/tpSource/tp/nifs"
ldnet "NAACtp"

#default path
cd "$(iocpath)"
pwd
shellPromptSet "gnirs(DC2-IOC) -> "

# Load one or more ASCII databases here
dbLoad "$(version)/data/default.dctsdr"
dbLoadRecords "$(version)/data/nirsTop.db"
dbLoadRecords "$(version)/data/nirsSadTop.db"

# This turns off logging
iocLogDisable=1

#start transputer interface
WFMsgGo

# Housekeeping and health check routines
ld < $(version)/bin/$(arch)/healthChk.o

#start the epics database
iocInit "$(version)/data/resource.def"

#set limits on health info
initHkArray "$(version)/data/hkChanInfo.pv"
# Initialize the CICS logging routines
cicsInitLogging
#cicsSetDebug(2)

coAdSim = 1

# Load and Initialize VxWorks Tasks
initTasks

#sp logtemps,30,1,"/data0/tempTest/templog"

#initialize the database
pvload "$(version)/data/doInit.pv","top=nirsg:dc:,sadtop=nirsg:sad:dc:"

seq &timeSeq, "sys=nirsg:dc:"
dbpf "nirsg:sad:dc:instrument","gnirs"

dbpf "nirsg:dc:wcsport", "3"
dbpf "nirsg:dc:wcsoverride", "0"

#gemLog related settings
gemSetUseiocLog(0)
gemSetLogLevel(7)

# Start the dcSetup sequencer
seq &dcSetup, "dctop=nirsg:dc"


# VxWorks startup script to load and execute system (iocCore) software.
# First, vxWorks startup issues:
# cd to application install directory (beware automounter problems)

# Now get the Datacube libraries and the event manager em loaded and running
ld </repos1/imageflow/lib/libdq.o
ld </repos1/imageflow/driver/vw68/em.o

# Tell everyone where things are
putenv("DQHOME=/repos1/imageflow")
putenv("DQCONFIG=/repos1/imageflow/vxwDQsys.cfg")

# start up the DataCube event manager
emDrv()

ld </repos1/imageflow/bin/amex1
# End of startup.DQSys




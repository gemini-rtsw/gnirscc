#
# InitialiZe all the associated CAR records. All are
# set to IDLE, except "initC" which is set BUSY and remains
# BUSY until the initialization is finished.
# (This ensures the records don't end up in a strange
# state after initialiZation from which they can't be
# changed).

long $(top)initC.IVAL = 2;

group {
   long $(top)applyC.IVAL = 0;
   long $(top)arSetupC.IVAL = 0;
   long $(top)datumC.IVAL = 0;
   long $(top)drRoiSetC.IVAL = 0;
   long $(top)endGuideC.IVAL = 0;
   long $(top)endObserveC.IVAL = 0;
   long $(top)endVerifyC.IVAL = 0;
   long $(top)gSysC.IVAL = 0;
   long $(top)guideC.IVAL = 0;
   long $(top)noopC.IVAL = 0;
   long $(top)obsSetupC.IVAL = 0;
   long $(top)observeC.IVAL = 0;
   long $(top)parkC.IVAL = 0;
   long $(top)testC.IVAL = 0;
   long $(top)verifyC.IVAL = 0;

}

# Set the naac DONE record values to NAAC_UNKNOWN
group {

   short $(top)arSetupDone.VAL = 1;
   short $(top)obsSetupDone.VAL = 1;
   short $(top)drRoiSetDone.VAL = 1;
   short $(top)pucDone.VAL = 0;

}



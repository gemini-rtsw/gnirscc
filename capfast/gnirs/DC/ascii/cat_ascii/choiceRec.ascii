!include <choiceHallStep.h>
!include <choiceHmotor.h>
#include <choiceTcon.h>
!include <choiceTsen.h>
!include <choiceCool.h>

! hallStep

!hallStep" REC_HS_RAW    "User"     ! (0)
!hallStep" REC_HS_RAW    "Raw"      ! (1)

!hallStep" REC_HS_ENABLE "Disable"  ! (0)
!hallStep" REC_HS_ENABLE "Enable"   ! (1)

!hallStep" REC_HS_TMP    "Changing" ! (0)
!hallStep" REC_HS_TMP    "Warm"     ! (1)
!hallStep" REC_HS_TMP    "Cold"     ! (2)

!hallStep" REC_HS_YN     "No"       ! (0)
!hallStep" REC_HS_YN     "Yes"      ! (1)

! hmotor

!hmotor" REC_HMOTOR_DIR	"Pos"	! (0)
!hmotor" REC_HMOTOR_DIR	"Neg"	! (1)

!hmotor" REC_HMOTOR_SET	"Use"	! (0)
!hmotor" REC_HMOTOR_SET	"Set"	! (1)

!hmotor" REC_HMOTOR_MODE	"Position"	! (0)
!hmotor" REC_HMOTOR_MODE	"Velocity"	! (1)

!hmotor" REC_HMOTOR_YN	"No" 	! (0)
!hmotor" REC_HMOTOR_YN	"Yes"	! (1)

!hmotor" REC_HMOTOR_SPMG	"Stop"	! (0)
!hmotor" REC_HMOTOR_SPMG	"Pause"	! (1)
!hmotor" REC_HMOTOR_SPMG	"Move"	! (2)
!hmotor" REC_HMOTOR_SPMG	"Go"	! (3)

!hmotor" REC_HMOTOR_FOFF	"Variable" 	! (0)
!hmotor" REC_HMOTOR_FOFF	"Frozen"	! (1)

!hmotor" REC_HMOTOR_POWER "Auto"      ! (0)
!hmotor" REC_HMOTOR_POWER "On"        ! (1)
!hmotor" REC_HMOTOR_POWER "Off"       ! (2)

"tcon" REC_TCON_RANG "Off"     ! (0)
"tcon" REC_TCON_RANG "Low"     ! (1)
"tcon" REC_TCON_RANG "High"    ! (2)

"tcon" REC_TCON_TUNE  "Manual"  ! (0)
"tcon" REC_TCON_TUNE  "P"       ! (1)
"tcon" REC_TCON_TUNE  "PI"      ! (2)
"tcon" REC_TCON_TUNE  "PID"     ! (3)

"tcon" REC_TCON_UNITS "C"       ! (0)
"tcon" REC_TCON_UNITS "K"       ! (1)
"tcon" REC_TCON_UNITS "F"       ! (2)
"tcon" REC_TCON_UNITS "V"       ! (3)

!tsen" REC_TSEN_UNITS "C"       ! (0)
!tsen" REC_TSEN_UNITS "K"       ! (1)
!tsen" REC_TSEN_UNITS "F"       ! (2)

!cool" REC_COOL_RATE  "Off"     ! (0)
!cool" REC_COOL_RATE  "Low"     ! (1)
!cool" REC_COOL_RATE  "High"    ! (2)

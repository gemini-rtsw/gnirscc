# This rule will work if there is only one target, but has to be
# modified appropriately for multiple targets

default: $(TARGETS)

#dqrpc.o: $(DQOBJS)
#	$(RM) dqrpc.o
#	$(LINK.c) dqrpc.o $(DQOBJS)

eprpc.o: $(EPOBJS)
	$(RM) eprpc.o
	$(LINK.c) eprpc.o $(EPOBJS)

#epdq_svc.o: ../epdq_svc.c 
 
epdq_proc.o: ../epdq_proc.c 

epdq_clnt.o: ../epdq_clnt.c 

epdq_func.o: ../epdq_func.c 


 
# The Vxworks version of the files generated by rpcgen need some editing.
# Main programs generated by rpcgen needs to have
# main() replaced and a call to rpcTaskInit() inserted.
# Read the script for further details.
rpc_sed_script: Makefile
	@ cp /dev/null $@
	@ echo "/#include <stdio\.h>/c\\" >>$@
	@ echo "#if     defined(VXWORKS)\\" >>$@
	@ echo "#include <stdioLib.h>\\" >>$@
	@ echo "#else\\" >>$@
	@ echo "#include <stdio.h>\\" >>$@
	@ echo "#endif" >>$@
	@ echo "/#include <rpc\/types\.h>/c\\" >>$@
	@ echo "#if     defined(VXWORKS)\\" >>$@
	@ echo "#include <rpc/rpctypes.h>\\" >>$@
	@ echo "#else\\" >>$@
	@ echo "#include <rpc/types.h>\\" >>$@
	@ echo "#endif" >>$@
	@ echo "/main()/c\\" >>$@
	@ echo "#if     defined(VXWORKS)\\" >>$@
	@ echo "MAIN_server() { rpcTaskInit(), MAIN_execute() ; }\\" >>$@
	@ echo "MAIN_execute()\\" >>$@
	@ echo "#else\\" >>$@
	@ echo "main()\\" >>$@
	@ echo "#endif" >>$@

#include <stdio.h>

typedef struct {
  int a,b,c;
  char d,f;
  int e;
} xxx ;

xxx m[3];

typedef struct {
    char *info;
    int type;
    int offset;
} y ;

y ar[] = {
    {"a", 1, ((char *)(&(m[0].a)) - (char *)(&m[0])) },
    {"b", 1, ((char *)(&(m[0].b)) - (char *)(&m[0])) },
    {"d", 1, ((char *)(&(m[0].d)) - (char *)(&m[0])) },
    {"e", 0, ((char *)(&(m[0].e)) - (char *)(&m[0])) },
    {"f", 0, ((char *)(&(m[0].f)) - (char *)(&m[0])) },
    {NULL, 0, 0 },
};

main(int argc, char**argv) {

    int i;
    y *yp;
    char *where;

    yp = &ar[0];

    printf("m1 at %x\n", &m[1]);
    printf("size of xxx: %x\n", sizeof(xxx));
    for ( i = 0; ; i++ ) {
	yp = &ar[i];
	if (yp->info == NULL)
		break;
	printf ("%s %d ", yp->info, yp->offset);
	where = yp->offset + (char *)&m[1];
	if (yp->type)
	    printf("%x\n", (int *)where);
	else
	    printf("%x\n", (char *)where);
    }
}

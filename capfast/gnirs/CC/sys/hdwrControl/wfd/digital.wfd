 * FILENAME:
 * digital.c
 *
 * FUNCTION NAME(S):
 *  clearBit   -   Clears bit 
 *  initIOBits   -   Set initial output bits 
 *  initXycom   -   Initialize the digital I/O board. 
 *  isClear   -   Determines if bit is not set 
 *  isSet   -   Determines if bit is set 
 *  readBit   -   Read a bit from I/O board. 
 *  setBit   -   Set bit. 
 *  testXYCOM   -   Tests Digital I/O hardware 
 *  xycomBiRead   -   Read a digital input port 
 *  xycomBoRead   -   Read a digital output port 
 *  xycomBoWrite   -   Write a masked value to the given port 
 *  xycomIntHndlr   -   Handle interrupts from digital I/O board. 
 *  xycomSetInterrupt   -   Set/Clear interrupt handler. 
 *
 *INDENT-OFF*
 * $Log: digital.wfd,v $
 * Revision 1.2  2009/05/27 19:32:11  fkraemer
 * fkraemer - copied my complete working dir over trunk
 *
 *INDENT-ON*
 *-
 */
/*
 *+
 * FUNCTION NAME:
 * testXYCOM
 *
 * INVOCATION:
 * testXYCOM()
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 * None
 *
 * FUNCTION VALUE:
 * (int) Returns VME_OK (0) or VME_ERROR (1) as status
 *
 * PURPOSE:
 * Tests Digital I/O hardware
 *
 * DESCRIPTION:
 * Verifies that the hardware is working by reading the ID string from
 * the VME board.  This test does not disturb the hardware and can be
 * run at any time, a requirement for the Gemini OCS 'test' commmand.
 *
 * EXTERNAL VARIABLES:
 *
 *
 * PRIOR REQUIREMENTS:
 *
 *
 * DEFICIENCIES:
 *
 *
 * HISTORY:
 * Jul 1, 2001      Initial Version                 (rwolff@noao.edu)
 *
 *-
 */
/*
 *+
 * FUNCTION NAME:
 * initXycom
 *
 * INVOCATION:
 * initXycom()
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 * None
 *
 * FUNCTION VALUE:
 * (int) Returns VME_OK (0) or VME_ERROR (1) as status
 *
 * PURPOSE:
 * Initialize the digital I/O board.
 *
 * DESCRIPTION:
 * Create a semaphore for locking use.  Then set the various registers
* in the hardware.
 *
 * EXTERNAL VARIABLES:
 *
 *
 * PRIOR REQUIREMENTS:
 *
 *
 * DEFICIENCIES:
 *
 *
 * HISTORY:
 * Jul 1, 2001      Initial Version                 (rwolff@noao.edu)
 *
 *-
 */
/*
 *+
 * FUNCTION NAME:
 * xycomIntHndlr
 *
 * INVOCATION:
 * xycomIntHndlr(dummy)
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 * (>) dummy (int)          not used
 *
 * FUNCTION VALUE:
 * (void) Returns 'void' and hence has no STATUS value
 *
 * PURPOSE:
 * Handle interrupts from digital I/O board.
 *
 * DESCRIPTION:
 * When the digital I/O board interrupts, check each of the 8 interrupt
 * pending bits.  For those that are set, dispatch the corresponding
 * function, if any; when that function returns, clear the bit.
 *
 * EXTERNAL VARIABLES:
 *
 *
 * PRIOR REQUIREMENTS:
 *
 *
 * DEFICIENCIES:
 *
 *
 * HISTORY:
 * Jul 1, 2001      Initial Version                 (rwolff@noao.edu)
 *
 *-
 */
/*
 *+
 * FUNCTION NAME:
 * xycomSetInterrupt
 *
 * INVOCATION:
 * xycomSetInterrupt(which, func)
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 * (>) which (int)          Which bit to associated function with
 * (>) func (PFV)           Pointer to function that returns a void
 *
 * FUNCTION VALUE:
 * (void) Returns 'void' and hence has no STATUS value
 *
 * PURPOSE:
 * Set/Clear interrupt handler.
 *
 * DESCRIPTION:
 * Set the interrupt handler for a given bit (0-7).  If the function
 * pointer is NULL, unset that bit in the interrupt mask.
 *
 *
 * EXTERNAL VARIABLES:
 *
 *
 * PRIOR REQUIREMENTS:
 *
 *
 * DEFICIENCIES:
 *
 *
 * HISTORY:
 * Jul 1, 2001      Initial Version                 (rwolff@noao.edu)
 *
 *-
 */
/*
 *+
 * FUNCTION NAME:
 * initIOBits
 *
 * INVOCATION:
 * initIOBits()
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 * None
 *
 * FUNCTION VALUE:
 * (int) Returns VME_OK (0) or VME_ERROR (1) as status
 *
 * PURPOSE:
 * Set initial output bits
 *
 * DESCRIPTION:
 * Sets the initial values of the output bits on the digital I/O
 * board as specified in the xycomOutputInit array (see globals.c)
 *
 * EXTERNAL VARIABLES:
 *
 *
 * PRIOR REQUIREMENTS:
 *
 *
 * DEFICIENCIES:
 *
 *
 * HISTORY:
 * Jul 1, 2001      Initial Version                 (rwolff@noao.edu)
 *
 *-
 */
/*
 *+
 * FUNCTION NAME:
 * xycomBiRead
 *
 * INVOCATION:
 * xycomBiRead(port, mask, prval)
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 * (>) port (int)               Port to read
 * (>) mask (unsigned char)     Mask to apply to value read
 * (>) prval (unsigned char *)  Where to store result
 *
 * FUNCTION VALUE:
 * (int) Returns VME_OK (0) or VME_ERROR (1) as status
 *
 * PURPOSE:
 * Read a digital input port
 *
 * DESCRIPTION:
 * Reads the port, and returns the value after and'ing with the mask.
 *
 * EXTERNAL VARIABLES:
 *
 *
 * PRIOR REQUIREMENTS:
 *
 *
 * DEFICIENCIES:
 *
 *
 * HISTORY:
 * Jul 1, 2001      Initial Version                 (rwolff@noao.edu)
 *
 *-
 */
/*
 *+
 * FUNCTION NAME:
 * xycomBoRead
 *
 * INVOCATION:
 * xycomBoRead(port, mask, prval)
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 * (>) port (int)               Port to write
 * (>) mask (unsigned char)     Mask to apply
 * (>) prval (unsigned char *)  Where to store result
 *
 * FUNCTION VALUE:
 * (int) Returns VME_OK (0) or VME_ERROR (1) as status
 *
 * PURPOSE:
 * Read a digital output port
 *
 * DESCRIPTION:
 * Reads the port, and returns the value after and'ing with the mask.
 *
 * EXTERNAL VARIABLES:
 *
 *
 * PRIOR REQUIREMENTS:
 *
 *
 * DEFICIENCIES:
 *
 *
 * HISTORY:
 * Jul 1, 2001      Initial Version                 (rwolff@noao.edu)
 *
 *-
 */
/*
 *+
 * FUNCTION NAME:
 * xycomBoWrite
 *
 * INVOCATION:
 * xycomBoWrite(port, mask, val)
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 * (>) port (int)           Port to write
 * (>) mask (unsigned char) Mask to apply to value
 * (>) val (unsigned char)  Value to be written
 *
 * FUNCTION VALUE:
 * (int) Returns VME_OK (0) or VME_ERROR (1) as status
 *
 * PURPOSE:
 * Write a masked value to the given port
 *
 * DESCRIPTION:
 * Reads the port, replaces those bits of val corresponding to
 * bits set in the mask, and writes that value to the port.
 *
 * EXTERNAL VARIABLES:
 *
 *
 * PRIOR REQUIREMENTS:
 *
 *
 * DEFICIENCIES:
 *
 *
 * HISTORY:
 * Jul 1, 2001      Initial Version                 (rwolff@noao.edu)
 *
 *-
 */
/*
 *+
 * FUNCTION NAME:
 * readBit
 *
 * INVOCATION:
 * readBit(iob)
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 * (>) iob (ioBit)          bit to read
 *
 * FUNCTION VALUE:
 * (unsigned char) Returns the bit (zero or one)
 *
 * PURPOSE:
 * Read a bit from I/O board.
 *
 * DESCRIPTION:
 * Reads the state of the bit described in the iob structure and returns
 * that value (zero or one).
 *
 * EXTERNAL VARIABLES:
 *
 *
 * PRIOR REQUIREMENTS:
 *
 *
 * DEFICIENCIES:
 *
 *
 * HISTORY:
 * Jul 1, 2001      Initial Version                 (rwolff@noao.edu)
 *
 *-
 */
/*
 *+
 * FUNCTION NAME:
 * isSet
 *
 * INVOCATION:
 * isSet(iob)
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 * (>) iob (ioBit)          bit to interrogate
 *
 * FUNCTION VALUE:
 * (int) Returns non-zero if set, zero elsewise.
 *
 * PURPOSE:
 * Determines if bit is set
 *
 * DESCRIPTION:
 * Reads the bit described by iob and returns true/1 if set.
 *
 * EXTERNAL VARIABLES:
 *
 *
 * PRIOR REQUIREMENTS:
 *
 *
 * DEFICIENCIES:
 *
 *
 * HISTORY:
 * Jul 1, 2001      Initial Version                 (rwolff@noao.edu)
 *
 *-
 */
/*
 *+
 * FUNCTION NAME:
 * isClear
 *
 * INVOCATION:
 * isClear(iob)
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 * (>) iob (ioBit)          bit to interrogate
 *
 * FUNCTION VALUE:
 * (int) Returns non-zero if not set, zero elsewise
 *
 * PURPOSE:
 * Determines if bit is not set
 *
 * DESCRIPTION:
 * Reads the bit described by iob and returns true/1 if not set.
 *
 * EXTERNAL VARIABLES:
 *
 *
 * PRIOR REQUIREMENTS:
 *
 *
 * DEFICIENCIES:
 *
 *
 * HISTORY:
 * Jul 1, 2001      Initial Version                 (rwolff@noao.edu)
 *
 *-
 */
/*
 *+
 * FUNCTION NAME:
 * setBit
 *
 * INVOCATION:
 * setBit(iob)
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 * (>) iob (ioBit)          Bit to set
 *
 * FUNCTION VALUE:
 * (int) Returns VME_OK (0) or VME_ERROR (1) as status
 *
 * PURPOSE:
 * Set bit.
 *
 * DESCRIPTION:
 * Sets bit described by iob
 *
 * EXTERNAL VARIABLES:
 *
 *
 * PRIOR REQUIREMENTS:
 *
 *
 * DEFICIENCIES:
 *
 *
 * HISTORY:
 * Jul 1, 2001      Initial Version                 (rwolff@noao.edu)
 *
 *-
 */
/*
 *+
 * FUNCTION NAME:
 * clearBit
 *
 * INVOCATION:
 * clearBit(iob)
 *
 * PARAMETERS: (">" input, "!" modified, "<" output)
 * (>) iob (ioBit)          Bit to clear
 *
 * FUNCTION VALUE:
 * (int) Returns VME_OK (0) or VME_ERROR (1) as status
 *
 * PURPOSE:
 * Clears bit
 *
 * DESCRIPTION:
 * Clears bit described by iob
 *
 * EXTERNAL VARIABLES:
 *
 *
 * PRIOR REQUIREMENTS:
 *
 *
 * DEFICIENCIES:
 *
 *
 * HISTORY:
 * Jul 1, 2001      Initial Version                 (rwolff@noao.edu)
 *
 *-

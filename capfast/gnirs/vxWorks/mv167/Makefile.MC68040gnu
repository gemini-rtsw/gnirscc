# MakeSkel - makefile skeleton for bsp/config/mv167
#
# Copyright 1984-1992 Wind River Systems, Inc.
#
# modification history
# --------------------
# 01g,10mar94,vin  changed RAM_LOW_ADRS to 0x20000 from 0x1000
# 01f,31oct92,caf  increased ROM_SIZE to 00080000, RAM_HIGH_ADRS to 00100000.
# 01e,30oct92,caf  fixed spelling of MVME167.
# 01d,29oct92,caf  increased ROM_SIZE to 00040000.
# 01c,16oct92,ccc  changed note about config.h dependancy.
# 01b,09sep92,gae  defined target macro's.
# 01a,22jun92,rrr  written.
#
# DESCRIPTION
# This file contains rules for building VxWorks for the
# Motorola MVME167.
#
# INCLUDES
#     makeTarget
#*/

CPU              = MC68040
TOOL             = gnu

TARGET_DIR       = mv167
VENDOR           = Motorola
BOARD            = MVME167

#
# The constants ROM_TEXT_ADRS, ROM_SIZE, and RAM_HIGH_ADRS are defined
# in config.h, MakeSkel, Makefile, and Makefile.*
# All definitions for these constants must be identical.
#

ROM_TEXT_ADRS    = ff800008 # ROM entry address
ROM_SIZE         = 00080000 # number of bytes of ROM space

RAM_LOW_ADRS     = 00020000 # RAM text/data address
RAM_HIGH_ADRS    = 00100000 # RAM text/data address

HEX_FLAGS        = -v -p $(ROM_TEXT_ADRS) -a 8

MACH_EXTRA       =

# makeTarget - meta makeTarget stub for building BSPs
#
# modification history
# --------------------
# 01a,22sep92,yp    added modification history
#
# DESCRIPTION
# This file contains the makeTarget and intermediate makeTarget for VxWorks.
#*/

# makeTarget2 - makefile target skeleton for BSP Targets "pass 2"
#
# modification history
# --------------------
# 03c,28mar95,kdl  fixed use of env vars to support bsp not in vw tree (spr4100)
# 03b,15mar95,caf  added rules for mips resident roms (SPR #3856).
# 03a,10dec94,caf  undid MIPS-specific resident ROM changes (SPR 3856).
# 02g,06jun94,caf  use CASFLAGS when assembling romInit.s.
# 02f,26oct94,caf  changed resident ROMs to locate the start of data with the
#		   RAM_DST_ADRS macro (previously used for standalone ROMs).
# 02h,05oct94,kdl  added missing space in depend.$(CPU)$(TOOL) rule.
# 02g,30sep94,kdl  changed "make" to "$(MAKE)" to use environment variable;
#		   changed depend.$(CPU)$(TOOL) rule to use temporary file.
# 02f,19jul94,vin  added BOOT_EXTRA macro to dependency list for
#		   bootrom and vxWorks.st_rom
# 02e,04feb93,wmd  removed setting of MV_BIN to true to make.defaults.
#		   Also remove imi before building ROM targets.
# 02d,02feb93,rrr  SPR 1817 added romInit.o to depend list
#                  SPR 1840 set MV_BIN to ``true'' so that it is not a null cmd
# 02c,13nov92,kdl  added $(IMI) to dependencies for bootrom_uncmp.hex and
#		   bootrom_res.hex (SPR #1754).
# 02b,29oct92,jcf  added back 0x to RAM_DST_ADRS, for standalone hex.
# 02a,24oct92,jcf  made xxx_st.o have more robust dependency rules.
# 01z,23oct92,yp   added BOOT_EXTRA macro for targets building compressed ROMs
#		   remove symTbl.c and symTbl.o before building them
# 01y,23oct92,wmd  restored imi target to revision 01w.
# 01x,21oct92,wmd  cannot use output of LDOUT_SYMS for relinking, use tmp file.
# 01w,20oct92,wmd  modified imi target for i960.
# 01v,01oct92,yp   move $CP macro to make.defaults so hosts can over-ride

# 01a,22jun92,yp   created from makeTarget
#
# DESCRIPTION
# This file contains rules, definitions, and flags used in building targets.
#
# VARIABLES
# The following variables must be defined (or not, as appropriate):
#
#     ROM_SIZE          number of bytes of ROM space as in config.h
#     LOCAL_MEM_SIZE	target RAM size as in config.h
#     BINHEX		binary->hex file conversion program
#     HEX_FLAGS         BINHEX program options
#     LD_LOW_FLAGS	ld(1) options for code in low memory
#     LD_HIGH_FLAGS	ld options for code in high memory
#     LD_PARTIAL_FLAGS  ld flags for linking partially complete objects
#     LDDEPS		host-specific dependencies prerequisite to linking
#     LDOUT_CONV	hpToBsd, coffToBsd, gswab, /bin/cat, etc.
#     COMPILE_SYMTBL	hide flags needed to get compiler to swallow symTbl.c
#     ROM_ENTRY		rom entry point (typically &romInit)
#     SYS_ENTRY		system entry point (typically &sysInit)
#     USR_ENTRY		compressed system entry point (typically &usrInit)
#
# The following variables are optionally defined:
#
#     LDFLAGS		standard ld flags for vxWorks & ROMs.
#     ROM_LDFLAGS	ld flags specific to ROM image
#
# CONSTANTS
#     CPU               cpu type
#*/

RELEASE=vxWorks vxWorks.st bootrom.hex

# make.defaults - Compilation tools default definitions
#
# modification history
# --------------------
# 01k,04feb93,wmd  defined default MV_BIN = true here.
# 01j,03feb93,rrr  SPR 1841, changed CP=cp -p to CP=cp because sgi doesn't
#                  understand -p flag
# 01i,21oct92,caf  introduced ADDED_CFLAGS and ADDED_MODULES, which may be
#		   defined on make command line (SPR 1707).
# 01h,01oct92,yp   move $CP macro here from makeTarget2
# 01g,22sep92,yp   added bsp/src directories so bsps stay position independent
# 01f,22sep92,jcf  removed BOOTROMZ_DEP.  fixed MACH_DEP.
# 01e,13aug92,jcf  fixed comment of MACH_DEP.
# 01d,21jul92,rdc  moved MACH_DEP here from makeTarget2 so arch dep makefiles
#                  can redefine.
# 01c,21jul92,rrr  added TARGET= so you don't grab the environment one.
# 01b,17jul92,rrr  added LDOUT_SYMS
# 01a,17jul92,wdm  added modification history, defined LDOUT_SYMS.
#
# DESCRIPTION
# This file contains default definitions, and flags used in building targets.
# NEVER CHANGE ANYTHING IN THIS FILE, ONLY ADD TO IT. If you change something
# you would have to go through a dozen make.$(CPU)$(TOOL) files and make
# sure they didn't break.
#

CFLAGS		= $(CC_OPTIM) $(CC_WARNINGS) $(CC_INCLUDE) $(CC_COMPILER) \
			$(CC_DEFINES) $(ADDED_CFLAGS)

CASFLAGS	= -E $(CC_INCLUDE) $(CC_DEFINES)
CC_WARNINGS	= $(CC_WARNINGS_ALL)
CC_OPTIM	= $(CC_OPTIM_NORMAL)
CC_INCLUDE	= -I$(UP)/h $(INCLUDE_CC) $(EXTRA_INCLUDE) \
		  -I$(VX_BSP_BASE)/src/config/ \
		  -I$(VX_BSP_BASE)/src/drv/
CC_DEFINES	= -DCPU=$(CPU) $(DEFINE_CC) $(EXTRA_DEFINE)

RM		= rm -f
CP		= cp
SHELL		= /bin/sh

# override things below this point

.s.o :
	@ $(RM) $@
	cat $< > $*.S
	$(CC) $(CFLAGS) -c $*.S
	@ $(RM) $*.S

.c.o :
	@ $(RM) $@
	$(CC) $(CFLAGS) -c $<

CPU             = MC68020
TOOL            = gnu

CC_WARNINGS_ALL	= -Wall
CC_WARNINGS_NONE=

CC_OPTIM_DRIVER	=
CC_OPTIM_NORMAL	= -O -fstrength-reduce -fcombine-regs
CC_OPTIM_TARGET	= -O -fvolatile

CC_COMPILER	=  -ansi -pedantic -pipe -nostdinc

AR              = ar
AS              = as
CC              = cc
LD              = ld
RANLIB          = ranlib

LD_LOW_FLAGS    = -Ttext $(RAM_LOW_ADRS)
LD_HIGH_FLAGS   = -Ttext $(RAM_HIGH_ADRS)
RES_LOW_FLAGS   = -Ttext $(ROM_TEXT_ADRS) -Tdata $(RAM_LOW_ADRS)
RES_HIGH_FLAGS  = -Ttext $(ROM_TEXT_ADRS) -Tdata $(RAM_HIGH_ADRS)

ROM_ENTRY       = _romInit
SYS_ENTRY       = _sysInit
USR_ENTRY       = _usrInit

LDFLAGS         = -X -N
LD_PARTIAL_FLAGS= -X -r

MACH_DEP	= sysALib.o sysLib.o tyCoDrv.o $(MACH_EXTRA) \
		  $(ADDED_MODULES)

EXTRACT_BIN     = $(VX_HSP_BASE)/bin/$(VX_HOST_TYPE)/aoutToBin
LDOUT_SYMS      = true
LDOUT_CONV      = true 
LDOUT_HOST      = true 
BINXSYM         = $(VX_HSP_BASE)/bin/$(VX_HOST_TYPE)/xsym 
BINHEX          = $(VX_HSP_BASE)/bin/$(VX_HOST_TYPE)/hex 
 
ENV_BIN         = $(TOOLENV) $(VX_HSP_BASE)/bin/$(VX_HOST_TYPE)/
TARGET		=
MV_BIN		= true

# end of make.defaults

# make.MC68040gnu - GNU compilation tools definitions for MC68040
#
# modification history
# --------------------
# 01d,22sep92,yp   added EOF marker
# 01c,22sep92,jcf  removed redefinition of MACH_DEP.
# 01b,03sep92,yp   added -fno-builtin to drivers
# 01a,23aug92,yp   added modification history and support for GCC 2.2.2
#
# DESCRIPTION
# This file contains MC68040 specific definitions and flags for the GNU
# software generation tools (compiler, assembler, linker etc.).
#*/


CPU=MC68040
TOOL=gnu

CC_OPTIM_DRIVER = -fno-builtin
CC_OPTIM_NORMAL = -O -fstrength-reduce -fno-builtin -m68040 -m68040-only
CC_OPTIM_TARGET = -O -fvolatile -fno-builtin -m68040 -m68040-only

AR=ar68k
AS=as68k
CC=cc68k
LD=ld68k
RANLIB=ranlib68k

TOOLENV= VX_CPU_FAMILY=68k

# end of make.MC68040gnu


## alternate file directory
CONFIG_ALL = $(VX_VW_BASE)/config/all/

MAN1 	   = $(VX_BSP_BASE)/man/man1/
MAN2 	   = $(VX_BSP_BASE)/man/man2/

## flags and defines

EXTRA_INCLUDE  = -I. -I$(CONFIG_ALL) -I$(VX_BSP_BASE)/h -I$(VX_VW_BASE)/h/ \
		 -I $(VX_VW_BASE)/src/config

ASM_P1                   = cat
ASM_P2                   = cat


COMPILE_SYMTBL  = $(CC) -c $(CFLAGS)

CC_OPTIM = $(CC_OPTIM_TARGET)

## files

LIBS      =  $(VX_BSP_BASE)/lib/lib$(CPU)$(TOOL)drv.a \
	     $(VX_VW_BASE)/lib/lib$(CPU)$(TOOL)vx.a $(LIB_EXTRA)

exe	: vxWorks

clean   :
	$(RM) *.o vxWorks* bootrom* 

version.o:
	@ $(RM) version.[co]
	$(ENV_BIN)makeVersion > version.c
	$(CC) -c $(CFLAGS) version.c
	@ $(RM) version.c

####################### machine dependent modules ##########################

romInit_res.o: romInit.s
	@ $(RM) $@ tmp.c tmp.s tmp.i
	$(ASM_P1) romInit.s > tmp.c
	$(CC) $(CASFLAGS) -DROM_RESIDENT tmp.c > tmp.i
	$(ASM_P2) tmp.i > tmp.s
	$(AS) -o $@ tmp.s
	@ $(RM) tmp.c tmp.i tmp.s

romInit_res_low.o: romInit.s
	@ $(RM) $@
	$(CC) $(CASFLAGS) -DROM_RESIDENT \
	    -DRAM_DST_ADRS=0x$(RAM_LOW_ADRS) -o $@ romInit.s

romInit_res_high.o: romInit.s
	@ $(RM) $@
	$(CC) $(CASFLAGS) -DROM_RESIDENT \
	    -DRAM_DST_ADRS=0x$(RAM_HIGH_ADRS) -o $@ romInit.s

usrConfig.o : $(CONFIG_ALL)usrConfig.c
	@ $(RM) $@
	$(CC) -c $(CFLAGS) $(CONFIG_ALL)usrConfig.c

# can't use "cc -c -o"
usrConfig_st.o : $(CONFIG_ALL)usrConfig.c usrConfig.o
	@ $(RM) $@
	$(CP) $(CONFIG_ALL)usrConfig.c usrConfig_st.c
	$(CC) -c $(CFLAGS) -DSTANDALONE usrConfig_st.c
	@ $(RM) usrConfig_st.c

bootConfig.o : $(CONFIG_ALL)bootConfig.c
	@ $(RM) $@
	$(CC) -c $(CFLAGS) $(CONFIG_ALL)bootConfig.c

bootInit.o : $(CONFIG_ALL)bootInit.c
	@ $(RM) $@
	$(CC) -c $(CFLAGS) $(CONFIG_ALL)bootInit.c

bootInit_res.o : $(CONFIG_ALL)bootInit.c bootInit.o
	@ $(RM) $@
	$(CP) $(CONFIG_ALL)bootInit.c bootInit_res.c
	$(CC) -c $(CFLAGS) -DROM_RESIDENT bootInit_res.c
	@ $(RM) bootInit_res.c

bootInit_res_low.o : $(CONFIG_ALL)bootInit.c
	@ $(RM) $@
	$(CP) $(CONFIG_ALL)bootInit.c bootInit_res_low.c
	$(CC) -c $(CFLAGS) -DROM_RESIDENT \
	    -DRAM_DST_ADRS=0x$(RAM_LOW_ADRS) bootInit_res_low.c
	@ $(RM) bootInit_res_low.c

bootInit_res_high.o : $(CONFIG_ALL)bootInit.c
	@ $(RM) $@
	$(CP) $(CONFIG_ALL)bootInit.c bootInit_res_high.c
	$(CC) -c $(CFLAGS) -DROM_RESIDENT \
	    -DRAM_DST_ADRS=0x$(RAM_HIGH_ADRS) bootInit_res_high.c
	@ $(RM) bootInit_res_high.c

bootInit_uncmp.o : $(CONFIG_ALL)bootInit.c bootInit.o
	@ $(RM) $@
	$(CP) $(CONFIG_ALL)bootInit.c bootInit_uncmp.c
	$(CC) -c $(CFLAGS) -DUNCOMPRESS bootInit_uncmp.c
	@ $(RM) bootInit_uncmp.c

bootInit_st.o : $(CONFIG_ALL)bootInit.c bootInit.o
	@ $(RM) $@
	$(CP) $(CONFIG_ALL)bootInit.c bootInit_st.c
	$(CC) -c $(CFLAGS) -DRAM_DST_ADRS=0x$(RAM_LOW_ADRS) bootInit_st.c
	@ $(RM) bootInit_st.c


bootInit_uncmp_res.o : $(CONFIG_ALL)bootInit.c bootInit.o
	@ $(RM) $@
	$(CP) $(CONFIG_ALL)bootInit.c bootInit_uncmp_res.c
	$(CC) -c $(CFLAGS) -DROM_RESIDENT -DUNCOMPRESS bootInit_uncmp_res.c
	@ $(RM) bootInit_uncmp_res.c

dataSegPad.o: $(CONFIG_ALL)dataSegPad.c $(CONFIG_ALL)configAll.h config.h
	@ $(RM) $@
	$(CC) -c $(CFLAGS) $(CONFIG_ALL)dataSegPad.c

####################### vxWorks ###########################################

# vxWorks     - normal vxWorks system
# vxWorks.sym - symbol table of vxWorks

vxWorks vxWorks.sym : usrConfig.o dataSegPad.o $(MACH_DEP) $(LDDEPS) $(LIBS)
	@ $(RM) vxWorks vxWorks.sym
	@ $(MAKE) -f Makefile.$(CPU)$(TOOL) CPU=$(CPU) TOOL=$(TOOL) version.o
	$(LD) $(LDFLAGS) -e $(SYS_ENTRY) $(LD_LOW_FLAGS) \
	    -o vxWorks dataSegPad.o $(MACH_DEP) usrConfig.o version.o $(LIBS)
	$(LDOUT_HOST) vxWorks
	$(LDOUT_CONV) vxWorks
	$(BINXSYM) < vxWorks > vxWorks.sym
	$(LDOUT_SYMS) vxWorks.sym
	@ $(RM) version.o


# vxWorks_rom - rommable version of VxWorks (without standalone symbol table)
#   This is typically used when making an application in ROM that doesn't
#   include the shell and the symbol table.  Since these applications are
#   usually smaller, this version doesn't use ROM compression.

vxWorks_rom : bootInit_uncmp.o romInit.o dataSegPad.o usrConfig.o \
	      $(MACH_DEP) $(LDDEPS) $(LIBS)
	@ $(RM) $@ $(IMI) $(IBR)
	@ $(MAKE) -f Makefile.$(CPU)$(TOOL) CPU=$(CPU) TOOL=$(TOOL) version.o
	$(LD) $(LDFLAGS) -e $(ROM_ENTRY) $(LD_LOW_FLAGS) \
	    -o $@ romInit.o bootInit_uncmp.o dataSegPad.o usrConfig.o \
	    $(MACH_DEP) version.o $(LIBS)
	$(LDOUT_HOST) $@
	$(ENV_BIN)romsize -b $(ROM_SIZE) $@
	$(LDOUT_CONV) $@
	@ $(RM) version.o

vxWorks_rom.hex : vxWorks_rom $(IMI)
	@ $(RM) $@
	$(BINHEX) $(HEX_FLAGS) $(SECT_SPEC)vxWorks_rom$(TXT_OFFSET) \
		$(IMI_SPEC)$(IMI)$(IMI_OFFSET) > $@$(MAP_EXT)
	-@ $(MV_BIN)

# vxWorks.st - standalone VxWorks with symbol table linked in
#   This builds a VxWorks image that contains the symbol table linked in,
#   instead of loading it over the network.

vxWorks.st : usrConfig_st.o dataSegPad.o $(MACH_DEP) $(LDDEPS) $(LIBS)
	@ $(RM) $@ symTbl.c symTbl.o tmp.o tmp.2
	@ $(MAKE) -f Makefile.$(CPU)$(TOOL) CPU=$(CPU) TOOL=$(TOOL) version.o
	$(LD) -o tmp.o $(LD_PARTIAL_FLAGS) dataSegPad.o $(MACH_DEP) \
	    usrConfig_st.o version.o $(LIBS)
	$(CP) tmp.o tmp.2
	$(LDOUT_SYMS) tmp.o
	$(ENV_BIN)makeSymTbl tmp.o > symTbl.c
	$(COMPILE_SYMTBL) symTbl.c
	$(LD) $(LDFLAGS) -e $(SYS_ENTRY) $(LD_LOW_FLAGS) \
	    -o $@ tmp.2 symTbl.o
	$(LDOUT_SYMS) $@
	$(LDOUT_CONV) $@
	@ $(RM) tmp.?	 version.o


# vxWorks.st_rom - rommable standalone version using ROM compression
#   This builds a standalone VxWorks image that can be put in ROM.
#   It includes a linked in symbol table so that a complete VxWorks with
#   shell and symbol table can be put in ROM.  Since these systems tend to
#   be larger, ROM compression is used.
#   Note: this uses larger EEPROMs, the user is advised to check the
#   macros for ROM sizes and offsets for compatibility.

vxWorks.st.Z.s : usrConfig_st.o dataSegPad.o $(MACH_DEP) $(LDDEPS) $(LIBS)
	@ $(RM) $@ tmp.o tmp.1 tmp.2 tmp.Z symTbl.c symTbl.o
	@ $(MAKE) -f Makefile.$(CPU)$(TOOL) CPU=$(CPU) TOOL=$(TOOL) version.o
	$(LD) -o tmp.1 $(LD_PARTIAL_FLAGS) dataSegPad.o $(MACH_DEP) \
	    usrConfig_st.o version.o $(LIBS)
	$(CP) tmp.1 tmp.o
	$(LDOUT_SYMS) tmp.o
	$(ENV_BIN)makeSymTbl tmp.o >symTbl.c
	$(COMPILE_SYMTBL) symTbl.c
	$(LD) -o tmp.2 $(LDFLAGS) $(ROM_LDFLAGS) -e $(SYS_ENTRY) \
	    $(LD_LOW_FLAGS) tmp.1 symTbl.o
	$(LDOUT_HOST) tmp.2
	$(LDOUT_CONV) tmp.2
	$(EXTRACT_BIN) < tmp.2 | $(ENV_BIN)compress -f -b 15 >tmp.Z
	$(ENV_BIN)binToAsm tmp.Z > $@
	@ $(RM) version.o tmp.?

vxWorks.st_rom : bootInit_st.o romInit.o vxWorks.st.Z.o $(LDDEPS) $(LIBS) \
			$(BOOT_EXTRA)
	@ $(RM) $(IMI) $(IBR)
	@ $(MAKE) -f Makefile.$(CPU)$(TOOL) CPU=$(CPU) TOOL=$(TOOL) version.o
	$(LD) $(LDFLAGS) -e $(ROM_ENTRY) $(LD_HIGH_FLAGS) \
	    -o $@ romInit.o bootInit_st.o version.o $(LIBS) \
	       $(BOOT_EXTRA) vxWorks.st.Z.o
	$(ENV_BIN)romsize -b $(ROM_SIZE) $@
	$(LDOUT_CONV) $@
	@ $(RM) version.o

vxWorks.st_rom.hex : vxWorks.st_rom $(IMI)
	@ $(RM) $@
	$(BINHEX) $(HEX_FLAGS) $(SECT_SPEC)vxWorks.st_rom$(TXT_OFFSET) \
		$(IMI_SPEC)$(IMI)$(IMI_OFFSET) > $@$(MAP_EXT)
	-@ $(MV_BIN)

# vxWorks.res_rom - rommable standalone version without compression
#   This builds a standalone VxWorks image that can be put in ROM.
#   It includes a linked in symbol table so that a complete VxWorks with
#   shell and symbol table can be put in ROM. Only the data segment
#   of this ROM image is copied into RAM.

vxWorks.res_rom: bootInit_res.o romInit_res.o usrConfig_st.o \
		 $(MACH_DEP) $(LDDEPS) $(LIBS)
	@ $(RM) $@ tmp.o tmp.1 symTbl.c symTbl.o $(IMI) $(IBR)
	@ make -f Makefile.$(CPU)$(TOOL) CPU=$(CPU) TOOL=$(TOOL) version.o
	$(LD) -o tmp.o $(LD_PARTIAL_FLAGS) \
	    $(MACH_DEP) usrConfig_st.o version.o $(LIBS)
	$(CP) tmp.o tmp.1
	$(LDOUT_SYMS) tmp.1
	$(ENV_BIN)makeSymTbl tmp.1 > symTbl.c
	$(COMPILE_SYMTBL) symTbl.c
	$(LD) -o $@ $(LDFLAGS) $(ROM_LDFLAGS) -e $(ROM_ENTRY) \
	    $(RES_LOW_FLAGS) romInit_res.o bootInit_res.o symTbl.o tmp.o
	$(LDOUT_HOST) $@
	$(ENV_BIN)romsize -b $(ROM_SIZE) $@
	$(LDOUT_CONV) $@
	@ $(RM) tmp.? version.o

vxWorks.res_rom_mips: bootInit_res_low.o romInit_res_low.o usrConfig_st.o \
		 $(MACH_DEP) $(LDDEPS) $(LIBS)
	@ $(RM) $@ tmp.o tmp.1 symTbl.c symTbl.o $(IMI) $(IBR)
	@ $(MAKE) -f Makefile.$(CPU)$(TOOL) CPU=$(CPU) TOOL=$(TOOL) version.o
	$(LD) -o tmp.o $(LD_PARTIAL_FLAGS) \
	    $(MACH_DEP) usrConfig_st.o version.o $(LIBS)
	$(CP) tmp.o tmp.1
	$(LDOUT_SYMS) tmp.1
	$(ENV_BIN)makeSymTbl tmp.1 > symTbl.c
	$(COMPILE_SYMTBL) symTbl.c
	$(LD) -o $@ $(LDFLAGS) $(ROM_LDFLAGS) -e $(ROM_ENTRY) \
	    $(RES_LOW_FLAGS) romInit_res_low.o bootInit_res_low.o \
	    symTbl.o tmp.o
	$(LDOUT_HOST) $@
	$(ENV_BIN)romsize -b $(ROM_SIZE) $@
	$(LDOUT_CONV) $@
	@ $(RM) tmp.? version.o

vxWorks.res_rom.hex: vxWorks.res_rom $(IMI)
	@ $(RM) $@
	$(BINHEX) $(HEX_FLAGS) vxWorks.res_rom$(TXT_OFFSET) \
		$(IMI_SPEC)$(IMI)$(IMI_OFFSET) > $@$(MAP_EXT)
	-@ $(MV_BIN)

vxWorks.res_rom_mips.hex: vxWorks.res_rom_mips $(IMI)
	@ $(RM) $@
	$(BINHEX) $(HEX_FLAGS) vxWorks.res_rom_mips$(TXT_OFFSET) \
		$(IMI_SPEC)$(IMI)$(IMI_OFFSET) > $@$(MAP_EXT)
	-@ $(MV_BIN)

####################### bootrom ###########################################

# bootrom		- compressed bootrom object module
# bootrom.hex		- compressed bootrom hex format
# bootrom_uncmp		- noncompressed bootrom object module
# bootrom_uncmp.hex	- noncompressed bootrom hex format
#

bootrom.Z.s : bootConfig.o $(MACH_DEP) $(LDDEPS) $(LIBS)
	@ $(RM) $@ tmp.o tmp.Z
	@ $(MAKE) -f Makefile.$(CPU)$(TOOL) CPU=$(CPU) TOOL=$(TOOL) version.o
	$(LD) -o tmp.o $(LDFLAGS) $(ROM_LDFLAGS) -e $(USR_ENTRY) \
	    $(LD_HIGH_FLAGS) bootConfig.o version.o $(MACH_DEP) $(LIBS)
	$(LDOUT_HOST) tmp.o
	$(EXTRACT_BIN) < tmp.o | $(ENV_BIN)compress -f -b 15 > tmp.Z
	$(ENV_BIN)binToAsm tmp.Z >bootrom.Z.s
	@ $(RM) tmp.o tmp.Z version.o

bootrom : bootInit.o romInit.o bootrom.Z.o $(LDDEPS) $(LIBS) \
		$(BOOT_EXTRA)
	@ $(RM) $@ $(IMI) $(IBR)
	@ $(MAKE) -f Makefile.$(CPU)$(TOOL) CPU=$(CPU) TOOL=$(TOOL) version.o
	$(LD) $(LDFLAGS) -e $(ROM_ENTRY) $(LD_LOW_FLAGS) \
	    -o $@ romInit.o bootInit.o version.o $(LIBS) \
	       $(BOOT_EXTRA) bootrom.Z.o
	$(ENV_BIN)romsize -b $(ROM_SIZE) $@
	$(LDOUT_CONV) $@
	@ $(RM) version.o

bootrom_uncmp : bootInit_uncmp.o romInit.o bootConfig.o \
	    $(MACH_DEP) $(LDDEPS) $(LIBS)
	@ $(RM) $@ $(IMI) $(IBR)
	@ $(MAKE) -f Makefile.$(CPU)$(TOOL) CPU=$(CPU) TOOL=$(TOOL) version.o
	$(LD) $(LDFLAGS) $(ROM_LDFLAGS) -e $(ROM_ENTRY) $(LD_HIGH_FLAGS) \
	    -o $@ romInit.o bootInit_uncmp.o version.o bootConfig.o \
	    $(MACH_DEP) $(LIBS)
	$(ENV_BIN)romsize -b $(ROM_SIZE) $@
	$(LDOUT_CONV) $@
	@ $(RM) version.o

bootrom_res : bootInit_res.o romInit_res.o bootConfig.o \
	    $(MACH_DEP) $(LDDEPS) $(LIBS)
	@ $(RM) $@ $(IMI) $(IBR)
	@ make -f Makefile.$(CPU)$(TOOL) CPU=$(CPU) TOOL=$(TOOL) version.o
	$(LD) $(LDFLAGS) $(ROM_LDFLAGS) -e $(ROM_ENTRY) \
	    $(RES_HIGH_FLAGS) -o $@ romInit_res.o bootInit_res.o \
	    version.o bootConfig.o $(MACH_DEP) $(LIBS)
	$(ENV_BIN)romsize -b $(ROM_SIZE) $@
	$(LDOUT_CONV) $@
	@ $(RM) version.o

bootrom_res_mips : bootInit_res_high.o romInit_res_high.o bootConfig.o \
	    $(MACH_DEP) $(LDDEPS) $(LIBS)
	@ $(RM) $@ $(IMI) $(IBR)
	@ $(MAKE) -f Makefile.$(CPU)$(TOOL) CPU=$(CPU) TOOL=$(TOOL) version.o
	$(LD) $(LDFLAGS) $(ROM_LDFLAGS) -e $(ROM_ENTRY) \
	    $(RES_HIGH_FLAGS) -o $@ romInit_res_high.o \
	    bootInit_res_high.o version.o bootConfig.o $(MACH_DEP) $(LIBS)
	$(ENV_BIN)romsize -b $(ROM_SIZE) $@
	$(LDOUT_CONV) $@
	@ $(RM) version.o

bootrom.hex : bootrom $(IMI)
	@ $(RM) $@
	$(BINHEX) $(HEX_FLAGS) $(SECT_SPEC)bootrom$(TXT_OFFSET) \
		$(IMI_SPEC)$(IMI)$(IMI_OFFSET) > $@$(MAP_EXT)
	-@ $(MV_BIN)

imi :	$(IBR)
	$(LD) -o $@ -Ttext $(IMI_TEXT_ADRS) -Tdata $(IMI_DATA_ADRS) $(IBR)

bootrom_uncmp.hex : bootrom_uncmp $(IMI)
	@ $(RM) $@
	$(BINHEX) $(HEX_FLAGS) $(SECT_SPEC)bootrom_uncmp$(TXT_OFFSET) \
		$(IMI_SPEC)$(IMI)$(IMI_OFFSET) > $@$(MAP_EXT)
	-@ $(MV_BIN)

bootrom_res.hex : bootrom_res $(IMI)
	@ $(RM) $@
	$(BINHEX) $(HEX_FLAGS) bootrom_res$(TXT_OFFSET) \
		$(IMI_SPEC)$(IMI)$(IMI_OFFSET) > $@$(MAP_EXT)
	-@ $(MV_BIN)

bootrom_res_mips.hex : bootrom_res_mips $(IMI)
	@ $(RM) $@
	$(BINHEX) $(HEX_FLAGS) bootrom_res_mips$(TXT_OFFSET) \
		$(IMI_SPEC)$(IMI)$(IMI_OFFSET) > $@$(MAP_EXT)
	-@ $(MV_BIN)

release: 
	$(MAKE) -f Makefile.$(CPU)$(TOOL) CPU=$(CPU) TOOL=$(TOOL) $(RELEASE)

save:
	@- mkdir obj$(TOOL)
	@ $(RM) obj$(TOOL)/*
	mv -f *.o vxWorks* bootrom* symTbl.c obj$(TOOL)

_save:
	@ echo "save does not work yet"

restore:
	@ if [ ! -d obj$(TOOL) ]; then  echo "No save area .."; \
	else $(CP) obj$(TOOL)/* .;fi

depend.$(CPU)$(TOOL):
	$(VX_HSP_BASE)/bin/$(VX_HOST_TYPE)/mdepend \
	-f Makefile.$(CPU)$(TOOL).tmp  -o Makefile.$(CPU)$(TOOL) \
	$(CC_INCLUDE) $(CC_DEFINES) -- -- -- $(MACH_DEP) $(CONFIG_ALL)usrConfig.o $(CONFIG_ALL)bootConfig.o $(CONFIG_ALL)bootInit.o romInit.o

# end of makeTarget2


# end of makeTarget


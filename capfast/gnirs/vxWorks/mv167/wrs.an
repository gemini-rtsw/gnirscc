.\" wrs.an - {n,t}roff macros for WRS on-line manual pages
.\"
.\" modification history
.\" --------------------
.\" 01i,31jan95,jdi  added .nT and .sA macros for repeated text in BSP generics;
.\"                  removed .vs from .bS/.bE (SPR 3051);
.\"                  fixed line length problem (SPR 3233).
.\" 01h,12mar93,jdi  added .iT macro (cf. 01p in tmac.ref51), added lL register.
.\" 01g,28jan93,jdi  added right indent arg for .RS.
.\" 01f,27jan93,jdi  fixed bug in .iP and added missing modhist for 01e.
.\" 01e,??jan93,jdi  restored string dD for current print date, for target.nr's.
.\" 01d,28sep92,jdi  removed current print date (date is now mangen revision).
.\" 01c,28sep92,jdi  fixed bug in .iP by making it more nroff-like;
.\"                  changed name in header to match file name;
.\"                  set string ]W to hard-code current date in footer
.\"                  (this should be rel # and mangen date in the future);
.\"                  set string ]L to override Sun's "Last change:".
.\" 01b,21sep92,rbr  Removed blank lines.
.\" 01a,18aug92,rbr  Created, starting from old tmac.angen.
.\"
.\" DESCRIPTION
.\" This file contains WRS-specific macros to augment the standard -man macros
.\" for viewing or printing the WRS on-line manual pages.
.\"
.\"
.\" month name...
.if "\n(mo"1" .ds mN JAN
.if "\n(mo"2" .ds mN FEB
.if "\n(mo"3" .ds mN MAR
.if "\n(mo"4" .ds mN APR
.if "\n(mo"5" .ds mN MAY
.if "\n(mo"6" .ds mN JUN
.if "\n(mo"7" .ds mN JUL
.if "\n(mo"8" .ds mN AUG
.if "\n(mo"9" .ds mN SEP
.if "\n(mo"10" .ds mN OCT
.if "\n(mo"11" .ds mN NOV
.if "\n(mo"12" .ds mN DEC
.\"
.ds dD REV: \\n(dy \\*(mN \\n(yr
.\"
.\" ?
.ds ]I \\\\n(]
.ds ]R \\\\n()
.\"
.\"
.\" modify the following line to tailor page width.
.\"
.if t .nr lL 6.5
.if n .nr lL 65
.\"
.\"
.\" modify interpretation of string ]L in .TH
.\"
.am TH
.ds ]L \\$3
.ds hM \\$1
.if "\\$6"R" .ds hM \\*(hM()
.if t .ll \\n(lLi
.if n .ll \\n(lL
.\".nr LL \\n(.l
..
.\"
.\"
.\"	# sub section heading, if arg2 = 1 make it an in-line heading
.\"
.de SS
.ie !"\\$2"1" .SH "\\$1"
.el \{\
\\$1 \}
..
.\"
.\"
.\" add a title-length request to .}C in case we want to reset it (above)
.\" (only way to get it inserted in .}H)
.\"
.am }C
.if t .lt \\n(lLi
.if n .lt \\n(lL
..
.\"
.\"
.\" add arg to .RS for right indent
.am RS
.if !"\\$2"" .ll -\\$2n
..
.\"
.\"
.\" hanging label with floating dash, arg3 (font) is unused in nroff version.
.\"
.ds dF \h'-2'-\0
.de iP
.if !"\\$2"" .nr )I \\$2n
.sp \\n()Pu
.in \\n()Ru+\\n(INu+\\n()Iu
.ti -\\n()Iu
.ie \w\\$1u>(\\n()Iu-3n)\{\
\&\\$1\f1
.br
\*(dF\c\}
.el \&\\$1\f1\h'|\\n()Iu'\*(dF\c
..
.\"
.\"
.\" CS/CE - Courier display (assumes font CB = Courier)
.\"
.de CS
.nr cI \\n(.i
.if !"\\$1"" .in +\\$1
.if !"\\$2"F" .nf
.ps -1
.sp \\n()Pu
.ft CB
.sw CB -1
..
.\"
.de CE
.in \\n(cIu
.fi
.ps
.sp
.ft 1
.sw CB 0
..
.\"
.\"
.\" bS/bE - board display for targets
.\"
.de bS
.if n .in 0
.nf
.ps 9
.sp \\n()Pu
.ft CB
.sw CB -1
.if t .vs -4
.ne 23v
..
.\"
.de bE
.if n .in
.fi
.ps
.ft 1
.sw CB 0
.if t .vs
..
.\"		.iT - temporary left-indent for SYNOPSIS items, if arg2, do
.\"                   a break first.
.de iT
.hy 0
.na
.in +.4i
.ti -.4i
\\$1
.if \\n(.$>1 \{\
.br
\\$2\}
.in
.ad
.hy 14
..
.\"
.\"
.\" used in target.nr
.\"
.de aX
\\$1\\$2
..
.\"
.\"
.\" output argument as a SEE ALSO to the Programmer's Guide
.\"
.de pG
.na
.if \w'\ Programmer\'s\ Guide:\ \\$1'u>(\\n(.lu-\\n(.ku-\\n()Iu) .br
.I "Programmer's\ Guide:\ \\$1"
.ad
..
.\"
.\"
.\" used only for table in vw/src/os/sigLib.c
.\"
.de TS
.nr tE \\n(.lu
.if \\n(.$ \{\
'll -\\n(.iu \}
..
.\"
.de TE
.ll \\n(tEu
..
.\"
.\" The following macros .nT and .sA provide repeated text for the
.\" generic BSP man pages.
.de nT
\f3NOTE:\fP  This is a generic man page for a BSP-specific routine; this
description contains general information only.  To determine if this routine
is supported by your BSP, or for information specific to your BSP's version
of this routine, see the man pages for the BSP.  For example, if \%\\*(hM
is supported by your BSP, the online UNIX man page for a BSP can be accessed
by viewing \%<bspName>_\\*(hM.
See
.I 2. Getting Started
in the
.I VxWorks Programmer's Guide
for information on accessing BSP-specific man pages.
..
.de sA
and BSP-specific manual entries for sysLib and \%\\*(hM
..

/*
DESCRIPTION
This library provides board-specific routines.  The chip drivers included are:
    mccTimer.c - MCchip Timer library
    vmeChip2Vme.c - VME Chip library
    nvRam.c - non-volatile RAM library

INCLUDE FILES: sysLib.h

SEE ALSO:
.pG "Configuration"
*/


#! /bin/sh
#
#

NIRS_DIR=/home/gemvx/gnirs
# Set in, "sub" nirs.env's NIRS_CVSRELEASE=
NIRS_GEM5_INSTPATH=pisces:/gemini/GEM5/gnirs
NIRS_LIBDIR=${NIRS_DIR}/WFS/LIB
NIRS_WFSLIBINSTPATH=${NIRS_GEM5_INSTPATH}/WFS/WFS/LIB
NIRS_ENGDIR=${NIRS_DIR}/WFS/ENG
NIRS_WFSENGINSTPATH=${NIRS_GEM5_INSTPATH}/WFS/WFS/ENG
NIRS_CCDIR=${NIRS_DIR}/CC
NIRS_CCINSTPATH=${NIRS_GEM5_INSTPATH}/CC/${NIRS_CVSRELEASE}
NIRS_WFSDIR=${NIRS_DIR}/WFS
NIRS_WFSINSTPATH=${NIRS_INSTPATH}/WFS
NIRS_WFSWFSDIR=${NIRS_DIR}/WFS/WFS
NIRS_WFSWFSINSTPATH=${NIRS_INSTPATH}/WFS/WFS
NIRS_WCSDIR=${NIRS_DIR}/WCS
NIRS_DCDIR=${NIRS_DIR}/DC
NIRS_DCINSTPATH=${NIRS_GEM5_INSTPATH}/DC/${NIRS_CVSRELEASE}
NIRS_ISDIR=${NIRS_DIR}/IS
NIRS_ISINSTPATH=${NIRS_GEM5_INSTPATH}/IS/${NIRS_CVSRELEASE}
NIRS_TARGETS=mv167
NIRS_EPICS_DIR=/usr/software/dev/packages/epics/epics3.12.2GEM5
NIRS_EPICS_BIN=/gemini/external/GEM5
NIRS_TIMELIBDIR=/gemini/timelib
NIRS_SLALIBDIR=/gemini/slalib
NIRS_ASTLIBDIR=/gemini/astlib
NIRS_PREFIX=nirs:
NIRS_SADPREFIX=${NIRS_PREFIX}sad:
NIRS_WFSPREFIX=nirs:
NIRS_WFSSADPREFIX=${NIRS_PREFIX}
NIRS_DCPREFIX=${NIRS_PREFIX}
NIRS_DCSADPREFIX=${NIRS_PREFIX}
NIRS_NAME=NIRS
NIRS_TMPSCAN="10 second"
NIRS_TMPVAR=${NIRS_SADPREFIX}cc:tempState
NIRS_TMPHB=${NIRS_SADPREFIX}cc:heartBeat
NIRS_AGPREFIX=${NIRS_PREFIX}
NIRS_USEVXTIME=0
NIRS_USEBANCOMM=1
DHS_DIR=/gemini/dhs/dhs-0.19b
export DHS_DIR
export NIRS_EPICS_DIR
export NIRS_EPICS_BIN
export NIRS_DIR
export NIRS_LIBDIR
export NIRS_ENGDIR
export NIRS_CCDIR
export NIRS_WFSDIR
export NIRS_WFSWFSDIR
export NIRS_WCSDIR
export NIRS_DCDIR
export NIRS_ISDIR
export NIRS_INSTPATH
export NIRS_WFSLIBINSTPATH
export NIRS_WFSENGINSTPATH
export NIRS_WFSWFSINSTPATH
export NIRS_CCINSTPATH
export NIRS_WFSINSTPATH
export NIRS_DCINSTPATH
export NIRS_ISINSTPATH
export NIRS_DIR
export NIRS_TARGETS
export NIRS_TIMELIBDIR
export NIRS_SLALIBDIR
export NIRS_ASTLIBDIR
export NIRS_PREFIX
export NIRS_SADPREFIX
export NIRS_WFSPREFIX
export NIRS_WFSSADPREFIX
export NIRS_DCPREFIX
export NIRS_DCSADPREFIX
export NIRS_NAME
export NIRS_TMPSCAN
export NIRS_TMPVAR
export NIRS_TMPHB
export NIRS_AGPREFIX
export NIRS_USEVXTIME
export NIRS_USEBANCOMM

echo $DHS_DIR

sh -x ./nirsSetup $1

echo done 



#_EOF_


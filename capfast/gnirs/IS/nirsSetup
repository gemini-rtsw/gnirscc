###########################################################################
# Set up subdirectories.
###########################################################################

#
# Define a function to be used to set up subdirectories:
#
# Syntax:
#     setupdir PATH DESCRIPTION


setupdir () {
	dirpath="$1"
	dirname="$2"

	cd $dirpath

	echo "* Setting up $dirname."
	echo "---------------------------------------------------------------------"

	$dirpath/nirsSetup
	status=$?

	echo "---------------------------------------------------------------------"

	if [ $status -ne 0 ]; then
		echo "*** $dirname setup failed. NIRS setup abandoned. ***"
		exit $status
	elif [ ! -h $dirpath/.applTop ]; then
		echo "*** $dirname failed. NIRS setup abandoned. ***"
		exit 1
	else
		echo "* $dirname set up successfully"
	fi
}


#
# VxWorks startup script to load and execute system (iocCore) software.
#
# First, vxWorks startup issues:

# Make delete key work for backspace
# tyBackspaceSet 0177

# cd to application install directory (beware automounter problems)
cd "$(install)"
pwd

# The local file contains site-specific information
# such as the default router and the vxWorks password file.

< $(install)/bin/$(arch)/local

#putenv("INITDIR=$(install)/pv/") I don't think this is used anymore
#dhs libraries
#ld </home/gemini/dhs/dhs-0.16/external/lib/mv167/libers.o
#ld </home/gemini/dhs/dhs-0.16/external/lib/mv167/libimp.o
#ld </home/gemini/dhs/dhs-0.16/external/lib/mv167/libsds.o
#ld </home/gemini/dhs/dhs-0.16/lib/mv167/libgen.a
#ld </home/gemini/dhs/dhs-0.16/lib/mv167/libdhs.a


# Load EPICS core and record stuff
ld < $(epics)/base/bin/$(arch)/iocCore
ld < $(epics)/base/bin/$(arch)/drvSup
ld < $(epics)/base/bin/$(arch)/recSup
ld < $(epics)/base/bin/$(arch)/devSup

#pvload program
ld < $(epics)/extensions/bin/$(arch)/pvload

# If using state programs, load the sequencer
#ld < $(epics)/base/bin/$(arch)/seq

# Load any application records, device support or drivers here,
# or code for subroutine records
ld < $(install)/epics/extensions/src/gemini/slalib/bin/$(arch)/slalib
ld < $(install)/epics/extensions/src/gemini/timelib/bin/$(arch)/timelib
ld < $(install)/epics/extensions/src/gemini/astlib/bin/$(arch)/astlib

#gnirs controller code
ld < $(install)/bin/$(arch)/ccGlobal.o
#ld < $(install)/bin/$(arch)/mytimeLib.o
ld < $(install)/bin/$(arch)/hdwrControl.o
ld < $(install)/bin/$(arch)/epicsControl.o

# instrument sequencer code
ld < $(install)/bin/$(arch)/gmSeqAppl

# Load sequences here
# ld < $(install)/bin/$(arch)/testseq.o
#ld <$(install)/epics/extensions/src/gemini/timelib/bin/$(arch)/timeSeq

#timeClockInit (0,1,60,1,0)

# Configure the Timestamp system, 1=Master IOC
#TSconfigure 1, 0, 0, 0, 0, 0


# Load one or more ASCII databases here
dbLoad "$(install)/data/$(dctsdr).dctsdr"
dbLoadRecords "$(install)/data/nirsCCTop.db"
dbLoadRecords "$(install)/data/nirsCCSadTop.db"
# is records
dbLoadRecords "$(install)/data/nirsSeqTop.db"
dbLoadRecords "$(install)/data/nirsSeqSadTop.db"

# This turns off logging
iocLogDisable=1

# start dhs
#sp ImpMaster

# start epics
iocInit "$(install)/data/resource.def"

#load motor parameters


#is variables
pvload "$(version)/data/cadVals.pv","top=nirs:cc:, sadtop=nirs:sad:cc:"
#pvload "$(version)/data/gmSeqTracking.pv","top=nirs:, sadtop=nirs:sad:"

# Start sequences
# seq &testseq
#seq &timeSeq, "sys=gm:dc:"

#start epics control tasks
initTasks


# Set debugging/logging level
gnirsInitLogging
gnirsSetDebug 3
sendToMotorDebug=1

# Read config file
#sdsuReadConfig "$(install)/data/dcConfig"

# save with fits or dhs
#useFits 0
# simulation = 0 for real use of DHS, =1 to fake it
#useDHS "128.171.188.193", "dataServerNT", 0


# Initialize GNIRS hardware interface
#pvload "$(install)/data/cadInitVals.par","top=nirs:cc:,sadtop=nirs:cc:sad:"

# # Simulation mode NOSIM:0  VSM:1  FASTSIM:2  FULLSIM:3
setSimulation 0

# Set flag if xycom board not present
noXYCOM = 0


# Set flag if temperature board not present
noTempMon = 0

# Set flag if SenTorr not present
noSenTorr = 0

# Read the motor configuration file and initialize the motors
#readConfig "$(install)/data/gnirsConfig.seed"
strncpy  &configDirectory, "$(install)/data/", 160

# Setup the vme hardware
#vmeInit

pvload "$(version)/data/gmSeq.pv","top=nirs:, sadtop=nirs:sad:"

# inform other systems that CC is ready
dbpf "nirs:cc:masterEnable","ON"

ld < $(install)/bin/$(arch)/epicsCAInt.o
# Trigger the initialisation of the instrument sequencer and components controller
# disabling initdcCadMark to prevent the detector controller being initialised
#dbpf "nirs:initdcCadMark.DISA", "1"
#dbpf "nirs:getNames.DIR" , "MARK";
#dbpf "nirs:getNames.DIR" , "START";

#mark init and start apply
dbpf "nirs:apply.DIR", "CLEAR"
dbpf "nirs:init.DIR", "MARK"
sleep(3,0)
dbpf "nirs:apply.DIR", "START"
